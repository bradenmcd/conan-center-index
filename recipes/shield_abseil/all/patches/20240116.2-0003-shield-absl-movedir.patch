+TEST(IntSpan, NoexceptTest) {
+  int a[] = {1, 2, 3};
+  std::vector<int> v;
+  EXPECT_TRUE(noexcept(shield_absl::Span<const int>()));
+  EXPECT_TRUE(noexcept(shield_absl::Span<const int>(a, 2)));
