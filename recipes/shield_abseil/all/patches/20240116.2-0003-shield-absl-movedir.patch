+    shield_absl::SetFlag(&FLAGS_test_flag_08, 975310);
+    shield_absl::SetFlag(&FLAGS_test_flag_09, 1.00001);
+    shield_absl::SetFlag(&FLAGS_test_flag_10, -3.54f);
+    shield_absl::SetFlag(&FLAGS_test_flag_11, "asdf");
+    shield_absl::SetFlag(&FLAGS_test_flag_12, shield_absl::Hours(20));
+    shield_absl::SetFlag(&FLAGS_test_flag_13, 4);
+    shield_absl::SetFlag(&FLAGS_test_flag_14, CustomUDT{-1, -2});
+  }
+
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_test_flag_01), true);
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_test_flag_02), 1234);
