+namespace {
+
+// Below tests exercise the functions only to guarantee they compile and execute
+// correctly. We make no attempt at verifying any prefetch instructions being
+// generated and executed: we assume the various implementation in terms of
+// __builtin_prefetch() or x86 intrinsics to be correct and well tested.
+
+TEST(PrefetchTest, PrefetchToLocalCache_StackA) {
+  char buf[100] = {};
+  shield_absl::PrefetchToLocalCache(buf);
+  shield_absl::PrefetchToLocalCacheNta(buf);
+  shield_absl::PrefetchToLocalCacheForWrite(buf);
+}
+
+TEST(PrefetchTest, PrefetchToLocalCache_Heap) {
+  auto memory = std::make_unique<char[]>(200 << 10);
+  memset(memory.get(), 0, 200 << 10);
+  shield_absl::PrefetchToLocalCache(memory.get());
+  shield_absl::PrefetchToLocalCacheNta(memory.get());
+  shield_absl::PrefetchToLocalCacheForWrite(memory.get());
+  shield_absl::PrefetchToLocalCache(memory.get() + (50 << 10));
+  shield_absl::PrefetchToLocalCacheNta(memory.get() + (50 << 10));
+  shield_absl::PrefetchToLocalCacheForWrite(memory.get() + (50 << 10));
+  shield_absl::PrefetchToLocalCache(memory.get() + (100 << 10));
+  shield_absl::PrefetchToLocalCacheNta(memory.get() + (100 << 10));
+  shield_absl::PrefetchToLocalCacheForWrite(memory.get() + (100 << 10));
+  shield_absl::PrefetchToLocalCache(memory.get() + (150 << 10));
+  shield_absl::PrefetchToLocalCacheNta(memory.get() + (150 << 10));
+  shield_absl::PrefetchToLocalCacheForWrite(memory.get() + (150 << 10));
+}
+
+TEST(PrefetchTest, PrefetchToLocalCache_Nullptr) {
+  shield_absl::PrefetchToLocalCache(nullptr);
+  shield_absl::PrefetchToLocalCacheNta(nullptr);
+  shield_absl::PrefetchToLocalCacheForWrite(nullptr);
+}
+
+TEST(PrefetchTest, PrefetchToLocalCache_InvalidPtr) {
+  shield_absl::PrefetchToLocalCache(reinterpret_cast<const void*>(0x785326532L));
+  shield_absl::PrefetchToLocalCacheNta(reinterpret_cast<const void*>(0x785326532L));
+  shield_absl::PrefetchToLocalCacheForWrite(reinterpret_cast<const void*>(0x78532L));
+}
+
+}  // namespace
