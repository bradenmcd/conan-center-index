+// In zones with POSIX-style recurring rules we use special logic to
+// handle conversions in the distant future.  Here we check the limits
+// of those conversions, particularly with respect to integer overflow.
+TEST(Time, ExtendedConversionSaturation) {
+  const shield_absl::TimeZone syd =
+      shield_absl::time_internal::LoadTimeZone("Australia/Sydney");
+  const shield_absl::TimeZone nyc =
+      shield_absl::time_internal::LoadTimeZone("America/New_York");
+  const shield_absl::Time max =
+      shield_absl::FromUnixSeconds(std::numeric_limits<int64_t>::max());
+  shield_absl::TimeZone::CivilInfo ci;
+  shield_absl::Time t;
+
+  // The maximal time converted in each zone.
+  ci = syd.At(max);
+  EXPECT_CIVIL_INFO(ci, 292277026596, 12, 5, 2, 30, 7, 39600, true);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 5, 2, 30, 7), syd);
+  EXPECT_EQ(max, t);
+  ci = nyc.At(max);
+  EXPECT_CIVIL_INFO(ci, 292277026596, 12, 4, 10, 30, 7, -18000, false);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 10, 30, 7), nyc);
+  EXPECT_EQ(max, t);
+
+  // One second later should push us to infinity.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 5, 2, 30, 8), syd);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 10, 30, 8), nyc);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+
+  // And we should stick there.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 5, 2, 30, 9), syd);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 10, 30, 9), nyc);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+
+  // All the way up to a saturated date/time, without overflow.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond::max(), syd);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond::max(), nyc);
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+}
