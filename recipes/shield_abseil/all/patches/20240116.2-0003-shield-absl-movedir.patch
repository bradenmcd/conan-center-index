-TEST_P(BernoulliTest, Serialize) {
-  const double d = GetParam().first;
-  shield_absl::bernoulli_distribution before(d);
-
-  {
-    shield_absl::bernoulli_distribution via_param{
-        shield_absl::bernoulli_distribution::param_type(d)};
-    EXPECT_EQ(via_param, before);
-  }
-
