+#ifndef ABSL_FLAGS_USAGE_H_
+#define ABSL_FLAGS_USAGE_H_
+
+#include "shield_absl/base/config.h"
+#include "shield_absl/strings/string_view.h"
+
+// --------------------------------------------------------------------
+// Usage reporting interfaces
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+// Sets the "usage" message to be used by help reporting routines.
+// For example:
+//  shield_absl::SetProgramUsageMessage(
+//      shield_absl::StrCat("This program does nothing.  Sample usage:\n", argv[0],
+//                   " <uselessarg1> <uselessarg2>"));
+// Do not include commandline flags in the usage: we do that for you!
+// Note: Calling SetProgramUsageMessage twice will trigger a call to std::exit.
+void SetProgramUsageMessage(shield_absl::string_view new_usage_message);
+
+// Returns the usage message set by SetProgramUsageMessage().
+shield_absl::string_view ProgramUsageMessage();
+
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#endif  // ABSL_FLAGS_USAGE_H_
