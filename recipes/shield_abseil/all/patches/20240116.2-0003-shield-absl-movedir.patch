+
+  const size_t acceptable_delta =
+      100 + (UseCrc() ? sizeof(shield_absl::cord_internal::CordRepCrc) : 0);
+  EXPECT_LE(cord.size(), cord.EstimatedMemoryUsage());
+  EXPECT_GE(cord.size() + acceptable_delta, cord.EstimatedMemoryUsage());
+}
