+  EXPECT_EQ("0", shield_absl::FormatDuration(shield_absl::ZeroDuration()));
+  EXPECT_EQ("0", shield_absl::FormatDuration(shield_absl::Seconds(0)));
+  EXPECT_EQ("0", shield_absl::FormatDuration(shield_absl::Nanoseconds(0)));
+
+  EXPECT_EQ("1ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(1)));
+  EXPECT_EQ("1us", shield_absl::FormatDuration(shield_absl::Microseconds(1)));
+  EXPECT_EQ("1ms", shield_absl::FormatDuration(shield_absl::Milliseconds(1)));
+  EXPECT_EQ("1s", shield_absl::FormatDuration(shield_absl::Seconds(1)));
+  EXPECT_EQ("1m", shield_absl::FormatDuration(shield_absl::Minutes(1)));
+  EXPECT_EQ("1h", shield_absl::FormatDuration(shield_absl::Hours(1)));
+
+  EXPECT_EQ("1h1m", shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Minutes(1)));
+  EXPECT_EQ("1h1s", shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Seconds(1)));
+  EXPECT_EQ("1m1s", shield_absl::FormatDuration(shield_absl::Minutes(1) + shield_absl::Seconds(1)));
+
+  EXPECT_EQ("1h0.25s",
+            shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Milliseconds(250)));
+  EXPECT_EQ("1m0.25s",
+            shield_absl::FormatDuration(shield_absl::Minutes(1) + shield_absl::Milliseconds(250)));
+  EXPECT_EQ("1h1m0.25s",
+            shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Minutes(1) +
+                                 shield_absl::Milliseconds(250)));
+  EXPECT_EQ("1h0.0005s",
+            shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Microseconds(500)));
+  EXPECT_EQ("1h0.0000005s",
+            shield_absl::FormatDuration(shield_absl::Hours(1) + shield_absl::Nanoseconds(500)));
+
+  // Subsecond special case.
+  EXPECT_EQ("1.5ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(1) +
+                                          shield_absl::Nanoseconds(1) / 2));
+  EXPECT_EQ("1.25ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(1) +
+                                           shield_absl::Nanoseconds(1) / 4));
+  EXPECT_EQ("1ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(1) +
+                                        shield_absl::Nanoseconds(1) / 9));
+  EXPECT_EQ("1.2us", shield_absl::FormatDuration(shield_absl::Microseconds(1) +
+                                          shield_absl::Nanoseconds(200)));
+  EXPECT_EQ("1.2ms", shield_absl::FormatDuration(shield_absl::Milliseconds(1) +
+                                          shield_absl::Microseconds(200)));
+  EXPECT_EQ("1.0002ms", shield_absl::FormatDuration(shield_absl::Milliseconds(1) +
+                                             shield_absl::Nanoseconds(200)));
+  EXPECT_EQ("1.00001ms", shield_absl::FormatDuration(shield_absl::Milliseconds(1) +
+                                              shield_absl::Nanoseconds(10)));
+  EXPECT_EQ("1.000001ms",
+            shield_absl::FormatDuration(shield_absl::Milliseconds(1) + shield_absl::Nanoseconds(1)));
+
+  // Negative durations.
+  EXPECT_EQ("-1ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(-1)));
+  EXPECT_EQ("-1us", shield_absl::FormatDuration(shield_absl::Microseconds(-1)));
+  EXPECT_EQ("-1ms", shield_absl::FormatDuration(shield_absl::Milliseconds(-1)));
+  EXPECT_EQ("-1s", shield_absl::FormatDuration(shield_absl::Seconds(-1)));
+  EXPECT_EQ("-1m", shield_absl::FormatDuration(shield_absl::Minutes(-1)));
+  EXPECT_EQ("-1h", shield_absl::FormatDuration(shield_absl::Hours(-1)));
+
+  EXPECT_EQ("-1h1m",
+            shield_absl::FormatDuration(-(shield_absl::Hours(1) + shield_absl::Minutes(1))));
+  EXPECT_EQ("-1h1s",
+            shield_absl::FormatDuration(-(shield_absl::Hours(1) + shield_absl::Seconds(1))));
+  EXPECT_EQ("-1m1s",
+            shield_absl::FormatDuration(-(shield_absl::Minutes(1) + shield_absl::Seconds(1))));
+
+  EXPECT_EQ("-1ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(-1)));
+  EXPECT_EQ("-1.2us", shield_absl::FormatDuration(
+                          -(shield_absl::Microseconds(1) + shield_absl::Nanoseconds(200))));
+  EXPECT_EQ("-1.2ms", shield_absl::FormatDuration(
+                          -(shield_absl::Milliseconds(1) + shield_absl::Microseconds(200))));
+  EXPECT_EQ("-1.0002ms", shield_absl::FormatDuration(-(shield_absl::Milliseconds(1) +
+                                                shield_absl::Nanoseconds(200))));
+  EXPECT_EQ("-1.00001ms", shield_absl::FormatDuration(-(shield_absl::Milliseconds(1) +
+                                                 shield_absl::Nanoseconds(10))));
+  EXPECT_EQ("-1.000001ms", shield_absl::FormatDuration(-(shield_absl::Milliseconds(1) +
+                                                  shield_absl::Nanoseconds(1))));
+
+  //
+  // Interesting corner cases.
+  //
+
+  const shield_absl::Duration qns = shield_absl::Nanoseconds(1) / 4;
+  const shield_absl::Duration max_dur =
+      shield_absl::Seconds(kint64max) + (shield_absl::Seconds(1) - qns);
+  const shield_absl::Duration min_dur = shield_absl::Seconds(kint64min);
+
+  EXPECT_EQ("0.25ns", shield_absl::FormatDuration(qns));
+  EXPECT_EQ("-0.25ns", shield_absl::FormatDuration(-qns));
+  EXPECT_EQ("2562047788015215h30m7.99999999975s",
+            shield_absl::FormatDuration(max_dur));
+  EXPECT_EQ("-2562047788015215h30m8s", shield_absl::FormatDuration(min_dur));
+
+  // Tests printing full precision from units that print using FDivDuration
+  EXPECT_EQ("55.00000000025s", shield_absl::FormatDuration(shield_absl::Seconds(55) + qns));
+  EXPECT_EQ("55.00000025ms",
+            shield_absl::FormatDuration(shield_absl::Milliseconds(55) + qns));
+  EXPECT_EQ("55.00025us", shield_absl::FormatDuration(shield_absl::Microseconds(55) + qns));
+  EXPECT_EQ("55.25ns", shield_absl::FormatDuration(shield_absl::Nanoseconds(55) + qns));
+
+  // Formatting infinity
+  EXPECT_EQ("inf", shield_absl::FormatDuration(shield_absl::InfiniteDuration()));
+  EXPECT_EQ("-inf", shield_absl::FormatDuration(-shield_absl::InfiniteDuration()));
+
+  // Formatting approximately +/- 100 billion years
+  const shield_absl::Duration huge_range = ApproxYears(100000000000);
+  EXPECT_EQ("876000000000000h", shield_absl::FormatDuration(huge_range));
+  EXPECT_EQ("-876000000000000h", shield_absl::FormatDuration(-huge_range));
+
+  EXPECT_EQ("876000000000000h0.999999999s",
+            shield_absl::FormatDuration(huge_range +
+                                 (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1))));
+  EXPECT_EQ("876000000000000h0.9999999995s",
+            shield_absl::FormatDuration(
+                huge_range + (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1) / 2)));
+  EXPECT_EQ("876000000000000h0.99999999975s",
+            shield_absl::FormatDuration(
+                huge_range + (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1) / 4)));
+
+  EXPECT_EQ("-876000000000000h0.999999999s",
+            shield_absl::FormatDuration(-huge_range -
+                                 (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1))));
+  EXPECT_EQ("-876000000000000h0.9999999995s",
+            shield_absl::FormatDuration(
+                -huge_range - (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1) / 2)));
+  EXPECT_EQ("-876000000000000h0.99999999975s",
+            shield_absl::FormatDuration(
+                -huge_range - (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1) / 4)));
+}
