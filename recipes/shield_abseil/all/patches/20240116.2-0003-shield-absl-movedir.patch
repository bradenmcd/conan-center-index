-bool ModuleIsPath(shield_absl::string_view module_pattern) {
-#ifdef _WIN32
-  return module_pattern.find_first_of("/\\") != module_pattern.npos;
-#else
-  return module_pattern.find('/') != module_pattern.npos;
-#endif
-}
