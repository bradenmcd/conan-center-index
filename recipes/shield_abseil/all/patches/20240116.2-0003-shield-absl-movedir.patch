+
+#include <string.h>
+
+#ifdef _MSC_VER
+#include <winsock2.h>  // For timeval
+#else
+#include <sys/time.h>
+#endif
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <type_traits>
+
+#include "shield_absl/base/config.h"
+#include "shield_absl/base/log_severity.h"
+#include "shield_absl/base/optimization.h"
+#include "shield_absl/log/internal/append_truncated.h"
