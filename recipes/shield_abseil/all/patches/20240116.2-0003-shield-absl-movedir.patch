+struct IntCompareToCmp {
+  shield_absl::weak_ordering operator()(int a, int b) const {
+    if (a < b) return shield_absl::weak_ordering::less;
+    if (a > b) return shield_absl::weak_ordering::greater;
+    return shield_absl::weak_ordering::equivalent;
+  }
+};
