-static char* CurrentStackString(char* buf, int maxlen, bool symbolize) {
-  void* pcs[40];
-  return StackString(pcs, shield_absl::GetStackTrace(pcs, ABSL_ARRAYSIZE(pcs), 2), buf,
-                     maxlen, symbolize);
-}
