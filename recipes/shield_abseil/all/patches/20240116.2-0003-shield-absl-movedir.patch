+TEST(optionalTest, make_optional) {
+  auto opt_int = shield_absl::make_optional(42);
+  EXPECT_TRUE((std::is_same<decltype(opt_int), shield_absl::optional<int>>::value));
+  EXPECT_EQ(42, opt_int);
+
+  StructorListener listener;
+  Listenable::listener = &listener;
+
+  shield_absl::optional<Listenable> opt0 = shield_absl::make_optional<Listenable>();
+  EXPECT_EQ(1, listener.construct0);
+  shield_absl::optional<Listenable> opt1 = shield_absl::make_optional<Listenable>(1);
+  EXPECT_EQ(1, listener.construct1);
+  shield_absl::optional<Listenable> opt2 = shield_absl::make_optional<Listenable>(1, 2);
+  EXPECT_EQ(1, listener.construct2);
+  shield_absl::optional<Listenable> opt3 = shield_absl::make_optional<Listenable>({1});
+  shield_absl::optional<Listenable> opt4 = shield_absl::make_optional<Listenable>({1, 2});
+  EXPECT_EQ(2, listener.listinit);
+
