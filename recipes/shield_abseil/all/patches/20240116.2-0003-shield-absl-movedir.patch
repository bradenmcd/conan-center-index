+TEST(CivilTime, DifferenceLimits) {
+  const shield_absl::civil_diff_t kDiffMax =
+      std::numeric_limits<shield_absl::civil_diff_t>::max();
+  const shield_absl::civil_diff_t kDiffMin =
+      std::numeric_limits<shield_absl::civil_diff_t>::min();
+
+  // Check day arithmetic at the end of the year range.
+  const shield_absl::CivilDay max_day(kDiffMax, 12, 31);
+  EXPECT_EQ(1, max_day - (max_day - 1));
+  EXPECT_EQ(-1, (max_day - 1) - max_day);
+
+  // Check day arithmetic at the start of the year range.
+  const shield_absl::CivilDay min_day(kDiffMin, 1, 1);
+  EXPECT_EQ(1, (min_day + 1) - min_day);
+  EXPECT_EQ(-1, min_day - (min_day + 1));
+
+  // Check the limits of the return value.
+  const shield_absl::CivilDay d1(1970, 1, 1);
+  const shield_absl::CivilDay d2(25252734927768524, 7, 27);
+  EXPECT_EQ(kDiffMax, d2 - d1);
+  EXPECT_EQ(kDiffMin, d1 - (d2 + 1));
+}
