-  *os << ",\n";
-  FormatArrayContents(os, tables_.f);
-  *os << "};\n"
-         "\n"
-         "}  // namespace random_internal\n"
-         "ABSL_NAMESPACE_END\n"
-         "}  // namespace shield_absl\n"
-         "\n"
-         "// clang-format on\n"
-         "// END GENERATED CODE";
