-      shield_absl::numbers_internal::IsNegative(i);
-  const uint32_t digits = shield_absl::numbers_internal::Base10Digits(
-      shield_absl::numbers_internal::UnsignedAbsoluteValue(i));
-  shield_absl::strings_internal::STLStringResizeUninitialized(
-      &str, digits + static_cast<uint32_t>(is_negative));
-  shield_absl::numbers_internal::FastIntToBufferBackward(i, &str[str.size()], digits);
-  return str;
-}
