+  // Testing dynamically generated type_url
+  bad_status.SetPayload(shield_absl::StrCat(kUrl1, ".1"), shield_absl::Cord(kPayload1));
+  EXPECT_THAT(bad_status.GetPayload(shield_absl::StrCat(kUrl1, ".1")),
