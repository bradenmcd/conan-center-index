-TEST(LogEntryTest, Baseline) {
-  LogEntryTestPeer entry("foo.cc", 1234, kUsePrefix, shield_absl::LogSeverity::kInfo,
-                         "2020-01-02T03:04:05.6789", 451,
-                         shield_absl::log_internal::PrefixFormat::kNotRaw,
