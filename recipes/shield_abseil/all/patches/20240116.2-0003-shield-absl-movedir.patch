+// hash()
+template <>  // NOLINT
+struct hash<shield_absl::monostate> {
+  std::size_t operator()(shield_absl::monostate) const { return 0; }
+};
+
+template <class... T>  // NOLINT
+struct hash<shield_absl::variant<T...>>
+    : shield_absl::variant_internal::VariantHashBase<shield_absl::variant<T...>, void,
+                                              shield_absl::remove_const_t<T>...> {};
+
