+//
+// This header file defines abstractions for computing with absolute points
+// in time, durations of time, and formatting and parsing time within a given
+// time zone. The following abstractions are defined:
+//
+//  * `shield_absl::Time` defines an absolute, specific instance in time
+//  * `shield_absl::Duration` defines a signed, fixed-length span of time
+//  * `shield_absl::TimeZone` defines geopolitical time zone regions (as collected
+//     within the IANA Time Zone database (https://www.iana.org/time-zones)).
+//
+// Note: Absolute times are distinct from civil times, which refer to the
+// human-scale time commonly represented by `YYYY-MM-DD hh:mm:ss`. The mapping
+// between absolute and civil times can be specified by use of time zones
+// (`shield_absl::TimeZone` within this API). That is:
+//
+//   Civil Time = F(Absolute Time, Time Zone)
+//   Absolute Time = G(Civil Time, Time Zone)
+//
+// See civil_time.h for abstractions related to constructing and manipulating
+// civil time.
+//
+// Example:
+//
+//   shield_absl::TimeZone nyc;
+//   // LoadTimeZone() may fail so it's always better to check for success.
+//   if (!shield_absl::LoadTimeZone("America/New_York", &nyc)) {
+//      // handle error case
+//   }
+//
+//   // My flight leaves NYC on Jan 2, 2017 at 03:04:05
+//   shield_absl::CivilSecond cs(2017, 1, 2, 3, 4, 5);
+//   shield_absl::Time takeoff = shield_absl::FromCivil(cs, nyc);
+//
+//   shield_absl::Duration flight_duration = shield_absl::Hours(21) + shield_absl::Minutes(35);
+//   shield_absl::Time landing = takeoff + flight_duration;
+//
+//   shield_absl::TimeZone syd;
+//   if (!shield_absl::LoadTimeZone("Australia/Sydney", &syd)) {
+//      // handle error case
+//   }
+//   std::string s = shield_absl::FormatTime(
+//       "My flight will land in Sydney on %Y-%m-%d at %H:%M:%S",
+//       landing, syd);
