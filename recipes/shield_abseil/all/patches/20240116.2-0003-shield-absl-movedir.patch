-// Returns the maximum duration that SleepOnce() can sleep for.
-constexpr shield_absl::Duration MaxSleep() {
-#ifdef _WIN32
-  // Windows Sleep() takes unsigned long argument in milliseconds.
-  return shield_absl::Milliseconds(
-      std::numeric_limits<unsigned long>::max());  // NOLINT(runtime/int)
-#else
-  return shield_absl::Seconds(std::numeric_limits<time_t>::max());
-#endif
-}
-
-// Sleeps for the given duration.
-// REQUIRES: to_sleep <= MaxSleep().
-void SleepOnce(shield_absl::Duration to_sleep) {
-#ifdef _WIN32
-  Sleep(static_cast<DWORD>(to_sleep / shield_absl::Milliseconds(1)));
-#else
-  struct timespec sleep_time = shield_absl::ToTimespec(to_sleep);
-  while (nanosleep(&sleep_time, &sleep_time) != 0 && errno == EINTR) {
-    // Ignore signals and wait for the full interval to elapse.
-  }
-#endif
-}
-
-}  // namespace
-ABSL_NAMESPACE_END
-}  // namespace shield_absl
-
-extern "C" {
-
-ABSL_ATTRIBUTE_WEAK void ABSL_INTERNAL_C_SYMBOL(AbslInternalSleepFor)(
-    shield_absl::Duration duration) {
-  while (duration > shield_absl::ZeroDuration()) {
-    shield_absl::Duration to_sleep = std::min(duration, shield_absl::MaxSleep());
-    shield_absl::SleepOnce(to_sleep);
-    duration -= to_sleep;
-  }
-}
-
-}  // extern "C"
