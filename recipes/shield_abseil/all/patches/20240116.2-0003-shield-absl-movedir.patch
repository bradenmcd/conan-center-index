-TEST(FixedArrayTest, TooBigInlinedSpace) {
-  struct TooBig {
-    char c[1 << 20];
-  };  // too big for even one on the stack
-
-  // Simulate the data members of shield_absl::FixedArray, a pointer and a size_t.
-  struct Data {
-    TooBig* p;
-    size_t size;
-  };
-
-  // Make sure TooBig objects are not inlined for 0 or default size.
-  static_assert(sizeof(shield_absl::FixedArray<TooBig, 0>) == sizeof(Data),
-                "0-sized shield_absl::FixedArray should have same size as Data.");
-  static_assert(alignof(shield_absl::FixedArray<TooBig, 0>) == alignof(Data),
-                "0-sized shield_absl::FixedArray should have same alignment as Data.");
-  static_assert(sizeof(shield_absl::FixedArray<TooBig>) == sizeof(Data),
-                "default-sized shield_absl::FixedArray should have same size as Data");
-  static_assert(
-      alignof(shield_absl::FixedArray<TooBig>) == alignof(Data),
-      "default-sized shield_absl::FixedArray should have same alignment as Data.");
-}
