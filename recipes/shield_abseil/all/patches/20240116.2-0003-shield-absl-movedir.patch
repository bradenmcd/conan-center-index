+template <typename T>
+std::string StreamHelper(T value) {
+  std::ostringstream stream;
+  stream << value;
+  return stream.str();
+}
+
+TEST(StreamTest, Works) {
+  EXPECT_THAT(StreamHelper(static_cast<shield_absl::LogSeverity>(-100)),
+              Eq("shield_absl::LogSeverity(-100)"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverity::kInfo), Eq("INFO"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverity::kWarning), Eq("WARNING"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverity::kError), Eq("ERROR"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverity::kFatal), Eq("FATAL"));
+  EXPECT_THAT(StreamHelper(static_cast<shield_absl::LogSeverity>(4)),
+              Eq("shield_absl::LogSeverity(4)"));
+}
+
+static_assert(shield_absl::flags_internal::FlagUseValueAndInitBitStorage<
+                  shield_absl::LogSeverity>::value,
+              "Flags of type shield_absl::LogSeverity ought to be lock-free.");
+
+using ParseFlagFromOutOfRangeIntegerTest = TestWithParam<int64_t>;
+INSTANTIATE_TEST_SUITE_P(
