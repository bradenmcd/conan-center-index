+TEST(VariantTest, TestMoveSemantics) {
+  typedef variant<std::unique_ptr<int>, std::unique_ptr<std::string>> Variant;
+
+  // Construct a variant by moving from an element value.
+  Variant v(shield_absl::WrapUnique(new int(10)));
+  EXPECT_TRUE(shield_absl::holds_alternative<std::unique_ptr<int>>(v));
+
+  // Construct a variant by moving from another variant.
+  Variant v2(shield_absl::move(v));
+  ASSERT_TRUE(shield_absl::holds_alternative<std::unique_ptr<int>>(v2));
+  ASSERT_NE(nullptr, shield_absl::get<std::unique_ptr<int>>(v2));
+  EXPECT_EQ(10, *shield_absl::get<std::unique_ptr<int>>(v2));
+
+  // Moving from a variant object leaves it holding moved-from value of the
+  // same element type.
+  EXPECT_TRUE(shield_absl::holds_alternative<std::unique_ptr<int>>(v));
+  ASSERT_NE(nullptr, shield_absl::get_if<std::unique_ptr<int>>(&v));
+  EXPECT_EQ(nullptr, shield_absl::get<std::unique_ptr<int>>(v));
+
+  // Assign a variant from an element value by move.
+  v = shield_absl::make_unique<std::string>("foo");
+  ASSERT_TRUE(shield_absl::holds_alternative<std::unique_ptr<std::string>>(v));
+  EXPECT_EQ("foo", *shield_absl::get<std::unique_ptr<std::string>>(v));
+
+  // Move-assign a variant.
+  v2 = shield_absl::move(v);
+  ASSERT_TRUE(shield_absl::holds_alternative<std::unique_ptr<std::string>>(v2));
+  EXPECT_EQ("foo", *shield_absl::get<std::unique_ptr<std::string>>(v2));
+  EXPECT_TRUE(shield_absl::holds_alternative<std::unique_ptr<std::string>>(v));
+}
