-TEST(Format, CompareExtendSecondsVsSubseconds) {
-  const time_zone tz = utc_time_zone();
-
-  // This test case illustrates the differences/similarities between:
-  //   fmt_A: %E<prec>S
-  //   fmt_B: %S.%E<prec>f
-  auto fmt_A = [](const std::string& prec) { return "%E" + prec + "S"; };
-  auto fmt_B = [](const std::string& prec) { return "%S.%E" + prec + "f"; };
-
-  // No subseconds:
-  time_point<chrono::nanoseconds> tp = chrono::system_clock::from_time_t(0);
-  tp += chrono::seconds(5);
-  // ... %E*S and %S.%E*f are different.
-  EXPECT_EQ("05", shield_absl::time_internal::cctz::format(fmt_A("*"), tp, tz));
-  EXPECT_EQ("05.0", shield_absl::time_internal::cctz::format(fmt_B("*"), tp, tz));
-  // ... %E0S and %S.%E0f are different.
-  EXPECT_EQ("05", shield_absl::time_internal::cctz::format(fmt_A("0"), tp, tz));
-  EXPECT_EQ("05.", shield_absl::time_internal::cctz::format(fmt_B("0"), tp, tz));
-  // ... %E<prec>S and %S.%E<prec>f are the same for prec in [1:15].
-  for (int prec = 1; prec <= 15; ++prec) {
-    const std::string a =
-        shield_absl::time_internal::cctz::format(fmt_A(std::to_string(prec)), tp, tz);
-    const std::string b =
-        shield_absl::time_internal::cctz::format(fmt_B(std::to_string(prec)), tp, tz);
-    EXPECT_EQ(a, b) << "prec=" << prec;
-  }
-
-  // With subseconds:
-  // ... %E*S and %S.%E*f are the same.
-  tp += chrono::milliseconds(6) + chrono::microseconds(7) +
-        chrono::nanoseconds(8);
-  EXPECT_EQ("05.006007008",
-            shield_absl::time_internal::cctz::format(fmt_A("*"), tp, tz));
-  EXPECT_EQ("05.006007008",
-            shield_absl::time_internal::cctz::format(fmt_B("*"), tp, tz));
-  // ... %E0S and %S.%E0f are different.
-  EXPECT_EQ("05", shield_absl::time_internal::cctz::format(fmt_A("0"), tp, tz));
-  EXPECT_EQ("05.", shield_absl::time_internal::cctz::format(fmt_B("0"), tp, tz));
-  // ... %E<prec>S and %S.%E<prec>f are the same for prec in [1:15].
-  for (int prec = 1; prec <= 15; ++prec) {
-    const std::string a =
-        shield_absl::time_internal::cctz::format(fmt_A(std::to_string(prec)), tp, tz);
-    const std::string b =
-        shield_absl::time_internal::cctz::format(fmt_B(std::to_string(prec)), tp, tz);
-    EXPECT_EQ(a, b) << "prec=" << prec;
-  }
-}
