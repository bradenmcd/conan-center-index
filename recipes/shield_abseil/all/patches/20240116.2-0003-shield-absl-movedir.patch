+PayloadsVec AllVisitedPayloads(const shield_absl::Status& s) {
+  PayloadsVec result;
+
+  s.ForEachPayload([&](shield_absl::string_view type_url, const shield_absl::Cord& payload) {
+    result.push_back(std::make_pair(std::string(type_url), payload));
+  });
+
+  return result;
+}
+
+TEST(Status, TestForEachPayload) {
+  shield_absl::Status bad_status(shield_absl::StatusCode::kInternal, "fail");
+  bad_status.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+  bad_status.SetPayload(kUrl2, shield_absl::Cord(kPayload2));
+  bad_status.SetPayload(kUrl3, shield_absl::Cord(kPayload3));
+
+  int count = 0;
+
+  bad_status.ForEachPayload(
+      [&count](shield_absl::string_view, const shield_absl::Cord&) { ++count; });
+
+  EXPECT_EQ(count, 3);
+
+  PayloadsVec expected_payloads = {{kUrl1, shield_absl::Cord(kPayload1)},
+                                   {kUrl2, shield_absl::Cord(kPayload2)},
+                                   {kUrl3, shield_absl::Cord(kPayload3)}};
+
+  // Test that we visit all the payloads in the status.
+  PayloadsVec visited_payloads = AllVisitedPayloads(bad_status);
+  EXPECT_THAT(visited_payloads, UnorderedElementsAreArray(expected_payloads));
+
+  // Test that visitation order is not consistent between run.
+  std::vector<shield_absl::Status> scratch;
+  while (true) {
+    scratch.emplace_back(shield_absl::StatusCode::kInternal, "fail");
+
+    scratch.back().SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+    scratch.back().SetPayload(kUrl2, shield_absl::Cord(kPayload2));
+    scratch.back().SetPayload(kUrl3, shield_absl::Cord(kPayload3));
+
+    if (AllVisitedPayloads(scratch.back()) != visited_payloads) {
+      break;
+    }
+  }
+}
