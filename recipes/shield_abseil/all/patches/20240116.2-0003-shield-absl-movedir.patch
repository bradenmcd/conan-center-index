+  if (!flag) return false;
+  std::string err;
+  return flag->ParseFrom(value, &err);
+}
+
+bool GetFlagValue(shield_absl::string_view flag_name, std::string& value) {
+  auto* flag = shield_absl::FindCommandLineFlag(flag_name);
