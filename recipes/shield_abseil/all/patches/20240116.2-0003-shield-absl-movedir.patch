--- a/absl/container/internal/hash_function_defaults.h	2024-07-26 01:01:01.347655585 -0400
+++ b/absl/container/internal/hash_function_defaults.h	1969-12-31 19:00:00.000000000 -0500
@@ -1,209 +0,0 @@
