+            flags::FlagValueStorageKind::kOneWordAtomic);
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_test_flag_custom_udt), CustomUDT(1, 1));
+  shield_absl::SetFlag(&FLAGS_test_flag_custom_udt, CustomUDT(2, 3));
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_test_flag_custom_udt), CustomUDT(2, 3));
+}
