+TEST(Duration, ToConversion) {
+#define TEST_DURATION_CONVERSION(UNIT)                                  \
+  do {                                                                  \
+    const shield_absl::Duration d = shield_absl::UNIT(1.5);                           \
+    constexpr shield_absl::Duration z = shield_absl::ZeroDuration();                  \
+    constexpr shield_absl::Duration inf = shield_absl::InfiniteDuration();            \
+    constexpr double dbl_inf = std::numeric_limits<double>::infinity(); \
+    EXPECT_EQ(kint64min, shield_absl::ToInt64##UNIT(-inf));                    \
+    EXPECT_EQ(-1, shield_absl::ToInt64##UNIT(-d));                             \
+    EXPECT_EQ(0, shield_absl::ToInt64##UNIT(z));                               \
+    EXPECT_EQ(1, shield_absl::ToInt64##UNIT(d));                               \
+    EXPECT_EQ(kint64max, shield_absl::ToInt64##UNIT(inf));                     \
+    EXPECT_EQ(-dbl_inf, shield_absl::ToDouble##UNIT(-inf));                    \
+    EXPECT_EQ(-1.5, shield_absl::ToDouble##UNIT(-d));                          \
+    EXPECT_EQ(0, shield_absl::ToDouble##UNIT(z));                              \
+    EXPECT_EQ(1.5, shield_absl::ToDouble##UNIT(d));                            \
+    EXPECT_EQ(dbl_inf, shield_absl::ToDouble##UNIT(inf));                      \
+  } while (0)
+
+  TEST_DURATION_CONVERSION(Nanoseconds);
+  TEST_DURATION_CONVERSION(Microseconds);
+  TEST_DURATION_CONVERSION(Milliseconds);
+  TEST_DURATION_CONVERSION(Seconds);
+  TEST_DURATION_CONVERSION(Minutes);
+  TEST_DURATION_CONVERSION(Hours);
+
+#undef TEST_DURATION_CONVERSION
+}
