+TEST(Int128, AdditionSubtractionTest) {
+  // 64 bit pairs that will not cause overflow / underflow. These test negative
+  // carry; positive carry must be checked separately.
+  std::pair<int64_t, int64_t> cases[]{
+      {0, 0},                              // 0, 0
+      {0, 2945781290834},                  // 0, +
+      {1908357619234, 0},                  // +, 0
+      {0, -1204895918245},                 // 0, -
+      {-2957928523560, 0},                 // -, 0
+      {89023982312461, 98346012567134},    // +, +
+      {-63454234568239, -23456235230773},  // -, -
+      {98263457263502, -21428561935925},   // +, -
+      {-88235237438467, 15923659234573},   // -, +
+  };
+  for (const auto& pair : cases) {
+    SCOPED_TRACE(::testing::Message()
+                 << "pair = {" << pair.first << ", " << pair.second << '}');
+
+    EXPECT_EQ(shield_absl::int128(pair.first + pair.second),
+              shield_absl::int128(pair.first) + shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.second + pair.first),
+              shield_absl::int128(pair.second) += shield_absl::int128(pair.first));
+
+    EXPECT_EQ(shield_absl::int128(pair.first - pair.second),
+              shield_absl::int128(pair.first) - shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.second - pair.first),
+              shield_absl::int128(pair.second) -= shield_absl::int128(pair.first));
+
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.second + pair.first, 0),
+        shield_absl::MakeInt128(pair.second, 0) + shield_absl::MakeInt128(pair.first, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first + pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) += shield_absl::MakeInt128(pair.second, 0));
+
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.second - pair.first, 0),
+        shield_absl::MakeInt128(pair.second, 0) - shield_absl::MakeInt128(pair.first, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first - pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) -= shield_absl::MakeInt128(pair.second, 0));
+  }
+
+  // check positive carry
+  EXPECT_EQ(shield_absl::MakeInt128(31, 0),
+            shield_absl::MakeInt128(20, 1) +
+                shield_absl::MakeInt128(10, std::numeric_limits<uint64_t>::max()));
+}
