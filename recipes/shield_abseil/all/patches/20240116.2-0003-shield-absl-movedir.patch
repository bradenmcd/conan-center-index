-// Tests whether the sequence of chunks beginning at `haystack` starts with the
-// sequence of chunks beginning at `needle_begin` and extending to `needle_end`.
-//
-// REQUIRES: remaining `shield_absl::Cord` starting at `position` is greater than or
-// equal to `needle_end - needle_begin` and `advance`.
-bool IsSubcordInCordAt(shield_absl::Cord::CharIterator haystack,
-                       shield_absl::Cord::CharIterator needle_begin,
-                       shield_absl::Cord::CharIterator needle_end) {
-  while (needle_begin != needle_end) {
-    auto haystack_chunk = shield_absl::Cord::ChunkRemaining(haystack);
-    assert(!haystack_chunk.empty());
-    auto needle_chunk = shield_absl::Cord::ChunkRemaining(needle_begin);
-    auto min_length = std::min(haystack_chunk.size(), needle_chunk.size());
-    if (haystack_chunk.substr(0, min_length) !=
-        needle_chunk.substr(0, min_length)) {
-      return false;
-    }
-    shield_absl::Cord::Advance(&haystack, min_length);
-    shield_absl::Cord::Advance(&needle_begin, min_length);
-  }
-  return true;
-}
-
-// Tests whether the sequence of chunks beginning at `position` starts with the
-// cord `needle`.
-//
-// REQUIRES: remaining `shield_absl::Cord` starting at `position` is greater than or
-// equal to `needle.size()`.
-bool IsSubcordInCordAt(shield_absl::Cord::CharIterator position,
-                       const shield_absl::Cord& needle) {
-  return IsSubcordInCordAt(position, needle.char_begin(), needle.char_end());
-}
