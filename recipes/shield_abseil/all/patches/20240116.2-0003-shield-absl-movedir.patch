-  static void deallocate(const size_type size, btree_node *node,
-                         allocator_type *alloc) {
-    shield_absl::container_internal::SanitizerUnpoisonMemoryRegion(node, size);
-    shield_absl::container_internal::Deallocate<Alignment()>(alloc, node, size);
