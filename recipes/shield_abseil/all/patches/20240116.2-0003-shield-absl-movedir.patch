-TEST(Time, Limits) {
-  // It is an implementation detail that Time().rep_ == ZeroDuration(),
-  // and that the resolution of a Duration is 1/4 of a nanosecond.
-  const shield_absl::Time zero;
-  const shield_absl::Time max =
-      zero + shield_absl::Seconds(std::numeric_limits<int64_t>::max()) +
-      shield_absl::Nanoseconds(999999999) + shield_absl::Nanoseconds(3) / 4;
-  const shield_absl::Time min =
-      zero + shield_absl::Seconds(std::numeric_limits<int64_t>::min());
-
-  // Some simple max/min bounds checks.
-  EXPECT_LT(max, shield_absl::InfiniteFuture());
-  EXPECT_GT(min, shield_absl::InfinitePast());
-  EXPECT_LT(zero, max);
-  EXPECT_GT(zero, min);
-  EXPECT_GE(shield_absl::UnixEpoch(), min);
-  EXPECT_LT(shield_absl::UnixEpoch(), max);
-
-  // Check sign of Time differences.
-  EXPECT_LT(shield_absl::ZeroDuration(), max - zero);
-  EXPECT_LT(shield_absl::ZeroDuration(),
-            zero - shield_absl::Nanoseconds(1) / 4 - min);  // avoid zero - min
-
-  // Arithmetic works at max - 0.25ns and min + 0.25ns.
-  EXPECT_GT(max, max - shield_absl::Nanoseconds(1) / 4);
-  EXPECT_LT(min, min + shield_absl::Nanoseconds(1) / 4);
-}
