+}
+
+// Test the use of copy constructor and operator=
+TEST(AnyTest, Copy) {
+  InstanceTracker tracker_raii;
+
+  {
+    shield_absl::any o(shield_absl::in_place_type<CopyableOnlyInstance>, 123);
+    CopyableOnlyInstance* f1 = shield_absl::any_cast<CopyableOnlyInstance>(&o);
+
+    shield_absl::any o2(o);
+    const CopyableOnlyInstance* f2 = shield_absl::any_cast<CopyableOnlyInstance>(&o2);
+    EXPECT_EQ(123, f2->value());
+    EXPECT_NE(f1, f2);
+
+    shield_absl::any o3;
+    o3 = o2;
+    const CopyableOnlyInstance* f3 = shield_absl::any_cast<CopyableOnlyInstance>(&o3);
+    EXPECT_EQ(123, f3->value());
+    EXPECT_NE(f2, f3);
+
+    const shield_absl::any o4(4);
+    // copy construct from const lvalue ref.
+    shield_absl::any o5 = o4;
+    EXPECT_EQ(4, shield_absl::any_cast<int>(o4));
+    EXPECT_EQ(4, shield_absl::any_cast<int>(o5));
+
+    // Copy construct from const rvalue ref.
+    shield_absl::any o6 = std::move(o4);  // NOLINT
+    EXPECT_EQ(4, shield_absl::any_cast<int>(o4));
+    EXPECT_EQ(4, shield_absl::any_cast<int>(o6));
+  }
+}
+
+TEST(AnyTest, Move) {
+  InstanceTracker tracker_raii;
+
+  shield_absl::any any1;
+  any1.emplace<CopyableOnlyInstance>(5);
+
+  // This is a copy, so copy count increases to 1.
+  shield_absl::any any2 = any1;
+  EXPECT_EQ(5, shield_absl::any_cast<CopyableOnlyInstance&>(any1).value());
+  EXPECT_EQ(5, shield_absl::any_cast<CopyableOnlyInstance&>(any2).value());
+  EXPECT_EQ(1, tracker_raii.copies());
+
+  // This isn't a copy, so copy count doesn't increase.
+  shield_absl::any any3 = std::move(any2);
+  EXPECT_EQ(5, shield_absl::any_cast<CopyableOnlyInstance&>(any3).value());
+  EXPECT_EQ(1, tracker_raii.copies());
+
+  shield_absl::any any4;
+  any4 = std::move(any3);
+  EXPECT_EQ(5, shield_absl::any_cast<CopyableOnlyInstance&>(any4).value());
+  EXPECT_EQ(1, tracker_raii.copies());
+
+  shield_absl::any tmp4(4);
+  shield_absl::any o4(std::move(tmp4));  // move construct
+  EXPECT_EQ(4, shield_absl::any_cast<int>(o4));
+  o4 = *&o4;  // self assign
+  EXPECT_EQ(4, shield_absl::any_cast<int>(o4));
+  EXPECT_TRUE(o4.has_value());
+
+  shield_absl::any o5;
+  shield_absl::any tmp5(5);
+  o5 = std::move(tmp5);  // move assign
+  EXPECT_EQ(5, shield_absl::any_cast<int>(o5));
+}
+
+// Reset the ObjectOwner with an object of a different type
+TEST(AnyTest, Reset) {
+  shield_absl::any o;
+  o.emplace<int>();
+
+  o.reset();
+  EXPECT_FALSE(o.has_value());
+
+  o.emplace<char>();
+  EXPECT_TRUE(o.has_value());
+}
+
+TEST(AnyTest, ConversionConstructionCausesOneCopy) {
+  InstanceTracker tracker_raii;
+  CopyableOnlyInstance counter(5);
+  shield_absl::any o(counter);
+  EXPECT_EQ(5, shield_absl::any_cast<CopyableOnlyInstance&>(o).value());
+  EXPECT_EQ(1, tracker_raii.copies());
+}
