+TEST(AnyTest, MakeAny) {
+  const CopyOnly copy_only{};
+  auto o = shield_absl::make_any<IntMoveOnlyCopyOnly>(5, MoveOnly(), copy_only);
+  static_assert(std::is_same<decltype(o), shield_absl::any>::value, "");
+  EXPECT_EQ(5, shield_absl::any_cast<IntMoveOnlyCopyOnly&>(o).value);
+}
