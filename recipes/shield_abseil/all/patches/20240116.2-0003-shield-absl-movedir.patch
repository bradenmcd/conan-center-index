+TEST(Duration, FormatParseRoundTrip) {
+#define TEST_PARSE_ROUNDTRIP(d)                \
+  do {                                         \
+    std::string s = shield_absl::FormatDuration(d);   \
+    shield_absl::Duration dur;                        \
+    EXPECT_TRUE(shield_absl::ParseDuration(s, &dur)); \
+    EXPECT_EQ(d, dur);                         \
+  } while (0)
+
+  TEST_PARSE_ROUNDTRIP(shield_absl::Nanoseconds(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Microseconds(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Milliseconds(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Seconds(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Minutes(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(1) + shield_absl::Nanoseconds(2));
+
+  TEST_PARSE_ROUNDTRIP(shield_absl::Nanoseconds(-1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Microseconds(-1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Milliseconds(-1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Seconds(-1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Minutes(-1));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(-1));
+
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(-1) + shield_absl::Nanoseconds(2));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(1) + shield_absl::Nanoseconds(-2));
+  TEST_PARSE_ROUNDTRIP(shield_absl::Hours(-1) + shield_absl::Nanoseconds(-2));
+
+  TEST_PARSE_ROUNDTRIP(shield_absl::Nanoseconds(1) +
+                       shield_absl::Nanoseconds(1) / 4);  // 1.25ns
+
+  const shield_absl::Duration huge_range = ApproxYears(100000000000);
+  TEST_PARSE_ROUNDTRIP(huge_range);
+  TEST_PARSE_ROUNDTRIP(huge_range + (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1)));
+
+#undef TEST_PARSE_ROUNDTRIP
+}
