--- a/shield_absl/base/call_once_test.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/base/call_once_test.cc	2024-07-26 00:35:48.635938565 -0400
@@ -0,0 +1,107 @@
