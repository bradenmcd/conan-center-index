-std::chrono::system_clock::time_point ToChronoTime(shield_absl::Time t) {
-  using D = std::chrono::system_clock::duration;
-  auto d = time_internal::ToUnixDuration(t);
-  if (d < ZeroDuration()) d = Floor(d, FromChrono(D{1}));
