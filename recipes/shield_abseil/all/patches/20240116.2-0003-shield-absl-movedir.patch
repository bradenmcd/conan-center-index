+TEST(Status, CopyAssignmentIsNotRef) {
+  const shield_absl::Status status_orig(shield_absl::StatusCode::kInvalidArgument, "message");
+  shield_absl::Status status_copy = status_orig;
+  EXPECT_EQ(status_orig, status_copy);
+  status_copy.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+  EXPECT_NE(status_orig, status_copy);
+}
+
+TEST(Status, MoveConstructor) {
+  {
+    shield_absl::Status status;
+    shield_absl::Status copy(shield_absl::Status{});
+    EXPECT_EQ(copy, status);
+  }
+  {
+    shield_absl::Status status(shield_absl::StatusCode::kInvalidArgument, "message");
+    shield_absl::Status copy(
+        shield_absl::Status(shield_absl::StatusCode::kInvalidArgument, "message"));
+    EXPECT_EQ(copy, status);
+  }
+  {
+    shield_absl::Status status(shield_absl::StatusCode::kInvalidArgument, "message");
+    status.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+    shield_absl::Status copy1(status);
+    shield_absl::Status copy2(std::move(status));
+    EXPECT_EQ(copy1, copy2);
+  }
+}
+
+TEST(Status, MoveAssignment) {
+  shield_absl::Status assignee;
+  {
+    shield_absl::Status status;
+    assignee = shield_absl::Status();
+    EXPECT_EQ(assignee, status);
+  }
+  {
+    shield_absl::Status status(shield_absl::StatusCode::kInvalidArgument, "message");
+    assignee = shield_absl::Status(shield_absl::StatusCode::kInvalidArgument, "message");
+    EXPECT_EQ(assignee, status);
+  }
+  {
+    shield_absl::Status status(shield_absl::StatusCode::kInvalidArgument, "message");
+    status.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+    shield_absl::Status copy(status);
+    assignee = std::move(status);
+    EXPECT_EQ(assignee, copy);
+  }
+  {
+    shield_absl::Status status(shield_absl::StatusCode::kInvalidArgument, "message");
+    shield_absl::Status copy(status);
+    status = static_cast<shield_absl::Status&&>(status);
+    EXPECT_EQ(status, copy);
+  }
+}
+
+TEST(Status, Update) {
+  shield_absl::Status s;
+  s.Update(shield_absl::OkStatus());
+  EXPECT_TRUE(s.ok());
+  const shield_absl::Status a(shield_absl::StatusCode::kCancelled, "message");
+  s.Update(a);
+  EXPECT_EQ(s, a);
+  const shield_absl::Status b(shield_absl::StatusCode::kInternal, "other message");
+  s.Update(b);
+  EXPECT_EQ(s, a);
+  s.Update(shield_absl::OkStatus());
+  EXPECT_EQ(s, a);
+  EXPECT_FALSE(s.ok());
+}
+
+TEST(Status, Equality) {
+  shield_absl::Status ok;
+  shield_absl::Status no_payload = shield_absl::CancelledError("no payload");
+  shield_absl::Status one_payload = shield_absl::InvalidArgumentError("one payload");
+  one_payload.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+  shield_absl::Status two_payloads = one_payload;
+  two_payloads.SetPayload(kUrl2, shield_absl::Cord(kPayload2));
+  const std::array<shield_absl::Status, 4> status_arr = {ok, no_payload, one_payload,
+                                                  two_payloads};
+  for (int i = 0; i < status_arr.size(); i++) {
+    for (int j = 0; j < status_arr.size(); j++) {
+      if (i == j) {
+        EXPECT_TRUE(status_arr[i] == status_arr[j]);
+        EXPECT_FALSE(status_arr[i] != status_arr[j]);
+      } else {
+        EXPECT_TRUE(status_arr[i] != status_arr[j]);
+        EXPECT_FALSE(status_arr[i] == status_arr[j]);
+      }
+    }
+  }
+}
+
+TEST(Status, Swap) {
+  auto test_swap = [](const shield_absl::Status& s1, const shield_absl::Status& s2) {
+    shield_absl::Status copy1 = s1, copy2 = s2;
+    swap(copy1, copy2);
+    EXPECT_EQ(copy1, s2);
+    EXPECT_EQ(copy2, s1);
+  };
+  const shield_absl::Status ok;
+  const shield_absl::Status no_payload(shield_absl::StatusCode::kAlreadyExists, "no payload");
+  shield_absl::Status with_payload(shield_absl::StatusCode::kInternal, "with payload");
+  with_payload.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+  test_swap(ok, no_payload);
+  test_swap(no_payload, ok);
+  test_swap(ok, with_payload);
+  test_swap(with_payload, ok);
+  test_swap(no_payload, with_payload);
+  test_swap(with_payload, no_payload);
+}
+
+TEST(StatusErrno, ErrnoToStatusCode) {
+  EXPECT_EQ(shield_absl::ErrnoToStatusCode(0), shield_absl::StatusCode::kOk);
+
+  // Spot-check a few errno values.
+  EXPECT_EQ(shield_absl::ErrnoToStatusCode(EINVAL),
+            shield_absl::StatusCode::kInvalidArgument);
+  EXPECT_EQ(shield_absl::ErrnoToStatusCode(ENOENT), shield_absl::StatusCode::kNotFound);
+
+  // We'll pick a very large number so it hopefully doesn't collide to errno.
+  EXPECT_EQ(shield_absl::ErrnoToStatusCode(19980927), shield_absl::StatusCode::kUnknown);
+}
+
+TEST(StatusErrno, ErrnoToStatus) {
+  shield_absl::Status status = shield_absl::ErrnoToStatus(ENOENT, "Cannot open 'path'");
+  EXPECT_EQ(status.code(), shield_absl::StatusCode::kNotFound);
+  EXPECT_EQ(status.message(), "Cannot open 'path': No such file or directory");
+}
+
+}  // namespace
