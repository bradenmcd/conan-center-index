-  } else if (conv.precision() < 0) {
-    len = std::wcslen(v);
-  } else {
-    // If precision is set, we look for the NUL-terminator on the valid range.
-    len = static_cast<size_t>(std::find(v, v + conv.precision(), L'\0') - v);
