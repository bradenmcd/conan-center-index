+inline shield_absl::Nonnull<CordRep*> Cord::TakeRep() const& {
+  return CordRep::Ref(contents_.tree());
+}
+
+inline shield_absl::Nonnull<CordRep*> Cord::TakeRep() && {
+  CordRep* rep = contents_.tree();
+  contents_.clear();
+  return rep;
+}
