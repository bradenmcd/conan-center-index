+    shield_absl::Duration rem;                                       \
+    EXPECT_EQ(2, shield_absl::IDivDuration(UNIT(2), UNIT(1), &rem)); \
+    EXPECT_EQ(2.0, shield_absl::FDivDuration(UNIT(2), UNIT(1)));     \
+  } while (0)
+
+  TEST_MUL_OPS(shield_absl::Nanoseconds);
+  TEST_MUL_OPS(shield_absl::Microseconds);
+  TEST_MUL_OPS(shield_absl::Milliseconds);
+  TEST_MUL_OPS(shield_absl::Seconds);
+  TEST_MUL_OPS(shield_absl::Minutes);
+  TEST_MUL_OPS(shield_absl::Hours);
+
+#undef TEST_MUL_OPS
+
+  // Ensures that multiplication and division by 1 with a maxed-out durations
+  // doesn't lose precision.
+  shield_absl::Duration max_dur =
+      shield_absl::Seconds(kint64max) + (shield_absl::Seconds(1) - shield_absl::Nanoseconds(1) / 4);
+  shield_absl::Duration min_dur = shield_absl::Seconds(kint64min);
+  EXPECT_EQ(max_dur, max_dur * 1);
+  EXPECT_EQ(max_dur, max_dur / 1);
+  EXPECT_EQ(min_dur, min_dur * 1);
+  EXPECT_EQ(min_dur, min_dur / 1);
+
+  // Tests division on a Duration with a large number of significant digits.
+  // Tests when the digits span hi and lo as well as only in hi.
+  shield_absl::Duration sigfigs = shield_absl::Seconds(2000000000) + shield_absl::Nanoseconds(3);
+  EXPECT_EQ(shield_absl::Seconds(666666666) + shield_absl::Nanoseconds(666666667) +
+                shield_absl::Nanoseconds(1) / 2,
+            sigfigs / 3);
+  sigfigs = shield_absl::Seconds(int64_t{7000000000});
+  EXPECT_EQ(shield_absl::Seconds(2333333333) + shield_absl::Nanoseconds(333333333) +
+                shield_absl::Nanoseconds(1) / 4,
+            sigfigs / 3);
+
+  EXPECT_EQ(shield_absl::Seconds(7) + shield_absl::Milliseconds(500), shield_absl::Seconds(3) * 2.5);
+  EXPECT_EQ(shield_absl::Seconds(8) * -1 + shield_absl::Milliseconds(300),
+            (shield_absl::Seconds(2) + shield_absl::Milliseconds(200)) * -3.5);
+  EXPECT_EQ(-shield_absl::Seconds(8) + shield_absl::Milliseconds(300),
+            (shield_absl::Seconds(2) + shield_absl::Milliseconds(200)) * -3.5);
+  EXPECT_EQ(shield_absl::Seconds(1) + shield_absl::Milliseconds(875),
+            (shield_absl::Seconds(7) + shield_absl::Milliseconds(500)) / 4);
+  EXPECT_EQ(shield_absl::Seconds(30),
+            (shield_absl::Seconds(7) + shield_absl::Milliseconds(500)) / 0.25);
+  EXPECT_EQ(shield_absl::Seconds(3),
+            (shield_absl::Seconds(7) + shield_absl::Milliseconds(500)) / 2.5);
+
+  // Tests division remainder.
+  EXPECT_EQ(shield_absl::Nanoseconds(0), shield_absl::Nanoseconds(7) % shield_absl::Nanoseconds(1));
+  EXPECT_EQ(shield_absl::Nanoseconds(0), shield_absl::Nanoseconds(0) % shield_absl::Nanoseconds(10));
+  EXPECT_EQ(shield_absl::Nanoseconds(2), shield_absl::Nanoseconds(7) % shield_absl::Nanoseconds(5));
+  EXPECT_EQ(shield_absl::Nanoseconds(2), shield_absl::Nanoseconds(2) % shield_absl::Nanoseconds(5));
+
+  EXPECT_EQ(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(10) % shield_absl::Nanoseconds(3));
+  EXPECT_EQ(shield_absl::Nanoseconds(1),
+            shield_absl::Nanoseconds(10) % shield_absl::Nanoseconds(-3));
+  EXPECT_EQ(shield_absl::Nanoseconds(-1),
+            shield_absl::Nanoseconds(-10) % shield_absl::Nanoseconds(3));
+  EXPECT_EQ(shield_absl::Nanoseconds(-1),
+            shield_absl::Nanoseconds(-10) % shield_absl::Nanoseconds(-3));
+
+  EXPECT_EQ(shield_absl::Milliseconds(100),
+            shield_absl::Seconds(1) % shield_absl::Milliseconds(300));
+  EXPECT_EQ(
+      shield_absl::Milliseconds(300),
+      (shield_absl::Seconds(3) + shield_absl::Milliseconds(800)) % shield_absl::Milliseconds(500));
+
+  EXPECT_EQ(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(1) % shield_absl::Seconds(1));
+  EXPECT_EQ(shield_absl::Nanoseconds(-1), shield_absl::Nanoseconds(-1) % shield_absl::Seconds(1));
+  EXPECT_EQ(0, shield_absl::Nanoseconds(-1) / shield_absl::Seconds(1));  // Actual -1e-9
+
+  // Tests identity a = (a/b)*b + a%b
+#define TEST_MOD_IDENTITY(a, b) \
+  EXPECT_EQ((a), ((a) / (b))*(b) + ((a)%(b)))
+
+  TEST_MOD_IDENTITY(shield_absl::Seconds(0), shield_absl::Seconds(2));
+  TEST_MOD_IDENTITY(shield_absl::Seconds(1), shield_absl::Seconds(1));
+  TEST_MOD_IDENTITY(shield_absl::Seconds(1), shield_absl::Seconds(2));
+  TEST_MOD_IDENTITY(shield_absl::Seconds(2), shield_absl::Seconds(1));
+
+  TEST_MOD_IDENTITY(shield_absl::Seconds(-2), shield_absl::Seconds(1));
+  TEST_MOD_IDENTITY(shield_absl::Seconds(2), shield_absl::Seconds(-1));
+  TEST_MOD_IDENTITY(shield_absl::Seconds(-2), shield_absl::Seconds(-1));
+
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(0), shield_absl::Nanoseconds(2));
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(1));
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(2));
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(2), shield_absl::Nanoseconds(1));
+
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(-2), shield_absl::Nanoseconds(1));
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(2), shield_absl::Nanoseconds(-1));
+  TEST_MOD_IDENTITY(shield_absl::Nanoseconds(-2), shield_absl::Nanoseconds(-1));
+
+  // Mixed seconds + subseconds
+  shield_absl::Duration mixed_a = shield_absl::Seconds(1) + shield_absl::Nanoseconds(2);
+  shield_absl::Duration mixed_b = shield_absl::Seconds(1) + shield_absl::Nanoseconds(3);
+
+  TEST_MOD_IDENTITY(shield_absl::Seconds(0), mixed_a);
+  TEST_MOD_IDENTITY(mixed_a, mixed_a);
+  TEST_MOD_IDENTITY(mixed_a, mixed_b);
+  TEST_MOD_IDENTITY(mixed_b, mixed_a);
+
+  TEST_MOD_IDENTITY(-mixed_a, mixed_b);
+  TEST_MOD_IDENTITY(mixed_a, -mixed_b);
+  TEST_MOD_IDENTITY(-mixed_a, -mixed_b);
+
+#undef TEST_MOD_IDENTITY
+}
