diff -N -u -r '--exclude=.git' a/absl/container/fixed_array_exception_safety_test.cc b/absl/container/fixed_array_exception_safety_test.cc
--- a/absl/container/fixed_array_exception_safety_test.cc	2024-07-26 01:01:01.347655585 -0400
+++ b/absl/container/fixed_array_exception_safety_test.cc	1969-12-31 19:00:00.000000000 -0500
@@ -1,201 +0,0 @@
-// Copyright 2019 The Abseil Authors.
