+  VerifySimpleHexAtoiGood<shield_absl::uint128>(std::numeric_limits<uint32_t>::max(),
+                                         std::numeric_limits<uint32_t>::max());
+  VerifySimpleHexAtoiBad<shield_absl::uint128>(std::numeric_limits<int64_t>::min());
