+//
+// This file is a Posix-specific part of spinlock_wait.cc
+
+#include <sched.h>
+
+#include <atomic>
+#include <ctime>
+
+#include "shield_absl/base/internal/errno_saver.h"
+#include "shield_absl/base/internal/scheduling_mode.h"
+#include "shield_absl/base/port.h"
+
+extern "C" {
+
+ABSL_ATTRIBUTE_WEAK void ABSL_INTERNAL_C_SYMBOL(AbslInternalSpinLockDelay)(
+    std::atomic<uint32_t>* /* lock_word */, uint32_t /* value */, int loop,
+    shield_absl::base_internal::SchedulingMode /* mode */) {
+  shield_absl::base_internal::ErrnoSaver errno_saver;
+  if (loop == 0) {
+  } else if (loop == 1) {
+    sched_yield();
+  } else {
+    struct timespec tm;
+    tm.tv_sec = 0;
+    tm.tv_nsec = shield_absl::base_internal::SpinLockSuggestedDelayNS(loop);
+    nanosleep(&tm, nullptr);
+  }
+}
+
+ABSL_ATTRIBUTE_WEAK void ABSL_INTERNAL_C_SYMBOL(AbslInternalSpinLockWake)(
+    std::atomic<uint32_t>* /* lock_word */, bool /* all */) {}
+
+}  // extern "C"
diff -N -u -r '--exclude=.git' a/shield_absl/base/internal/spinlock_wait.cc b/shield_absl/base/internal/spinlock_wait.cc
--- a/shield_absl/base/internal/spinlock_wait.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/base/internal/spinlock_wait.cc	2024-07-26 00:35:48.643938585 -0400
@@ -0,0 +1,81 @@
+// Copyright 2017 The Abseil Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
