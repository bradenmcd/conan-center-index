+TEST(Time, FromCivilAlignment) {
+  const shield_absl::TimeZone utc = shield_absl::UTCTimeZone();
+  const shield_absl::CivilSecond cs(2015, 2, 3, 4, 5, 6);
+  shield_absl::Time t = shield_absl::FromCivil(cs, utc);
+  EXPECT_EQ("2015-02-03T04:05:06+00:00", shield_absl::FormatTime(t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilMinute(cs), utc);
+  EXPECT_EQ("2015-02-03T04:05:00+00:00", shield_absl::FormatTime(t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilHour(cs), utc);
+  EXPECT_EQ("2015-02-03T04:00:00+00:00", shield_absl::FormatTime(t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilDay(cs), utc);
+  EXPECT_EQ("2015-02-03T00:00:00+00:00", shield_absl::FormatTime(t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilMonth(cs), utc);
+  EXPECT_EQ("2015-02-01T00:00:00+00:00", shield_absl::FormatTime(t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilYear(cs), utc);
