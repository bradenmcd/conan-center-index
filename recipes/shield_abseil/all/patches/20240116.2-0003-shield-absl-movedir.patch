+// Weird type for testing, only used to make sure we "properly" perfect-forward
+// when being placed into an shield_absl::any (use the l-value constructor if given an
+// l-value rather than use the copy constructor).
+struct WeirdConstructor42 {
+  explicit WeirdConstructor42(int value) : value(value) {}
+
+  // Copy-constructor
+  WeirdConstructor42(const WeirdConstructor42& other) : value(other.value) {}
+
+  // L-value "weird" constructor (used when given an l-value)
+  WeirdConstructor42(
+      WeirdConstructor42& /*other*/)  // NOLINT(runtime/references)
+      : value(42) {}
+
+  int value;
+};
+#ifdef _MSC_VER
+#pragma warning( pop )
+#endif
+
+TEST(AnyTest, WeirdConversionConstruction) {
+  {
+    const WeirdConstructor42 source(5);
+    shield_absl::any o = source;  // Actual copy
+    EXPECT_EQ(5, shield_absl::any_cast<WeirdConstructor42&>(o).value);
+  }
+
+  {
+    WeirdConstructor42 source(5);
+    shield_absl::any o = source;  // Weird "conversion"
+    EXPECT_EQ(42, shield_absl::any_cast<WeirdConstructor42&>(o).value);
+  }
+}
+
+TEST(AnyTest, WeirdConversionAssignment) {
+  {
+    const WeirdConstructor42 source(5);
+    shield_absl::any o;
+    o = source;  // Actual copy
+    EXPECT_EQ(5, shield_absl::any_cast<WeirdConstructor42&>(o).value);
+  }
+
+  {
+    WeirdConstructor42 source(5);
+    shield_absl::any o;
+    o = source;  // Weird "conversion"
+    EXPECT_EQ(42, shield_absl::any_cast<WeirdConstructor42&>(o).value);
+  }
+}
+
+struct Value {};
+
+TEST(AnyTest, AnyCastValue) {
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<int>(o));
+    EXPECT_EQ(5, shield_absl::any_cast<int>(AsConst(o)));
+    static_assert(
+        std::is_same<decltype(shield_absl::any_cast<Value>(o)), Value>::value, "");
+  }
+
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<const int>(o));
+    EXPECT_EQ(5, shield_absl::any_cast<const int>(AsConst(o)));
+    static_assert(std::is_same<decltype(shield_absl::any_cast<const Value>(o)),
+                               const Value>::value,
+                  "");
+  }
+}
+
+TEST(AnyTest, AnyCastReference) {
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<int&>(o));
+    EXPECT_EQ(5, shield_absl::any_cast<const int&>(AsConst(o)));
+    static_assert(
+        std::is_same<decltype(shield_absl::any_cast<Value&>(o)), Value&>::value, "");
+  }
+
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<const int>(o));
+    EXPECT_EQ(5, shield_absl::any_cast<const int>(AsConst(o)));
+    static_assert(std::is_same<decltype(shield_absl::any_cast<const Value&>(o)),
+                               const Value&>::value,
+                  "");
+  }
+
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<int&&>(std::move(o)));
+    static_assert(std::is_same<decltype(shield_absl::any_cast<Value&&>(std::move(o))),
+                               Value&&>::value,
+                  "");
+  }
+
+  {
+    shield_absl::any o;
+    o.emplace<int>(5);
+    EXPECT_EQ(5, shield_absl::any_cast<const int>(std::move(o)));
+    static_assert(
+        std::is_same<decltype(shield_absl::any_cast<const Value&&>(std::move(o))),
+                     const Value&&>::value,
+        "");
+  }
+}
+
+TEST(AnyTest, AnyCastPointer) {
+  {
