-// Returns:
-//  found flag or nullptr
-//  is negative in case of --nofoo
-std::tuple<CommandLineFlag*, bool> LocateFlag(shield_absl::string_view flag_name) {
-  CommandLineFlag* flag = shield_absl::FindCommandLineFlag(flag_name);
-  bool is_negative = false;
-
-  if (!flag && shield_absl::ConsumePrefix(&flag_name, "no")) {
-    flag = shield_absl::FindCommandLineFlag(flag_name);
-    is_negative = true;
-  }
-
-  return std::make_tuple(flag, is_negative);
-}
