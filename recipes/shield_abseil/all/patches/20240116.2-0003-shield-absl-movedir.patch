-// NOTE: shield_absl::poisson_distribution is not guaranteed to be stable.
-TEST(PoissonDistributionTest, StabilityTest) {
-  using testing::ElementsAre;
-  // shield_absl::poisson_distribution stability relies on stability of
-  // std::exp, std::log, std::sqrt, std::ceil, std::floor, and
-  // shield_absl::FastUniformBits, shield_absl::StirlingLogFactorial, shield_absl::RandU64ToDouble.
