-  // This is reserved space for an shield_absl::Mutex to guard flag data. It will be
-  // initialized in FlagImpl::Init via placement new.
-  // We can't use "shield_absl::Mutex data_guard_", since this class is not literal.
-  // We do not want to use "shield_absl::Mutex* data_guard_", since this would require
