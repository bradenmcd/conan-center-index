-struct Cont {
-  Cont() = default;
-  explicit Cont(shield_absl::string_view src) : data(src) {}
-
-  shield_absl::string_view data;
-};
-
-template <int index>
-shield_absl::string_view get(const Cont& c) {
-  auto splitter = shield_absl::StrSplit(c.data, ':');
-  auto it = splitter.begin();
-  for (int i = 0; i < index; ++i) ++it;
-
-  return *it;
-}
