+TEST(Format, Basics) {
+  time_zone tz = utc_time_zone();
+  time_point<chrono::nanoseconds> tp = chrono::system_clock::from_time_t(0);
+
+  // Starts with a couple basic edge cases.
+  EXPECT_EQ("", shield_absl::time_internal::cctz::format("", tp, tz));
+  EXPECT_EQ(" ", shield_absl::time_internal::cctz::format(" ", tp, tz));
+  EXPECT_EQ("  ", shield_absl::time_internal::cctz::format("  ", tp, tz));
+  EXPECT_EQ("xxx", shield_absl::time_internal::cctz::format("xxx", tp, tz));
+  std::string big(128, 'x');
+  EXPECT_EQ(big, shield_absl::time_internal::cctz::format(big, tp, tz));
+  // Cause the 1024-byte buffer to grow.
+  std::string bigger(100000, 'x');
+  EXPECT_EQ(bigger, shield_absl::time_internal::cctz::format(bigger, tp, tz));
+
+  tp += chrono::hours(13) + chrono::minutes(4) + chrono::seconds(5);
+  tp += chrono::milliseconds(6) + chrono::microseconds(7) +
+        chrono::nanoseconds(8);
+  EXPECT_EQ("1970-01-01",
+            shield_absl::time_internal::cctz::format("%Y-%m-%d", tp, tz));
+  EXPECT_EQ("13:04:05", shield_absl::time_internal::cctz::format("%H:%M:%S", tp, tz));
+  EXPECT_EQ("13:04:05.006",
+            shield_absl::time_internal::cctz::format("%H:%M:%E3S", tp, tz));
+  EXPECT_EQ("13:04:05.006007",
+            shield_absl::time_internal::cctz::format("%H:%M:%E6S", tp, tz));
+  EXPECT_EQ("13:04:05.006007008",
+            shield_absl::time_internal::cctz::format("%H:%M:%E9S", tp, tz));
+}
