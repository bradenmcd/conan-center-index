-// Base that is dependent on whether or not the copy-constructor can be trivial.
-template <class... T>
-using VariantCopyBase = shield_absl::conditional_t<
-    shield_absl::disjunction<
-        shield_absl::negation<shield_absl::conjunction<std::is_copy_constructible<T>...>>,
-        std::is_copy_constructible<Union<T...>>>::value,
