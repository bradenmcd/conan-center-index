--- a/absl/base/call_once.h	2024-07-26 01:01:01.335655531 -0400
+++ b/absl/base/call_once.h	1969-12-31 19:00:00.000000000 -0500
@@ -1,225 +0,0 @@
-// Copyright 2017 The Abseil Authors.
