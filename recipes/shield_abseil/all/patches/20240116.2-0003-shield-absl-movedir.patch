-// `ABSL_LOGGING_INTERNAL_LOG_*` evaluates to a temporary `LogMessage` object or
-// to a related object with a compatible API but different behavior.  This set
-// of defines comes in three flavors: vanilla, plus two variants that strip some
-// logging in subtly different ways for subtly different reasons (see below).
-#if defined(STRIP_LOG) && STRIP_LOG
-#define ABSL_LOGGING_INTERNAL_LOG_INFO ::shield_absl::log_internal::NullStream()
-#define ABSL_LOGGING_INTERNAL_LOG_WARNING ::shield_absl::log_internal::NullStream()
-#define ABSL_LOGGING_INTERNAL_LOG_ERROR ::shield_absl::log_internal::NullStream()
-#define ABSL_LOGGING_INTERNAL_LOG_FATAL ::shield_absl::log_internal::NullStreamFatal()
-#define ABSL_LOGGING_INTERNAL_LOG_QFATAL ::shield_absl::log_internal::NullStreamFatal()
-#define ABSL_LOGGING_INTERNAL_LOG_DFATAL \
-  ::shield_absl::log_internal::NullStreamMaybeFatal(::shield_absl::kLogDebugFatal)
-#define ABSL_LOGGING_INTERNAL_LOG_LEVEL(severity) \
-  ::shield_absl::log_internal::NullStreamMaybeFatal(absl_log_internal_severity)
-#define ABSL_LOG_INTERNAL_CHECK(failure_message) ABSL_LOGGING_INTERNAL_LOG_FATAL
-#define ABSL_LOG_INTERNAL_QCHECK(failure_message) \
-  ABSL_LOGGING_INTERNAL_LOG_QFATAL
-#else  // !defined(STRIP_LOG) || !STRIP_LOG
-#define ABSL_LOGGING_INTERNAL_LOG_INFO \
-  ::shield_absl::log_internal::LogMessage(    \
-      __FILE__, __LINE__, ::shield_absl::log_internal::LogMessage::InfoTag{})
-#define ABSL_LOGGING_INTERNAL_LOG_WARNING \
-  ::shield_absl::log_internal::LogMessage(       \
-      __FILE__, __LINE__, ::shield_absl::log_internal::LogMessage::WarningTag{})
-#define ABSL_LOGGING_INTERNAL_LOG_ERROR \
-  ::shield_absl::log_internal::LogMessage(     \
-      __FILE__, __LINE__, ::shield_absl::log_internal::LogMessage::ErrorTag{})
-#define ABSL_LOGGING_INTERNAL_LOG_FATAL \
-  ::shield_absl::log_internal::LogMessageFatal(__FILE__, __LINE__)
-#define ABSL_LOGGING_INTERNAL_LOG_QFATAL \
-  ::shield_absl::log_internal::LogMessageQuietlyFatal(__FILE__, __LINE__)
-#define ABSL_LOGGING_INTERNAL_LOG_DFATAL \
-  ::shield_absl::log_internal::LogMessage(__FILE__, __LINE__, ::shield_absl::kLogDebugFatal)
-#define ABSL_LOGGING_INTERNAL_LOG_LEVEL(severity)      \
-  ::shield_absl::log_internal::LogMessage(__FILE__, __LINE__, \
-                                   absl_log_internal_severity)
-// These special cases dispatch to special-case constructors that allow us to
-// avoid an extra function call and shrink non-LTO binaries by a percent or so.
-#define ABSL_LOG_INTERNAL_CHECK(failure_message) \
-  ::shield_absl::log_internal::LogMessageFatal(__FILE__, __LINE__, failure_message)
-#define ABSL_LOG_INTERNAL_QCHECK(failure_message)                  \
-  ::shield_absl::log_internal::LogMessageQuietlyFatal(__FILE__, __LINE__, \
-                                               failure_message)
-#endif  // !defined(STRIP_LOG) || !STRIP_LOG
-
-#endif  // ABSL_LOG_INTERNAL_STRIP_H_
