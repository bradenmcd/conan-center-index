+    void set_data(shield_absl::Nonnull<const char*> data, size_t n);
+    shield_absl::Nonnull<char*> set_data(size_t n);  // Write data to the result
+    // Returns nullptr if holding bytes
+    shield_absl::Nullable<shield_absl::cord_internal::CordRep*> tree() const;
+    shield_absl::Nonnull<shield_absl::cord_internal::CordRep*> as_tree() const;
+    shield_absl::Nonnull<const char*> as_chars() const;
+    // Returns non-null iff was holding a pointer
+    shield_absl::Nullable<shield_absl::cord_internal::CordRep*> clear();
+    // Converts to pointer if necessary.
+    void reduce_size(size_t n);    // REQUIRES: holding data
+    void remove_prefix(size_t n);  // REQUIRES: holding data
+    void AppendArray(shield_absl::string_view src, MethodIdentifier method);
+    shield_absl::string_view FindFlatStartPiece() const;
+
+    // Creates a CordRepFlat instance from the current inlined data with `extra'
+    // bytes of desired additional capacity.
+    shield_absl::Nonnull<CordRepFlat*> MakeFlatWithExtraCapacity(size_t extra);
+
+    // Sets the tree value for this instance. `rep` must not be null.
+    // Requires the current instance to hold a tree, and a lock to be held on
+    // any CordzInfo referenced by this instance. The latter is enforced through
+    // the CordzUpdateScope argument. If the current instance is sampled, then
+    // the CordzInfo instance is updated to reference the new `rep` value.
+    void SetTree(shield_absl::Nonnull<CordRep*> rep, const CordzUpdateScope& scope);
+
+    // Identical to SetTree(), except that `rep` is allowed to be null, in
+    // which case the current instance is reset to an empty value.
+    void SetTreeOrEmpty(shield_absl::Nullable<CordRep*> rep,
+                        const CordzUpdateScope& scope);
+
+    // Sets the tree value for this instance, and randomly samples this cord.
+    // This function disregards existing contents in `data_`, and should be
+    // called when a Cord is 'promoted' from an 'uninitialized' or 'inlined'
+    // value to a non-inlined (tree / ring) value.
+    void EmplaceTree(shield_absl::Nonnull<CordRep*> rep, MethodIdentifier method);
+
+    // Identical to EmplaceTree, except that it copies the parent stack from
+    // the provided `parent` data if the parent is sampled.
+    void EmplaceTree(shield_absl::Nonnull<CordRep*> rep, const InlineData& parent,
+                     MethodIdentifier method);
+
+    // Commits the change of a newly created, or updated `rep` root value into
+    // this cord. `old_rep` indicates the old (inlined or tree) value of the
+    // cord, and determines if the commit invokes SetTree() or EmplaceTree().
+    void CommitTree(shield_absl::Nullable<const CordRep*> old_rep,
+                    shield_absl::Nonnull<CordRep*> rep, const CordzUpdateScope& scope,
+                    MethodIdentifier method);
+
+    void AppendTreeToInlined(shield_absl::Nonnull<CordRep*> tree,
+                             MethodIdentifier method);
+    void AppendTreeToTree(shield_absl::Nonnull<CordRep*> tree,
+                          MethodIdentifier method);
+    void AppendTree(shield_absl::Nonnull<CordRep*> tree, MethodIdentifier method);
+    void PrependTreeToInlined(shield_absl::Nonnull<CordRep*> tree,
+                              MethodIdentifier method);
+    void PrependTreeToTree(shield_absl::Nonnull<CordRep*> tree,
+                           MethodIdentifier method);
+    void PrependTree(shield_absl::Nonnull<CordRep*> tree, MethodIdentifier method);
+
+    bool IsSame(const InlineRep& other) const { return data_ == other.data_; }
+
+    void CopyTo(shield_absl::Nonnull<std::string*> dst) const {
+      // memcpy is much faster when operating on a known size. On most supported
+      // platforms, the small string optimization is large enough that resizing
+      // to 15 bytes does not cause a memory allocation.
+      shield_absl::strings_internal::STLStringResizeUninitialized(dst, kMaxInline);
+      data_.copy_max_inline_to(&(*dst)[0]);
+      // erase is faster than resize because the logic for memory allocation is
+      // not needed.
+      dst->erase(inline_size());
+    }
+
+    // Copies the inline contents into `dst`. Assumes the cord is not empty.
+    void CopyToArray(shield_absl::Nonnull<char*> dst) const;
+
+    bool is_tree() const { return data_.is_tree(); }
+
+    // Returns true if the Cord is being profiled by cordz.
+    bool is_profiled() const { return data_.is_tree() && data_.is_profiled(); }
+
+    // Returns the available inlined capacity, or 0 if is_tree() == true.
+    size_t remaining_inline_capacity() const {
+      return data_.is_tree() ? 0 : kMaxInline - data_.inline_size();
+    }
+
+    // Returns the profiled CordzInfo, or nullptr if not sampled.
+    shield_absl::Nullable<shield_absl::cord_internal::CordzInfo*> cordz_info() const {
+      return data_.cordz_info();
+    }
+
+    // Sets the profiled CordzInfo.
+    void set_cordz_info(shield_absl::Nonnull<cord_internal::CordzInfo*> cordz_info) {
+      assert(cordz_info != nullptr);
+      data_.set_cordz_info(cordz_info);
+    }
+
+    // Resets the current cordz_info to null / empty.
+    void clear_cordz_info() { data_.clear_cordz_info(); }
