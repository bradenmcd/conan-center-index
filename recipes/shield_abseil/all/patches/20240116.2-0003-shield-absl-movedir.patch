-// Append 0..len-1 to *v
-template <typename Container>
-static void Fill(Container* v, size_t len, int offset = 0) {
-  for (size_t i = 0; i < len; i++) {
-    v->push_back(static_cast<int>(i) + offset);
-  }
-}
