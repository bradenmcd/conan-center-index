+TEST(AnyTest, Noexcept) {
+  static_assert(std::is_nothrow_default_constructible<shield_absl::any>(), "");
+  static_assert(std::is_nothrow_move_constructible<shield_absl::any>(), "");
+  static_assert(std::is_nothrow_move_assignable<shield_absl::any>(), "");
+  static_assert(noexcept(std::declval<shield_absl::any&>().has_value()), "");
+  static_assert(noexcept(std::declval<shield_absl::any&>().type()), "");
+  static_assert(noexcept(shield_absl::any_cast<int>(std::declval<shield_absl::any*>())), "");
+  static_assert(
+      noexcept(std::declval<shield_absl::any&>().swap(std::declval<shield_absl::any&>())),
+      "");
+
+  using std::swap;
+  static_assert(
+      noexcept(swap(std::declval<shield_absl::any&>(), std::declval<shield_absl::any&>())),
+      "");
+}
