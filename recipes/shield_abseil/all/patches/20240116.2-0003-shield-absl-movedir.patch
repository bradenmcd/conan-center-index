+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "shield_absl/base/attributes.h"
+#include "shield_absl/log/internal/test_helpers.h"
+#include "shield_absl/log/internal/test_matchers.h"
+#include "shield_absl/log/log.h"
+#include "shield_absl/log/scoped_mock_log.h"
+
+namespace {
+using ::shield_absl::log_internal::MatchesOstream;
+using ::shield_absl::log_internal::TextMessage;
+using ::testing::Eq;
+
+auto *test_env ABSL_ATTRIBUTE_UNUSED = ::testing::AddGlobalTestEnvironment(
+    new shield_absl::log_internal::LogTestEnvironment);
+
+// Abseil Logging library uses these by default, so we set them on the
+// `std::ostream` we compare against too.
+std::ios &LoggingDefaults(std::ios &str) {
+  str.setf(std::ios_base::showbase | std::ios_base::boolalpha |
+           std::ios_base::internal);
+  return str;
+}
+
+TEST(StreamingFormatTest, LogAsLiteral) {
+  std::ostringstream stream;
+  const std::string not_a_literal("hello world");
+  stream << LoggingDefaults << shield_absl::LogAsLiteral(not_a_literal);
+
+  shield_absl::ScopedMockLog sink;
+
+  EXPECT_CALL(sink,
+              Send(AllOf(TextMessage(MatchesOstream(stream)),
+                         TextMessage(Eq("hello world")),
+                         ENCODED_MESSAGE(EqualsProto(
+                             R"pb(value { literal: "hello world" })pb")))));
+
+  sink.StartCapturingLogs();
+  LOG(INFO) << shield_absl::LogAsLiteral(not_a_literal);
+}
+
+}  // namespace
