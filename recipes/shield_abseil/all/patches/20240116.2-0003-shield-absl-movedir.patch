+#include <cstdint>
+#include <limits>
+#include <string>
+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "shield_absl/time/internal/test_util.h"
+#include "shield_absl/time/time.h"
+
+using testing::HasSubstr;
+
+namespace {
+
+// A helper that tests the given format specifier by itself, and with leading
+// and trailing characters.  For example: TestFormatSpecifier(t, "%a", "Thu").
+void TestFormatSpecifier(shield_absl::Time t, shield_absl::TimeZone tz,
+                         const std::string& fmt, const std::string& ans) {
+  EXPECT_EQ(ans, shield_absl::FormatTime(fmt, t, tz));
+  EXPECT_EQ("xxx " + ans, shield_absl::FormatTime("xxx " + fmt, t, tz));
+  EXPECT_EQ(ans + " yyy", shield_absl::FormatTime(fmt + " yyy", t, tz));
+  EXPECT_EQ("xxx " + ans + " yyy",
+            shield_absl::FormatTime("xxx " + fmt + " yyy", t, tz));
+}
+
+//
+// Testing FormatTime()
+//
+
+TEST(FormatTime, Basics) {
+  shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+  shield_absl::Time t = shield_absl::FromTimeT(0);
+
+  // Starts with a couple basic edge cases.
+  EXPECT_EQ("", shield_absl::FormatTime("", t, tz));
+  EXPECT_EQ(" ", shield_absl::FormatTime(" ", t, tz));
+  EXPECT_EQ("  ", shield_absl::FormatTime("  ", t, tz));
+  EXPECT_EQ("xxx", shield_absl::FormatTime("xxx", t, tz));
+  std::string big(128, 'x');
+  EXPECT_EQ(big, shield_absl::FormatTime(big, t, tz));
+  // Cause the 1024-byte buffer to grow.
+  std::string bigger(100000, 'x');
+  EXPECT_EQ(bigger, shield_absl::FormatTime(bigger, t, tz));
+
+  t += shield_absl::Hours(13) + shield_absl::Minutes(4) + shield_absl::Seconds(5);
+  t += shield_absl::Milliseconds(6) + shield_absl::Microseconds(7) + shield_absl::Nanoseconds(8);
+  EXPECT_EQ("1970-01-01", shield_absl::FormatTime("%Y-%m-%d", t, tz));
+  EXPECT_EQ("13:04:05", shield_absl::FormatTime("%H:%M:%S", t, tz));
+  EXPECT_EQ("13:04:05.006", shield_absl::FormatTime("%H:%M:%E3S", t, tz));
+  EXPECT_EQ("13:04:05.006007", shield_absl::FormatTime("%H:%M:%E6S", t, tz));
+  EXPECT_EQ("13:04:05.006007008", shield_absl::FormatTime("%H:%M:%E9S", t, tz));
+}
+
+TEST(FormatTime, LocaleSpecific) {
+  const shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+  shield_absl::Time t = shield_absl::FromTimeT(0);
+
+  TestFormatSpecifier(t, tz, "%a", "Thu");
+  TestFormatSpecifier(t, tz, "%A", "Thursday");
+  TestFormatSpecifier(t, tz, "%b", "Jan");
+  TestFormatSpecifier(t, tz, "%B", "January");
+
+  // %c should at least produce the numeric year and time-of-day.
+  const std::string s =
+      shield_absl::FormatTime("%c", shield_absl::FromTimeT(0), shield_absl::UTCTimeZone());
+  EXPECT_THAT(s, HasSubstr("1970"));
+  EXPECT_THAT(s, HasSubstr("00:00:00"));
+
+  TestFormatSpecifier(t, tz, "%p", "AM");
+  TestFormatSpecifier(t, tz, "%x", "01/01/70");
+  TestFormatSpecifier(t, tz, "%X", "00:00:00");
+}
+
+TEST(FormatTime, ExtendedSeconds) {
+  const shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+
+  // No subseconds.
+  shield_absl::Time t = shield_absl::FromTimeT(0) + shield_absl::Seconds(5);
+  EXPECT_EQ("05", shield_absl::FormatTime("%E*S", t, tz));
+  EXPECT_EQ("05.000000000000000", shield_absl::FormatTime("%E15S", t, tz));
+
+  // With subseconds.
+  t += shield_absl::Milliseconds(6) + shield_absl::Microseconds(7) + shield_absl::Nanoseconds(8);
+  EXPECT_EQ("05.006007008", shield_absl::FormatTime("%E*S", t, tz));
+  EXPECT_EQ("05", shield_absl::FormatTime("%E0S", t, tz));
+  EXPECT_EQ("05.006007008000000", shield_absl::FormatTime("%E15S", t, tz));
+
+  // Times before the Unix epoch.
+  t = shield_absl::FromUnixMicros(-1);
+  EXPECT_EQ("1969-12-31 23:59:59.999999",
+            shield_absl::FormatTime("%Y-%m-%d %H:%M:%E*S", t, tz));
+
+  // Here is a "%E*S" case we got wrong for a while.  While the first
+  // instant below is correctly rendered as "...:07.333304", the second
+  // one used to appear as "...:07.33330499999999999".
+  t = shield_absl::FromUnixMicros(1395024427333304);
+  EXPECT_EQ("2014-03-17 02:47:07.333304",
+            shield_absl::FormatTime("%Y-%m-%d %H:%M:%E*S", t, tz));
+  t += shield_absl::Microseconds(1);
+  EXPECT_EQ("2014-03-17 02:47:07.333305",
+            shield_absl::FormatTime("%Y-%m-%d %H:%M:%E*S", t, tz));
+}
+
+TEST(FormatTime, RFC1123FormatPadsYear) {  // locale specific
+  shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+
+  // A year of 77 should be padded to 0077.
+  shield_absl::Time t = shield_absl::FromCivil(shield_absl::CivilSecond(77, 6, 28, 9, 8, 7), tz);
+  EXPECT_EQ("Mon, 28 Jun 0077 09:08:07 +0000",
+            shield_absl::FormatTime(shield_absl::RFC1123_full, t, tz));
+  EXPECT_EQ("28 Jun 0077 09:08:07 +0000",
+            shield_absl::FormatTime(shield_absl::RFC1123_no_wday, t, tz));
+}
+
+TEST(FormatTime, InfiniteTime) {
+  shield_absl::TimeZone tz = shield_absl::time_internal::LoadTimeZone("America/Los_Angeles");
+
+  // The format and timezone are ignored.
+  EXPECT_EQ("infinite-future",
+            shield_absl::FormatTime("%H:%M blah", shield_absl::InfiniteFuture(), tz));
+  EXPECT_EQ("infinite-past",
+            shield_absl::FormatTime("%H:%M blah", shield_absl::InfinitePast(), tz));
+}
+
+//
+// Testing ParseTime()
+//
+
+TEST(ParseTime, Basics) {
+  shield_absl::Time t = shield_absl::FromTimeT(1234567890);
+  std::string err;
+
+  // Simple edge cases.
+  EXPECT_TRUE(shield_absl::ParseTime("", "", &t, &err)) << err;
+  EXPECT_EQ(shield_absl::UnixEpoch(), t);  // everything defaulted
+  EXPECT_TRUE(shield_absl::ParseTime(" ", " ", &t, &err)) << err;
+  EXPECT_TRUE(shield_absl::ParseTime("  ", "  ", &t, &err)) << err;
+  EXPECT_TRUE(shield_absl::ParseTime("x", "x", &t, &err)) << err;
+  EXPECT_TRUE(shield_absl::ParseTime("xxx", "xxx", &t, &err)) << err;
+
+  EXPECT_TRUE(shield_absl::ParseTime("%Y-%m-%d %H:%M:%S %z",
+                              "2013-06-28 19:08:09 -0800", &t, &err))
+      << err;
+  const auto ci = shield_absl::FixedTimeZone(-8 * 60 * 60).At(t);
+  EXPECT_EQ(shield_absl::CivilSecond(2013, 6, 28, 19, 8, 9), ci.cs);
+  EXPECT_EQ(shield_absl::ZeroDuration(), ci.subsecond);
+}
+
+TEST(ParseTime, NullErrorString) {
+  shield_absl::Time t;
+  EXPECT_FALSE(shield_absl::ParseTime("%Q", "invalid format", &t, nullptr));
+  EXPECT_FALSE(shield_absl::ParseTime("%H", "12 trailing data", &t, nullptr));
+  EXPECT_FALSE(
+      shield_absl::ParseTime("%H out of range", "42 out of range", &t, nullptr));
+}
+
+TEST(ParseTime, WithTimeZone) {
+  const shield_absl::TimeZone tz =
+      shield_absl::time_internal::LoadTimeZone("America/Los_Angeles");
+  shield_absl::Time t;
+  std::string e;
+
+  // We can parse a string without a UTC offset if we supply a timezone.
+  EXPECT_TRUE(
+      shield_absl::ParseTime("%Y-%m-%d %H:%M:%S", "2013-06-28 19:08:09", tz, &t, &e))
+      << e;
+  auto ci = tz.At(t);
+  EXPECT_EQ(shield_absl::CivilSecond(2013, 6, 28, 19, 8, 9), ci.cs);
+  EXPECT_EQ(shield_absl::ZeroDuration(), ci.subsecond);
+
+  // But the timezone is ignored when a UTC offset is present.
+  EXPECT_TRUE(shield_absl::ParseTime("%Y-%m-%d %H:%M:%S %z",
+                              "2013-06-28 19:08:09 +0800", tz, &t, &e))
+      << e;
+  ci = shield_absl::FixedTimeZone(8 * 60 * 60).At(t);
+  EXPECT_EQ(shield_absl::CivilSecond(2013, 6, 28, 19, 8, 9), ci.cs);
+  EXPECT_EQ(shield_absl::ZeroDuration(), ci.subsecond);
+}
+
+TEST(ParseTime, ErrorCases) {
+  shield_absl::Time t = shield_absl::FromTimeT(0);
+  std::string err;
+
+  EXPECT_FALSE(shield_absl::ParseTime("%S", "123", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+
+  // Can't parse an illegal format specifier.
+  err.clear();
+  EXPECT_FALSE(shield_absl::ParseTime("%Q", "x", &t, &err)) << err;
+  // Exact contents of "err" are platform-dependent because of
+  // differences in the strptime implementation between macOS and Linux.
+  EXPECT_FALSE(err.empty());
+
+  // Fails because of trailing, unparsed data "blah".
+  EXPECT_FALSE(shield_absl::ParseTime("%m-%d", "2-3 blah", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+
+  // Feb 31 requires normalization.
+  EXPECT_FALSE(shield_absl::ParseTime("%m-%d", "2-31", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Out-of-range"));
+
+  // Check that we cannot have spaces in UTC offsets.
+  EXPECT_TRUE(shield_absl::ParseTime("%z", "-0203", &t, &err)) << err;
+  EXPECT_FALSE(shield_absl::ParseTime("%z", "- 2 3", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_TRUE(shield_absl::ParseTime("%Ez", "-02:03", &t, &err)) << err;
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "- 2: 3", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+
+  // Check that we reject other malformed UTC offsets.
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "+-08:00", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "-+08:00", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+
+  // Check that we do not accept "-0" in fields that allow zero.
+  EXPECT_FALSE(shield_absl::ParseTime("%Y", "-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%E4Y", "-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%H", "-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%M", "-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%S", "-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%z", "+-000", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "+-0:00", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+  EXPECT_FALSE(shield_absl::ParseTime("%z", "-00-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "-00:-0", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+}
+
+TEST(ParseTime, ExtendedSeconds) {
+  std::string err;
+  shield_absl::Time t;
+
+  // Here is a "%E*S" case we got wrong for a while.  The fractional
+  // part of the first instant is less than 2^31 and was correctly
+  // parsed, while the second (and any subsecond field >=2^31) failed.
+  t = shield_absl::UnixEpoch();
+  EXPECT_TRUE(shield_absl::ParseTime("%E*S", "0.2147483647", &t, &err)) << err;
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(214748364) +
+                shield_absl::Nanoseconds(1) / 2,
+            t);
+  t = shield_absl::UnixEpoch();
+  EXPECT_TRUE(shield_absl::ParseTime("%E*S", "0.2147483648", &t, &err)) << err;
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(214748364) +
+                shield_absl::Nanoseconds(3) / 4,
+            t);
+
+  // We should also be able to specify long strings of digits far
+  // beyond the current resolution and have them convert the same way.
+  t = shield_absl::UnixEpoch();
+  EXPECT_TRUE(shield_absl::ParseTime(
+      "%E*S", "0.214748364801234567890123456789012345678901234567890123456789",
+      &t, &err))
+      << err;
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(214748364) +
+                shield_absl::Nanoseconds(3) / 4,
+            t);
+}
+
+TEST(ParseTime, ExtendedOffsetErrors) {
+  std::string err;
+  shield_absl::Time t;
+
+  // %z against +-HHMM.
+  EXPECT_FALSE(shield_absl::ParseTime("%z", "-123", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+
+  // %z against +-HH.
+  EXPECT_FALSE(shield_absl::ParseTime("%z", "-1", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+
+  // %Ez against +-HH:MM.
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "-12:3", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+
+  // %Ez against +-HHMM.
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "-123", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Illegal trailing data"));
+
+  // %Ez against +-HH.
+  EXPECT_FALSE(shield_absl::ParseTime("%Ez", "-1", &t, &err)) << err;
+  EXPECT_THAT(err, HasSubstr("Failed to parse"));
+}
+
+TEST(ParseTime, InfiniteTime) {
+  shield_absl::Time t;
+  std::string err;
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "infinite-future", &t, &err));
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+
+  // Surrounding whitespace.
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "  infinite-future", &t, &err));
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "infinite-future  ", &t, &err));
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "  infinite-future  ", &t, &err));
+  EXPECT_EQ(shield_absl::InfiniteFuture(), t);
+
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "infinite-past", &t, &err));
+  EXPECT_EQ(shield_absl::InfinitePast(), t);
+
+  // Surrounding whitespace.
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "  infinite-past", &t, &err));
+  EXPECT_EQ(shield_absl::InfinitePast(), t);
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "infinite-past  ", &t, &err));
+  EXPECT_EQ(shield_absl::InfinitePast(), t);
+  EXPECT_TRUE(shield_absl::ParseTime("%H:%M blah", "  infinite-past  ", &t, &err));
+  EXPECT_EQ(shield_absl::InfinitePast(), t);
+
+  // "infinite-future" as literal string
+  shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+  EXPECT_TRUE(shield_absl::ParseTime("infinite-future %H:%M", "infinite-future 03:04",
+                              &t, &err));
+  EXPECT_NE(shield_absl::InfiniteFuture(), t);
+  EXPECT_EQ(3, tz.At(t).cs.hour());
+  EXPECT_EQ(4, tz.At(t).cs.minute());
+
+  // "infinite-past" as literal string
+  EXPECT_TRUE(
+      shield_absl::ParseTime("infinite-past %H:%M", "infinite-past 03:04", &t, &err));
+  EXPECT_NE(shield_absl::InfinitePast(), t);
+  EXPECT_EQ(3, tz.At(t).cs.hour());
+  EXPECT_EQ(4, tz.At(t).cs.minute());
+
+  // The input doesn't match the format.
+  EXPECT_FALSE(shield_absl::ParseTime("infinite-future %H:%M", "03:04", &t, &err));
+  EXPECT_FALSE(shield_absl::ParseTime("infinite-past %H:%M", "03:04", &t, &err));
+}
+
+TEST(ParseTime, FailsOnUnrepresentableTime) {
+  const shield_absl::TimeZone utc = shield_absl::UTCTimeZone();
+  shield_absl::Time t;
+  EXPECT_FALSE(
+      shield_absl::ParseTime("%Y-%m-%d", "-292277022657-01-27", utc, &t, nullptr));
+  EXPECT_TRUE(
+      shield_absl::ParseTime("%Y-%m-%d", "-292277022657-01-28", utc, &t, nullptr));
+  EXPECT_TRUE(
+      shield_absl::ParseTime("%Y-%m-%d", "292277026596-12-04", utc, &t, nullptr));
+  EXPECT_FALSE(
+      shield_absl::ParseTime("%Y-%m-%d", "292277026596-12-05", utc, &t, nullptr));
+}
+
+//
+// Roundtrip test for FormatTime()/ParseTime().
+//
+
+TEST(FormatParse, RoundTrip) {
+  const shield_absl::TimeZone lax =
+      shield_absl::time_internal::LoadTimeZone("America/Los_Angeles");
+  const shield_absl::Time in =
+      shield_absl::FromCivil(shield_absl::CivilSecond(1977, 6, 28, 9, 8, 7), lax);
+  const shield_absl::Duration subseconds = shield_absl::Nanoseconds(654321);
+  std::string err;
+
+  // RFC3339, which renders subseconds.
+  {
+    shield_absl::Time out;
+    const std::string s =
+        shield_absl::FormatTime(shield_absl::RFC3339_full, in + subseconds, lax);
+    EXPECT_TRUE(shield_absl::ParseTime(shield_absl::RFC3339_full, s, &out, &err))
+        << s << ": " << err;
+    EXPECT_EQ(in + subseconds, out);  // RFC3339_full includes %Ez
+  }
+
+  // RFC1123, which only does whole seconds.
+  {
+    shield_absl::Time out;
+    const std::string s = shield_absl::FormatTime(shield_absl::RFC1123_full, in, lax);
+    EXPECT_TRUE(shield_absl::ParseTime(shield_absl::RFC1123_full, s, &out, &err))
+        << s << ": " << err;
+    EXPECT_EQ(in, out);  // RFC1123_full includes %z
+  }
+
+  // `shield_absl::FormatTime()` falls back to strftime() for "%c", which appears to
+  // work. On Windows, `shield_absl::ParseTime()` falls back to std::get_time() which
+  // appears to fail on "%c" (or at least on the "%c" text produced by
+  // `strftime()`). This makes it fail the round-trip test.
+  //
+  // Under the emscripten compiler `shield_absl::ParseTime() falls back to
+  // `strptime()`, but that ends up using a different definition for "%c"
+  // compared to `strftime()`, also causing the round-trip test to fail
+  // (see https://github.com/kripken/emscripten/pull/7491).
+#if !defined(_MSC_VER) && !defined(__EMSCRIPTEN__)
+  // Even though we don't know what %c will produce, it should roundtrip,
+  // but only in the 0-offset timezone.
+  {
+    shield_absl::Time out;
+    const std::string s = shield_absl::FormatTime("%c", in, shield_absl::UTCTimeZone());
+    EXPECT_TRUE(shield_absl::ParseTime("%c", s, &out, &err)) << s << ": " << err;
+    EXPECT_EQ(in, out);
+  }
+#endif  // !_MSC_VER && !__EMSCRIPTEN__
+}
+
+TEST(FormatParse, RoundTripDistantFuture) {
+  const shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+  const shield_absl::Time in =
+      shield_absl::FromUnixSeconds(std::numeric_limits<int64_t>::max());
+  std::string err;
+
+  shield_absl::Time out;
+  const std::string s = shield_absl::FormatTime(shield_absl::RFC3339_full, in, tz);
+  EXPECT_TRUE(shield_absl::ParseTime(shield_absl::RFC3339_full, s, &out, &err))
+      << s << ": " << err;
+  EXPECT_EQ(in, out);
+}
+
+TEST(FormatParse, RoundTripDistantPast) {
+  const shield_absl::TimeZone tz = shield_absl::UTCTimeZone();
+  const shield_absl::Time in =
+      shield_absl::FromUnixSeconds(std::numeric_limits<int64_t>::min());
+  std::string err;
+
+  shield_absl::Time out;
+  const std::string s = shield_absl::FormatTime(shield_absl::RFC3339_full, in, tz);
+  EXPECT_TRUE(shield_absl::ParseTime(shield_absl::RFC3339_full, s, &out, &err))
+      << s << ": " << err;
+  EXPECT_EQ(in, out);
+}
