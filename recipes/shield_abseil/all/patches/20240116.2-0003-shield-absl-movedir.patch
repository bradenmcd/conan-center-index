-U256 LeftShift(U256 v, int s) {
-  if (s == 0) {
-    return v;
-  } else if (s < 128) {
-    return {(v.hi << s) | (v.lo >> (128 - s)), v.lo << s};
-  } else {
-    return {v.lo << (s - 128), 0};
-  }
-}
