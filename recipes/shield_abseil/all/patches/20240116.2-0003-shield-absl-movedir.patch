+void VerifyApproxSameAsMul(double time_as_seconds, int* const misses) {
+  auto direct_seconds = shield_absl::Seconds(time_as_seconds);
+  auto mul_by_one_second = time_as_seconds * shield_absl::Seconds(1);
+  // These are expected to differ by up to one tick due to fused multiply/add
+  // contraction.
+  if (shield_absl::AbsDuration(direct_seconds - mul_by_one_second) >
+      shield_absl::time_internal::MakeDuration(0, 1u)) {
+    if (*misses > 10) return;
+    ASSERT_LE(++(*misses), 10) << "Too many errors, not reporting more.";
+    EXPECT_EQ(direct_seconds, mul_by_one_second)
+        << "given double time_as_seconds = " << std::setprecision(17)
+        << time_as_seconds;
+  }
+}
