+TEST(Int128, DivisionAndModuloTest) {
+  // Check against 64 bit division and modulo operators with a sample of
+  // randomly generated pairs.
+  std::pair<int64_t, int64_t> small_pairs[] = {
+      {0x15f2a64138, 0x67da05},    {0x5e56d194af43045f, 0xcf1543fb99},
+      {0x15e61ed052036a, -0xc8e6}, {0x88125a341e85, -0xd23fb77683},
+      {-0xc06e20, 0x5a},           {-0x4f100219aea3e85d, 0xdcc56cb4efe993},
+      {-0x168d629105, -0xa7},      {-0x7b44e92f03ab2375, -0x6516},
+  };
+  for (const std::pair<int64_t, int64_t>& pair : small_pairs) {
+    SCOPED_TRACE(::testing::Message()
+                 << "pair = {" << pair.first << ", " << pair.second << '}');
+
+    shield_absl::int128 dividend = pair.first;
+    shield_absl::int128 divisor = pair.second;
+    int64_t quotient = pair.first / pair.second;
+    int64_t remainder = pair.first % pair.second;
+
+    EXPECT_EQ(quotient, dividend / divisor);
+    EXPECT_EQ(quotient, shield_absl::int128(dividend) /= divisor);
+    EXPECT_EQ(remainder, dividend % divisor);
+    EXPECT_EQ(remainder, shield_absl::int128(dividend) %= divisor);
+  }
+
+  // Test behavior with 0, 1, and -1 with a sample of randomly generated large
+  // values.
+  shield_absl::int128 values[] = {
+      shield_absl::MakeInt128(0x63d26ee688a962b2, 0x9e1411abda5c1d70),
+      shield_absl::MakeInt128(0x152f385159d6f986, 0xbf8d48ef63da395d),
+      -shield_absl::MakeInt128(0x3098d7567030038c, 0x14e7a8a098dc2164),
+      -shield_absl::MakeInt128(0x49a037aca35c809f, 0xa6a87525480ef330),
+  };
+  for (shield_absl::int128 value : values) {
+    SCOPED_TRACE(::testing::Message() << "value = " << value);
+
+    EXPECT_EQ(0, 0 / value);
+    EXPECT_EQ(0, shield_absl::int128(0) /= value);
+    EXPECT_EQ(0, 0 % value);
+    EXPECT_EQ(0, shield_absl::int128(0) %= value);
+
+    EXPECT_EQ(value, value / 1);
+    EXPECT_EQ(value, shield_absl::int128(value) /= 1);
+    EXPECT_EQ(0, value % 1);
+    EXPECT_EQ(0, shield_absl::int128(value) %= 1);
+
+    EXPECT_EQ(-value, value / -1);
+    EXPECT_EQ(-value, shield_absl::int128(value) /= -1);
+    EXPECT_EQ(0, value % -1);
+    EXPECT_EQ(0, shield_absl::int128(value) %= -1);
+  }
+
+  // Min and max values
+  EXPECT_EQ(0, shield_absl::Int128Max() / shield_absl::Int128Min());
+  EXPECT_EQ(shield_absl::Int128Max(), shield_absl::Int128Max() % shield_absl::Int128Min());
+  EXPECT_EQ(-1, shield_absl::Int128Min() / shield_absl::Int128Max());
+  EXPECT_EQ(-1, shield_absl::Int128Min() % shield_absl::Int128Max());
+
+  // Power of two division and modulo of random large dividends
+  shield_absl::int128 positive_values[] = {
+      shield_absl::MakeInt128(0x21e1a1cc69574620, 0xe7ac447fab2fc869),
+      shield_absl::MakeInt128(0x32c2ff3ab89e66e8, 0x03379a613fd1ce74),
+      shield_absl::MakeInt128(0x6f32ca786184dcaf, 0x046f9c9ecb3a9ce1),
+      shield_absl::MakeInt128(0x1aeb469dd990e0ee, 0xda2740f243cd37eb),
+  };
+  for (shield_absl::int128 value : positive_values) {
+    for (int i = 0; i < 127; ++i) {
+      SCOPED_TRACE(::testing::Message()
+                   << "value = " << value << "; i = " << i);
+      shield_absl::int128 power_of_two = shield_absl::int128(1) << i;
+
+      EXPECT_EQ(value >> i, value / power_of_two);
+      EXPECT_EQ(value >> i, shield_absl::int128(value) /= power_of_two);
+      EXPECT_EQ(value & (power_of_two - 1), value % power_of_two);
+      EXPECT_EQ(value & (power_of_two - 1),
+                shield_absl::int128(value) %= power_of_two);
+    }
+  }
+
+  // Manually calculated cases with random large dividends
+  struct DivisionModCase {
+    shield_absl::int128 dividend;
+    shield_absl::int128 divisor;
+    shield_absl::int128 quotient;
+    shield_absl::int128 remainder;
+  };
+  DivisionModCase manual_cases[] = {
+      {shield_absl::MakeInt128(0x6ada48d489007966, 0x3c9c5c98150d5d69),
+       shield_absl::MakeInt128(0x8bc308fb, 0x8cb9cc9a3b803344), 0xc3b87e08,
+       shield_absl::MakeInt128(0x1b7db5e1, 0xd9eca34b7af04b49)},
+      {shield_absl::MakeInt128(0xd6946511b5b, 0x4886c5c96546bf5f),
+       -shield_absl::MakeInt128(0x263b, 0xfd516279efcfe2dc), -0x59cbabf0,
+       shield_absl::MakeInt128(0x622, 0xf462909155651d1f)},
+      {-shield_absl::MakeInt128(0x33db734f9e8d1399, 0x8447ac92482bca4d), 0x37495078240,
+       -shield_absl::MakeInt128(0xf01f1, 0xbc0368bf9a77eae8), -0x21a508f404d},
+      {-shield_absl::MakeInt128(0x13f837b409a07e7d, 0x7fc8e248a7d73560), -0x1b9f,
+       shield_absl::MakeInt128(0xb9157556d724, 0xb14f635714d7563e), -0x1ade},
+  };
+  for (const DivisionModCase test_case : manual_cases) {
+    EXPECT_EQ(test_case.quotient, test_case.dividend / test_case.divisor);
+    EXPECT_EQ(test_case.quotient,
+              shield_absl::int128(test_case.dividend) /= test_case.divisor);
+    EXPECT_EQ(test_case.remainder, test_case.dividend % test_case.divisor);
+    EXPECT_EQ(test_case.remainder,
+              shield_absl::int128(test_case.dividend) %= test_case.divisor);
+  }
+}
