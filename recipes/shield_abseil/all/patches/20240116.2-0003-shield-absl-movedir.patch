+TEST(Duration, Factories) {
+  constexpr shield_absl::Duration zero = shield_absl::ZeroDuration();
+  constexpr shield_absl::Duration nano = shield_absl::Nanoseconds(1);
+  constexpr shield_absl::Duration micro = shield_absl::Microseconds(1);
+  constexpr shield_absl::Duration milli = shield_absl::Milliseconds(1);
+  constexpr shield_absl::Duration sec = shield_absl::Seconds(1);
+  constexpr shield_absl::Duration min = shield_absl::Minutes(1);
+  constexpr shield_absl::Duration hour = shield_absl::Hours(1);
+
+  EXPECT_EQ(zero, shield_absl::Duration());
+  EXPECT_EQ(zero, shield_absl::Seconds(0));
+  EXPECT_EQ(nano, shield_absl::Nanoseconds(1));
+  EXPECT_EQ(micro, shield_absl::Nanoseconds(1000));
+  EXPECT_EQ(milli, shield_absl::Microseconds(1000));
+  EXPECT_EQ(sec, shield_absl::Milliseconds(1000));
+  EXPECT_EQ(min, shield_absl::Seconds(60));
+  EXPECT_EQ(hour, shield_absl::Minutes(60));
+
+  // Tests factory limits
+  const shield_absl::Duration inf = shield_absl::InfiniteDuration();
+
+  EXPECT_GT(inf, shield_absl::Seconds(kint64max));
+  EXPECT_LT(-inf, shield_absl::Seconds(kint64min));
+  EXPECT_LT(-inf, shield_absl::Seconds(-kint64max));
+
+  EXPECT_EQ(inf, shield_absl::Minutes(kint64max));
+  EXPECT_EQ(-inf, shield_absl::Minutes(kint64min));
+  EXPECT_EQ(-inf, shield_absl::Minutes(-kint64max));
+  EXPECT_GT(inf, shield_absl::Minutes(kint64max / 60));
+  EXPECT_LT(-inf, shield_absl::Minutes(kint64min / 60));
+  EXPECT_LT(-inf, shield_absl::Minutes(-kint64max / 60));
+
+  EXPECT_EQ(inf, shield_absl::Hours(kint64max));
+  EXPECT_EQ(-inf, shield_absl::Hours(kint64min));
+  EXPECT_EQ(-inf, shield_absl::Hours(-kint64max));
+  EXPECT_GT(inf, shield_absl::Hours(kint64max / 3600));
+  EXPECT_LT(-inf, shield_absl::Hours(kint64min / 3600));
