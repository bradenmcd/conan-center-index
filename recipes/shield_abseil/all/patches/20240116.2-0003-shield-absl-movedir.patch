+struct KeyCompareToWeakOrdering {
+  template <typename T>
+  shield_absl::weak_ordering operator()(const T &a, const T &b) const {
+    return a < b ? shield_absl::weak_ordering::less
+                 : a == b ? shield_absl::weak_ordering::equivalent
+                          : shield_absl::weak_ordering::greater;
+  }
+};
+
+struct KeyCompareToStrongOrdering {
+  template <typename T>
+  shield_absl::strong_ordering operator()(const T &a, const T &b) const {
+    return a < b ? shield_absl::strong_ordering::less
+                 : a == b ? shield_absl::strong_ordering::equal
+                          : shield_absl::strong_ordering::greater;
+  }
+};
