-struct CustomUDT {
-  CustomUDT() : a(1), b(1) {}
-  CustomUDT(int a_, int b_) : a(a_), b(b_) {}
-
-  friend bool operator==(const CustomUDT& f1, const CustomUDT& f2) {
-    return f1.a == f2.a && f1.b == f2.b;
-  }
-
-  int a;
-  int b;
-};
-bool AbslParseFlag(shield_absl::string_view in, CustomUDT* f, std::string*) {
-  std::vector<shield_absl::string_view> parts =
-      shield_absl::StrSplit(in, ':', shield_absl::SkipWhitespace());
-
-  if (parts.size() != 2) return false;
-
-  if (!shield_absl::SimpleAtoi(parts[0], &f->a)) return false;
-
-  if (!shield_absl::SimpleAtoi(parts[1], &f->b)) return false;
-
-  return true;
-}
-std::string AbslUnparseFlag(const CustomUDT& f) {
-  return shield_absl::StrCat(f.a, ":", f.b);
-}
