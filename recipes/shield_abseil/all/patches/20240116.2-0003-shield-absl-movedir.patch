+TEST_F(RandomDistributionsTest, UniformNonsenseRanges) {
+  // The ranges used in this test are undefined behavior.
+  // The results are arbitrary and subject to future changes.
+
+#if (defined(__i386__) || defined(_M_IX86)) && FLT_EVAL_METHOD != 0
+  // We're using an x87-compatible FPU, and intermediate operations can be
+  // performed with 80-bit floats. This produces slightly different results from
+  // what we expect below.
+  GTEST_SKIP()
+      << "Skipping the test because we detected x87 floating-point semantics";
+#endif
+
+  shield_absl::InsecureBitGen gen;
+
+  // <uint>
+  EXPECT_EQ(0, shield_absl::Uniform<uint64_t>(gen, 0, 0));
+  EXPECT_EQ(1, shield_absl::Uniform<uint64_t>(gen, 1, 0));
+  EXPECT_EQ(0, shield_absl::Uniform<uint64_t>(shield_absl::IntervalOpenOpen, gen, 0, 0));
+  EXPECT_EQ(1, shield_absl::Uniform<uint64_t>(shield_absl::IntervalOpenOpen, gen, 1, 0));
+
+  constexpr auto m = (std::numeric_limits<uint64_t>::max)();
+
+  EXPECT_EQ(m, shield_absl::Uniform(gen, m, m));
+  EXPECT_EQ(m, shield_absl::Uniform(gen, m, m - 1));
+  EXPECT_EQ(m - 1, shield_absl::Uniform(gen, m - 1, m));
+  EXPECT_EQ(m, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, m, m));
+  EXPECT_EQ(m, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, m, m - 1));
+  EXPECT_EQ(m - 1, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, m - 1, m));
+
+  // <int>
+  EXPECT_EQ(0, shield_absl::Uniform<int64_t>(gen, 0, 0));
+  EXPECT_EQ(1, shield_absl::Uniform<int64_t>(gen, 1, 0));
+  EXPECT_EQ(0, shield_absl::Uniform<int64_t>(shield_absl::IntervalOpenOpen, gen, 0, 0));
+  EXPECT_EQ(1, shield_absl::Uniform<int64_t>(shield_absl::IntervalOpenOpen, gen, 1, 0));
+
+  constexpr auto l = (std::numeric_limits<int64_t>::min)();
+  constexpr auto r = (std::numeric_limits<int64_t>::max)();
+
+  EXPECT_EQ(l, shield_absl::Uniform(gen, l, l));
+  EXPECT_EQ(r, shield_absl::Uniform(gen, r, r));
+  EXPECT_EQ(r, shield_absl::Uniform(gen, r, r - 1));
+  EXPECT_EQ(r - 1, shield_absl::Uniform(gen, r - 1, r));
+  EXPECT_EQ(l, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, l, l));
+  EXPECT_EQ(r, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, r, r));
+  EXPECT_EQ(r, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, r, r - 1));
+  EXPECT_EQ(r - 1, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, r - 1, r));
+
+  // <double>
+  const double e = std::nextafter(1.0, 2.0);  // 1 + epsilon
+  const double f = std::nextafter(1.0, 0.0);  // 1 - epsilon
+  const double g = std::numeric_limits<double>::denorm_min();
+
+  EXPECT_EQ(1.0, shield_absl::Uniform(gen, 1.0, e));
+  EXPECT_EQ(1.0, shield_absl::Uniform(gen, 1.0, f));
+  EXPECT_EQ(0.0, shield_absl::Uniform(gen, 0.0, g));
+
+  EXPECT_EQ(e, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, 1.0, e));
+  EXPECT_EQ(f, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, 1.0, f));
+  EXPECT_EQ(g, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, 0.0, g));
+}
