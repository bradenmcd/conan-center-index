-inline ABSL_TARGET_CRYPTO void SwapEndian(shield_absl::uint128* state) {
-  for (uint32_t block = 0; block < RandenTraits::kFeistelBlocks; ++block) {
-    Vector128Store(ReverseBytes(Vector128Load(state + block)), state + block);
