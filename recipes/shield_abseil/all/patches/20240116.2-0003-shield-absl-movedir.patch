+TEST(StrCat, CornerCases) {
+  std::string result;
+
+  result = shield_absl::StrCat("");  // NOLINT
+  EXPECT_EQ(result, "");
+  result = shield_absl::StrCat("", "");
+  EXPECT_EQ(result, "");
+  result = shield_absl::StrCat("", "", "");
+  EXPECT_EQ(result, "");
+  result = shield_absl::StrCat("", "", "", "");
+  EXPECT_EQ(result, "");
+  result = shield_absl::StrCat("", "", "", "", "");
+  EXPECT_EQ(result, "");
+}
