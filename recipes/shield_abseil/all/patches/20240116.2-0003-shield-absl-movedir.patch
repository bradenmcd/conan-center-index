-TEST(Time, Range) {
-  // The API's documented range is +/- 100 billion years.
-  const shield_absl::Duration range = shield_absl::Hours(24) * 365.2425 * 100000000000;
-
-  // Arithmetic and comparison still works at +/-range around base values.
-  shield_absl::Time bases[2] = {shield_absl::UnixEpoch(), shield_absl::Now()};
-  for (const auto base : bases) {
-    shield_absl::Time bottom = base - range;
-    EXPECT_GT(bottom, bottom - shield_absl::Nanoseconds(1));
-    EXPECT_LT(bottom, bottom + shield_absl::Nanoseconds(1));
-    shield_absl::Time top = base + range;
-    EXPECT_GT(top, top - shield_absl::Nanoseconds(1));
-    EXPECT_LT(top, top + shield_absl::Nanoseconds(1));
-    shield_absl::Duration full_range = 2 * range;
-    EXPECT_EQ(full_range, top - bottom);
-    EXPECT_EQ(-full_range, bottom - top);
-  }
-}
