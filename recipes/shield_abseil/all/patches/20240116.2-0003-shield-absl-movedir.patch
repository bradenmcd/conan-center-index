+TEST_P(CordTest, TryFlatCommonlyAssumedInvariants) {
+  // The behavior tested below is not part of the API contract of Cord, but it's
+  // something we intend to be true in our current implementation.  This test
+  // exists to detect and prevent accidental breakage of the implementation.
+  shield_absl::string_view fragments[] = {"A fragmented test",
+                                   " cord",
+                                   " to test subcords",
+                                   " of ",
+                                   "a",
+                                   " cord for",
+                                   " each chunk "
+                                   "returned by the ",
+                                   "iterator"};
+  shield_absl::Cord c = shield_absl::MakeFragmentedCord(fragments);
+  MaybeHarden(c);
+  int fragment = 0;
+  int offset = 0;
+  shield_absl::Cord::CharIterator itc = c.char_begin();
+  for (shield_absl::string_view sv : c.Chunks()) {
+    shield_absl::string_view expected = fragments[fragment];
+    shield_absl::Cord subcord1 = c.Subcord(offset, sv.length());
+    shield_absl::Cord subcord2 = shield_absl::Cord::AdvanceAndRead(&itc, sv.size());
+    EXPECT_EQ(subcord1.TryFlat(), expected);
+    EXPECT_EQ(subcord2.TryFlat(), expected);
+    ++fragment;
+    offset += sv.length();
+  }
+}
+
+static bool IsFlat(const shield_absl::Cord& c) {
+  return c.chunk_begin() == c.chunk_end() || ++c.chunk_begin() == c.chunk_end();
+}
+
+static void VerifyFlatten(shield_absl::Cord c) {
+  std::string old_contents(c);
+  shield_absl::string_view old_flat;
+  bool already_flat_and_non_empty = IsFlat(c) && !c.empty();
+  if (already_flat_and_non_empty) {
+    old_flat = *c.chunk_begin();
+  }
+  shield_absl::string_view new_flat = c.Flatten();
+
+  // Verify that the contents of the flattened Cord are correct.
+  EXPECT_EQ(new_flat, old_contents);
+  EXPECT_EQ(std::string(c), old_contents);
+
+  // If the Cord contained data and was already flat, verify that the data
+  // wasn't copied.
+  if (already_flat_and_non_empty) {
+    EXPECT_EQ(old_flat.data(), new_flat.data())
+        << "Allocated new memory even though the Cord was already flat.";
+  }
+
+  // Verify that the flattened Cord is in fact flat.
+  EXPECT_TRUE(IsFlat(c));
+}
+
+TEST_P(CordTest, Flatten) {
+  VerifyFlatten(shield_absl::Cord());
+  VerifyFlatten(MaybeHardened(shield_absl::Cord("small cord")));
+  VerifyFlatten(
+      MaybeHardened(shield_absl::Cord("larger than small buffer optimization")));
+  VerifyFlatten(MaybeHardened(
+      shield_absl::MakeFragmentedCord({"small ", "fragmented ", "cord"})));
+
+  // Test with a cord that is longer than the largest flat buffer
+  RandomEngine rng(GTEST_FLAG_GET(random_seed));
+  VerifyFlatten(MaybeHardened(shield_absl::Cord(RandomLowercaseString(&rng, 8192))));
+}
