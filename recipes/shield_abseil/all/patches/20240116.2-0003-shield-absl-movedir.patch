+// -----------------------------------------------------------------------------
+// File: log/log_sink_registry.h
+// -----------------------------------------------------------------------------
+//
+// This header declares APIs to operate on global set of registered log sinks.
+
+#ifndef ABSL_LOG_LOG_SINK_REGISTRY_H_
+#define ABSL_LOG_LOG_SINK_REGISTRY_H_
+
+#include "shield_absl/base/config.h"
+#include "shield_absl/log/internal/log_sink_set.h"
+#include "shield_absl/log/log_sink.h"
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+// AddLogSink(), RemoveLogSink()
+//
+// Adds or removes a `shield_absl::LogSink` as a consumer of logging data.
+//
+// These functions are thread-safe.
+//
+// It is an error to attempt to add a sink that's already registered or to
+// attempt to remove one that isn't.
+//
+// To avoid unbounded recursion, dispatch to registered `shield_absl::LogSink`s is
+// disabled per-thread while running the `Send()` method of registered
+// `shield_absl::LogSink`s.  Affected messages are dispatched to a special internal
+// sink instead which writes them to `stderr`.
+//
+// Do not call these inside `shield_absl::LogSink::Send`.
+inline void AddLogSink(shield_absl::LogSink* sink) { log_internal::AddLogSink(sink); }
+inline void RemoveLogSink(shield_absl::LogSink* sink) {
+  log_internal::RemoveLogSink(sink);
+}
+
+// FlushLogSinks()
+//
+// Calls `shield_absl::LogSink::Flush` on all registered sinks.
+//
+// Do not call this inside `shield_absl::LogSink::Send`.
+inline void FlushLogSinks() { log_internal::FlushLogSinks(); }
+
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#endif  // ABSL_LOG_LOG_SINK_REGISTRY_H_
