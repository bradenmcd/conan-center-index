+TEST(Int128, BitwiseLogicTest) {
+  EXPECT_EQ(shield_absl::int128(-1), ~shield_absl::int128(0));
+
+  shield_absl::int128 values[]{
+      0, -1, 0xde400bee05c3ff6b, shield_absl::MakeInt128(0x7f32178dd81d634a, 0),
+      shield_absl::MakeInt128(0xaf539057055613a9, 0x7d104d7d946c2e4d)};
+  for (shield_absl::int128 value : values) {
+    EXPECT_EQ(value, ~~value);
+
+    EXPECT_EQ(value, value | value);
+    EXPECT_EQ(value, value & value);
+    EXPECT_EQ(0, value ^ value);
+
+    EXPECT_EQ(value, shield_absl::int128(value) |= value);
+    EXPECT_EQ(value, shield_absl::int128(value) &= value);
+    EXPECT_EQ(0, shield_absl::int128(value) ^= value);
+
+    EXPECT_EQ(value, value | 0);
+    EXPECT_EQ(0, value & 0);
+    EXPECT_EQ(value, value ^ 0);
+
+    EXPECT_EQ(shield_absl::int128(-1), value | shield_absl::int128(-1));
+    EXPECT_EQ(value, value & shield_absl::int128(-1));
+    EXPECT_EQ(~value, value ^ shield_absl::int128(-1));
+  }
+
+  // small sample of randomly generated int64_t's
+  std::pair<int64_t, int64_t> pairs64[]{
+      {0x7f86797f5e991af4, 0x1ee30494fb007c97},
+      {0x0b278282bacf01af, 0x58780e0a57a49e86},
+      {0x059f266ccb93a666, 0x3d5b731bae9286f5},
+      {0x63c0c4820f12108c, 0x58166713c12e1c3a},
+      {0x381488bb2ed2a66e, 0x2220a3eb76a3698c},
+      {0x2a0a0dfb81e06f21, 0x4b60585927f5523c},
+      {0x555b1c3a03698537, 0x25478cd19d8e53cb},
+      {0x4750f6f27d779225, 0x16397553c6ff05fc},
+  };
+  for (const std::pair<int64_t, int64_t>& pair : pairs64) {
+    SCOPED_TRACE(::testing::Message()
+                 << "pair = {" << pair.first << ", " << pair.second << '}');
+
+    EXPECT_EQ(shield_absl::MakeInt128(~pair.first, ~pair.second),
+              ~shield_absl::MakeInt128(pair.first, pair.second));
+
+    EXPECT_EQ(shield_absl::int128(pair.first & pair.second),
+              shield_absl::int128(pair.first) & shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.first | pair.second),
+              shield_absl::int128(pair.first) | shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.first ^ pair.second),
+              shield_absl::int128(pair.first) ^ shield_absl::int128(pair.second));
+
+    EXPECT_EQ(shield_absl::int128(pair.first & pair.second),
+              shield_absl::int128(pair.first) &= shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.first | pair.second),
+              shield_absl::int128(pair.first) |= shield_absl::int128(pair.second));
+    EXPECT_EQ(shield_absl::int128(pair.first ^ pair.second),
+              shield_absl::int128(pair.first) ^= shield_absl::int128(pair.second));
+
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first & pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) & shield_absl::MakeInt128(pair.second, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first | pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) | shield_absl::MakeInt128(pair.second, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first ^ pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) ^ shield_absl::MakeInt128(pair.second, 0));
+
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first & pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) &= shield_absl::MakeInt128(pair.second, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first | pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) |= shield_absl::MakeInt128(pair.second, 0));
+    EXPECT_EQ(
+        shield_absl::MakeInt128(pair.first ^ pair.second, 0),
+        shield_absl::MakeInt128(pair.first, 0) ^= shield_absl::MakeInt128(pair.second, 0));
+  }
+}
