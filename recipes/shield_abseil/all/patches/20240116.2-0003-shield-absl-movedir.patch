-        EXPECT_EQ(tracker.copies() + tracker.moves(),
-                  static_cast<int>(len) - 2);
-      }
-    }
-
-    tracker.ResetCopiesMovesSwaps();
-    int instances_before_empty_erase = tracker.instances();
-    v.erase(v.begin(), v.begin());
