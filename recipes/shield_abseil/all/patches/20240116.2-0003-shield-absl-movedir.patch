-template <class T, int percent_skip>
-struct AlmostSequential {
-  mutable Sequential<T> current;
-
-  auto operator()() const -> decltype(current()) {
-    while (shield_absl::Uniform(GlobalBitGen(), 0.0, 1.0) <= percent_skip / 100.)
-      current();
-    return current();
-  }
-};
-
-struct Uniform {
-  template <typename T>
-  T operator()(T) const {
-    return shield_absl::Uniform<T>(shield_absl::IntervalClosed, GlobalBitGen(), T{0}, ~T{0});
-  }
-};
-
-struct Gaussian {
-  template <typename T>
-  T operator()(T) const {
-    double d;
-    do {
-      d = shield_absl::Gaussian<double>(GlobalBitGen(), 1e6, 1e4);
-    } while (d <= 0 || d > std::numeric_limits<T>::max() / 2);
-    return static_cast<T>(d);
-  }
-};
-
-struct Zipf {
-  template <typename T>
-  T operator()(T) const {
-    return shield_absl::Zipf<T>(GlobalBitGen(), std::numeric_limits<T>::max(), 1.6);
-  }
-};
-
-template <class T, class Dist>
-struct Random {
-  T operator()() const { return Dist{}(T{}); }
-};
