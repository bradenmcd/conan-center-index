+  shield_absl::SetFlag(&FLAGS_optional_optional_int, shield_absl::optional<int>{0});
+  EXPECT_TRUE(shield_absl::GetFlag(FLAGS_optional_optional_int).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_optional_optional_int), 0);
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_optional_optional_int), shield_absl::optional<int>{0});
+
+  shield_absl::SetFlag(&FLAGS_optional_optional_int, shield_absl::nullopt);
+  EXPECT_FALSE(shield_absl::GetFlag(FLAGS_optional_optional_int).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_optional_optional_int), shield_absl::nullopt);
+}
+
+// --------------------------------------------------------------------
+
+#if defined(ABSL_HAVE_STD_OPTIONAL) && !defined(ABSL_USES_STD_OPTIONAL)
+
+TEST_F(FlagTest, TestStdOptional) {
+  EXPECT_FALSE(shield_absl::GetFlag(FLAGS_std_optional_int64).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_std_optional_int64), std::nullopt);
+
+  shield_absl::SetFlag(&FLAGS_std_optional_int64, 0);
+  EXPECT_TRUE(shield_absl::GetFlag(FLAGS_std_optional_int64).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_std_optional_int64), 0);
+
+  shield_absl::SetFlag(&FLAGS_std_optional_int64, 0xFFFFFFFFFF16);
+  EXPECT_TRUE(shield_absl::GetFlag(FLAGS_std_optional_int64).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_std_optional_int64), 0xFFFFFFFFFF16);
+
+  shield_absl::SetFlag(&FLAGS_std_optional_int64, std::nullopt);
+  EXPECT_FALSE(shield_absl::GetFlag(FLAGS_std_optional_int64).has_value());
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_std_optional_int64), std::nullopt);
+}
+
+// --------------------------------------------------------------------
+
+#endif
