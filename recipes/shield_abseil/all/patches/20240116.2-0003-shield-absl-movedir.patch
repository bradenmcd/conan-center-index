+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+// -----------------------------------------------------------------------------
+// File: match.h
+// -----------------------------------------------------------------------------
+//
+// This file contains simple utilities for performing string matching checks.
+// All of these function parameters are specified as `shield_absl::string_view`,
+// meaning that these functions can accept `std::string`, `shield_absl::string_view` or
+// NUL-terminated C-style strings.
+//
+// Examples:
+//   std::string s = "foo";
+//   shield_absl::string_view sv = "f";
+//   assert(shield_absl::StrContains(s, sv));
+//
+// Note: The order of parameters in these functions is designed to mimic the
+// order an equivalent member function would exhibit;
+// e.g. `s.Contains(x)` ==> `shield_absl::StrContains(s, x).
+#ifndef ABSL_STRINGS_MATCH_H_
+#define ABSL_STRINGS_MATCH_H_
+
+#include <cstring>
+
+#include "shield_absl/strings/string_view.h"
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+// StrContains()
+//
+// Returns whether a given string `haystack` contains the substring `needle`.
+inline bool StrContains(shield_absl::string_view haystack,
+                        shield_absl::string_view needle) noexcept {
+  return haystack.find(needle, 0) != haystack.npos;
+}
+
+inline bool StrContains(shield_absl::string_view haystack, char needle) noexcept {
+  return haystack.find(needle) != haystack.npos;
+}
+
+// StartsWith()
+//
+// Returns whether a given string `text` begins with `prefix`.
+inline bool StartsWith(shield_absl::string_view text,
+                       shield_absl::string_view prefix) noexcept {
+  return prefix.empty() ||
+         (text.size() >= prefix.size() &&
+          memcmp(text.data(), prefix.data(), prefix.size()) == 0);
+}
+
+// EndsWith()
+//
+// Returns whether a given string `text` ends with `suffix`.
+inline bool EndsWith(shield_absl::string_view text,
+                     shield_absl::string_view suffix) noexcept {
+  return suffix.empty() ||
+         (text.size() >= suffix.size() &&
+          memcmp(text.data() + (text.size() - suffix.size()), suffix.data(),
+                 suffix.size()) == 0);
+}
+// StrContainsIgnoreCase()
+//
+// Returns whether a given ASCII string `haystack` contains the ASCII substring
+// `needle`, ignoring case in the comparison.
+bool StrContainsIgnoreCase(shield_absl::string_view haystack,
+                           shield_absl::string_view needle) noexcept;
+
+bool StrContainsIgnoreCase(shield_absl::string_view haystack,
+                           char needle) noexcept;
+
+// EqualsIgnoreCase()
+//
+// Returns whether given ASCII strings `piece1` and `piece2` are equal, ignoring
+// case in the comparison.
+bool EqualsIgnoreCase(shield_absl::string_view piece1,
+                      shield_absl::string_view piece2) noexcept;
+
+// StartsWithIgnoreCase()
+//
+// Returns whether a given ASCII string `text` starts with `prefix`,
+// ignoring case in the comparison.
+bool StartsWithIgnoreCase(shield_absl::string_view text,
+                          shield_absl::string_view prefix) noexcept;
+
+// EndsWithIgnoreCase()
+//
+// Returns whether a given ASCII string `text` ends with `suffix`, ignoring
+// case in the comparison.
+bool EndsWithIgnoreCase(shield_absl::string_view text,
+                        shield_absl::string_view suffix) noexcept;
+
+// Yields the longest prefix in common between both input strings.
+// Pointer-wise, the returned result is a subset of input "a".
+shield_absl::string_view FindLongestCommonPrefix(shield_absl::string_view a,
+                                          shield_absl::string_view b);
+
+// Yields the longest suffix in common between both input strings.
+// Pointer-wise, the returned result is a subset of input "a".
+shield_absl::string_view FindLongestCommonSuffix(shield_absl::string_view a,
+                                          shield_absl::string_view b);
+
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#endif  // ABSL_STRINGS_MATCH_H_
diff -N -u -r '--exclude=.git' a/shield_absl/strings/match_test.cc b/shield_absl/strings/match_test.cc
--- a/shield_absl/strings/match_test.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/strings/match_test.cc	2024-07-26 00:35:48.659938622 -0400
@@ -0,0 +1,291 @@
+// Copyright 2017 The Abseil Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      https://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "shield_absl/strings/match.h"
+
+#include <string>
+
+#include "gtest/gtest.h"
+#include "shield_absl/strings/string_view.h"
+
+namespace {
+
+TEST(MatchTest, StartsWith) {
+  const std::string s1("123\0abc", 7);
+  const shield_absl::string_view a("foobar");
+  const shield_absl::string_view b(s1);
+  const shield_absl::string_view e;
+  EXPECT_TRUE(shield_absl::StartsWith(a, a));
+  EXPECT_TRUE(shield_absl::StartsWith(a, "foo"));
+  EXPECT_TRUE(shield_absl::StartsWith(a, e));
+  EXPECT_TRUE(shield_absl::StartsWith(b, s1));
+  EXPECT_TRUE(shield_absl::StartsWith(b, b));
+  EXPECT_TRUE(shield_absl::StartsWith(b, e));
+  EXPECT_TRUE(shield_absl::StartsWith(e, ""));
+  EXPECT_FALSE(shield_absl::StartsWith(a, b));
+  EXPECT_FALSE(shield_absl::StartsWith(b, a));
+  EXPECT_FALSE(shield_absl::StartsWith(e, a));
+}
+
+TEST(MatchTest, EndsWith) {
+  const std::string s1("123\0abc", 7);
+  const shield_absl::string_view a("foobar");
+  const shield_absl::string_view b(s1);
+  const shield_absl::string_view e;
+  EXPECT_TRUE(shield_absl::EndsWith(a, a));
+  EXPECT_TRUE(shield_absl::EndsWith(a, "bar"));
+  EXPECT_TRUE(shield_absl::EndsWith(a, e));
+  EXPECT_TRUE(shield_absl::EndsWith(b, s1));
+  EXPECT_TRUE(shield_absl::EndsWith(b, b));
+  EXPECT_TRUE(shield_absl::EndsWith(b, e));
+  EXPECT_TRUE(shield_absl::EndsWith(e, ""));
+  EXPECT_FALSE(shield_absl::EndsWith(a, b));
+  EXPECT_FALSE(shield_absl::EndsWith(b, a));
+  EXPECT_FALSE(shield_absl::EndsWith(e, a));
+}
+
+TEST(MatchTest, Contains) {
+  shield_absl::string_view a("abcdefg");
+  shield_absl::string_view b("abcd");
+  shield_absl::string_view c("efg");
+  shield_absl::string_view d("gh");
+  EXPECT_TRUE(shield_absl::StrContains(a, a));
+  EXPECT_TRUE(shield_absl::StrContains(a, b));
+  EXPECT_TRUE(shield_absl::StrContains(a, c));
+  EXPECT_FALSE(shield_absl::StrContains(a, d));
+  EXPECT_TRUE(shield_absl::StrContains("", ""));
+  EXPECT_TRUE(shield_absl::StrContains("abc", ""));
+  EXPECT_FALSE(shield_absl::StrContains("", "a"));
+}
+
+TEST(MatchTest, ContainsChar) {
+  shield_absl::string_view a("abcdefg");
+  shield_absl::string_view b("abcd");
+  EXPECT_TRUE(shield_absl::StrContains(a, 'a'));
+  EXPECT_TRUE(shield_absl::StrContains(a, 'b'));
+  EXPECT_TRUE(shield_absl::StrContains(a, 'e'));
+  EXPECT_FALSE(shield_absl::StrContains(a, 'h'));
+
+  EXPECT_TRUE(shield_absl::StrContains(b, 'a'));
+  EXPECT_TRUE(shield_absl::StrContains(b, 'b'));
+  EXPECT_FALSE(shield_absl::StrContains(b, 'e'));
+  EXPECT_FALSE(shield_absl::StrContains(b, 'h'));
+
+  EXPECT_FALSE(shield_absl::StrContains("", 'a'));
+  EXPECT_FALSE(shield_absl::StrContains("", 'a'));
+}
+
+TEST(MatchTest, ContainsNull) {
+  const std::string s = "foo";
+  const char* cs = "foo";
+  const shield_absl::string_view sv("foo");
+  const shield_absl::string_view sv2("foo\0bar", 4);
+  EXPECT_EQ(s, "foo");
+  EXPECT_EQ(sv, "foo");
+  EXPECT_NE(sv2, "foo");
+  EXPECT_TRUE(shield_absl::EndsWith(s, sv));
+  EXPECT_TRUE(shield_absl::StartsWith(cs, sv));
+  EXPECT_TRUE(shield_absl::StrContains(cs, sv));
+  EXPECT_FALSE(shield_absl::StrContains(cs, sv2));
+}
+
+TEST(MatchTest, EqualsIgnoreCase) {
+  std::string text = "the";
+  shield_absl::string_view data(text);
+
+  EXPECT_TRUE(shield_absl::EqualsIgnoreCase(data, "The"));
+  EXPECT_TRUE(shield_absl::EqualsIgnoreCase(data, "THE"));
+  EXPECT_TRUE(shield_absl::EqualsIgnoreCase(data, "the"));
+  EXPECT_FALSE(shield_absl::EqualsIgnoreCase(data, "Quick"));
+  EXPECT_FALSE(shield_absl::EqualsIgnoreCase(data, "then"));
+}
+
+TEST(MatchTest, StartsWithIgnoreCase) {
+  EXPECT_TRUE(shield_absl::StartsWithIgnoreCase("foo", "foo"));
+  EXPECT_TRUE(shield_absl::StartsWithIgnoreCase("foo", "Fo"));
+  EXPECT_TRUE(shield_absl::StartsWithIgnoreCase("foo", ""));
+  EXPECT_FALSE(shield_absl::StartsWithIgnoreCase("foo", "fooo"));
+  EXPECT_FALSE(shield_absl::StartsWithIgnoreCase("", "fo"));
+}
+
+TEST(MatchTest, EndsWithIgnoreCase) {
+  EXPECT_TRUE(shield_absl::EndsWithIgnoreCase("foo", "foo"));
+  EXPECT_TRUE(shield_absl::EndsWithIgnoreCase("foo", "Oo"));
+  EXPECT_TRUE(shield_absl::EndsWithIgnoreCase("foo", ""));
+  EXPECT_FALSE(shield_absl::EndsWithIgnoreCase("foo", "fooo"));
+  EXPECT_FALSE(shield_absl::EndsWithIgnoreCase("", "fo"));
+}
+
+TEST(MatchTest, ContainsIgnoreCase) {
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("foo", "foo"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("FOO", "Foo"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("--FOO", "Foo"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("FOO--", "Foo"));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("BAR", "Foo"));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("BAR", "Foo"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("123456", "123456"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("123456", "234"));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("", ""));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase("abc", ""));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("", "a"));
+}
+
+TEST(MatchTest, ContainsCharIgnoreCase) {
+  shield_absl::string_view a("AaBCdefg!");
+  shield_absl::string_view b("AaBCd!");
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'a'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'A'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'b'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'B'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'e'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, 'E'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(a, 'h'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(a, 'H'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(a, '!'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(a, '?'));
+
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(b, 'a'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(b, 'A'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(b, 'b'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(b, 'B'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(b, 'e'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(b, 'E'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(b, 'h'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(b, 'H'));
+  EXPECT_TRUE(shield_absl::StrContainsIgnoreCase(b, '!'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase(b, '?'));
+
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("", 'a'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("", 'A'));
+  EXPECT_FALSE(shield_absl::StrContainsIgnoreCase("", '0'));
+}
+
+TEST(MatchTest, FindLongestCommonPrefix) {
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("", ""), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("", "abc"), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abc", ""), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("ab", "abc"), "ab");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abc", "ab"), "ab");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abc", "abd"), "ab");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abc", "abcd"), "abc");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abcd", "abcd"), "abcd");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix("abcd", "efgh"), "");
+
+  // "abcde" v. "abc" but in the middle of other data
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(
+                shield_absl::string_view("1234 abcdef").substr(5, 5),
+                shield_absl::string_view("5678 abcdef").substr(5, 3)),
+            "abc");
+}
+
+// Since the little-endian implementation involves a bit of if-else and various
+// return paths, the following tests aims to provide full test coverage of the
+// implementation.
+TEST(MatchTest, FindLongestCommonPrefixLoad16Mismatch) {
+  const std::string x1 = "abcdefgh";
+  const std::string x2 = "abcde_";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcde");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcde");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixLoad16MatchesNoLast) {
+  const std::string x1 = "abcdef";
+  const std::string x2 = "abcdef";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcdef");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcdef");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixLoad16MatchesLastCharMismatches) {
+  const std::string x1 = "abcdefg";
+  const std::string x2 = "abcdef_h";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcdef");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcdef");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixLoad16MatchesLastMatches) {
+  const std::string x1 = "abcde";
+  const std::string x2 = "abcdefgh";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcde");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcde");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixSize8Load64Mismatches) {
+  const std::string x1 = "abcdefghijk";
+  const std::string x2 = "abcde_g_";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcde");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcde");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixSize8Load64Matches) {
+  const std::string x1 = "abcdefgh";
+  const std::string x2 = "abcdefgh";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "abcdefgh");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "abcdefgh");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixSize15Load64Mismatches) {
+  const std::string x1 = "012345670123456";
+  const std::string x2 = "0123456701_34_6";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "0123456701");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "0123456701");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixSize15Load64Matches) {
+  const std::string x1 = "012345670123456";
+  const std::string x2 = "0123456701234567";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "012345670123456");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "012345670123456");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixSizeFirstByteOfLast8BytesMismatch) {
+  const std::string x1 = "012345670123456701234567";
+  const std::string x2 = "0123456701234567_1234567";
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), "0123456701234567");
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), "0123456701234567");
+}
+
+TEST(MatchTest, FindLongestCommonPrefixLargeLastCharMismatches) {
+  const std::string x1(300, 'x');
+  std::string x2 = x1;
+  x2.back() = '#';
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), std::string(299, 'x'));
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), std::string(299, 'x'));
+}
+
+TEST(MatchTest, FindLongestCommonPrefixLargeFullMatch) {
+  const std::string x1(300, 'x');
+  const std::string x2 = x1;
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x1, x2), std::string(300, 'x'));
+  EXPECT_EQ(shield_absl::FindLongestCommonPrefix(x2, x1), std::string(300, 'x'));
+}
+
+TEST(MatchTest, FindLongestCommonSuffix) {
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("", ""), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("", "abc"), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("abc", ""), "");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("bc", "abc"), "bc");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("abc", "bc"), "bc");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("abc", "dbc"), "bc");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("bcd", "abcd"), "bcd");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("abcd", "abcd"), "abcd");
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix("abcd", "efgh"), "");
+
+  // "abcde" v. "cde" but in the middle of other data
+  EXPECT_EQ(shield_absl::FindLongestCommonSuffix(
+                shield_absl::string_view("1234 abcdef").substr(5, 5),
+                shield_absl::string_view("5678 abcdef").substr(7, 3)),
+            "cde");
+}
