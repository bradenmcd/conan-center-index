+TEST(AnyTest, MakeAnyIList) {
+  const CopyOnly copy_only{};
+  auto o =
+      shield_absl::make_any<ListMoveOnlyCopyOnly>({1, 2, 3}, MoveOnly(), copy_only);
+  static_assert(std::is_same<decltype(o), shield_absl::any>::value, "");
+  ListMoveOnlyCopyOnly& v = shield_absl::any_cast<ListMoveOnlyCopyOnly&>(o);
