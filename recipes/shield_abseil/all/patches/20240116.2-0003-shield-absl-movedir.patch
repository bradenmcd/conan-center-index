+      {shield_absl::MakeInt128(0xd66f061af02d0408, 0x727d2846cb475b53)},
+      {shield_absl::MakeInt128(0x27b8d5ed6104452d, 0x03f8a33b0ee1df4f)},
+      {-shield_absl::MakeInt128(0x621b6626b9e8d042, 0x27311ac99df00938)},
+      {-shield_absl::MakeInt128(0x34e0656f1e95fb60, 0x4281cfd731257a47)},
+  };
+  for (shield_absl::int128 value : large_values) {
+    EXPECT_EQ(0, 0 * value);
+    EXPECT_EQ(0, value * 0);
+    EXPECT_EQ(0, shield_absl::int128(0) *= value);
+    EXPECT_EQ(0, value *= 0);
+
+    EXPECT_EQ(value, 1 * value);
+    EXPECT_EQ(value, value * 1);
+    EXPECT_EQ(value, shield_absl::int128(1) *= value);
+    EXPECT_EQ(value, value *= 1);
+
+    EXPECT_EQ(-value, -1 * value);
+    EXPECT_EQ(-value, value * -1);
+    EXPECT_EQ(-value, shield_absl::int128(-1) *= value);
+    EXPECT_EQ(-value, value *= -1);
+  }
+
+  // Manually calculated random large value cases
+  EXPECT_EQ(shield_absl::MakeInt128(0xcd0efd3442219bb, 0xde47c05bcd9df6e1),
+            shield_absl::MakeInt128(0x7c6448, 0x3bc4285c47a9d253) * 0x1a6037537b);
+  EXPECT_EQ(-shield_absl::MakeInt128(0x1f8f149850b1e5e6, 0x1e50d6b52d272c3e),
+            -shield_absl::MakeInt128(0x23, 0x2e68a513ca1b8859) * 0xe5a434cd14866e);
+  EXPECT_EQ(-shield_absl::MakeInt128(0x55cae732029d1fce, 0xca6474b6423263e4),
+            0xa9b98a8ddf66bc * -shield_absl::MakeInt128(0x81, 0x672e58231e2469d7));
+  EXPECT_EQ(shield_absl::MakeInt128(0x19c8b7620b507dc4, 0xfec042b71a5f29a4),
+            -0x3e39341147 * -shield_absl::MakeInt128(0x6a14b2, 0x5ed34cca42327b3c));
+
+  EXPECT_EQ(shield_absl::MakeInt128(0xcd0efd3442219bb, 0xde47c05bcd9df6e1),
+            shield_absl::MakeInt128(0x7c6448, 0x3bc4285c47a9d253) *= 0x1a6037537b);
+  EXPECT_EQ(-shield_absl::MakeInt128(0x1f8f149850b1e5e6, 0x1e50d6b52d272c3e),
+            -shield_absl::MakeInt128(0x23, 0x2e68a513ca1b8859) *= 0xe5a434cd14866e);
+  EXPECT_EQ(-shield_absl::MakeInt128(0x55cae732029d1fce, 0xca6474b6423263e4),
+            shield_absl::int128(0xa9b98a8ddf66bc) *=
+            -shield_absl::MakeInt128(0x81, 0x672e58231e2469d7));
+  EXPECT_EQ(shield_absl::MakeInt128(0x19c8b7620b507dc4, 0xfec042b71a5f29a4),
+            shield_absl::int128(-0x3e39341147) *=
+            -shield_absl::MakeInt128(0x6a14b2, 0x5ed34cca42327b3c));
+}
