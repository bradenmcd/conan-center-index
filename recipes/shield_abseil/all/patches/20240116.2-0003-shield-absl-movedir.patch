+TEST(Time, Infinity) {
+  constexpr shield_absl::Time ifuture = shield_absl::InfiniteFuture();
+  constexpr shield_absl::Time ipast = shield_absl::InfinitePast();
+
+  static_assert(ifuture == ifuture, "");
+  static_assert(ipast == ipast, "");
+  static_assert(ipast < ifuture, "");
+  static_assert(ifuture > ipast, "");
+
+  // Arithmetic saturates
+  EXPECT_EQ(ifuture, ifuture + shield_absl::Seconds(1));
+  EXPECT_EQ(ifuture, ifuture - shield_absl::Seconds(1));
+  EXPECT_EQ(ipast, ipast + shield_absl::Seconds(1));
+  EXPECT_EQ(ipast, ipast - shield_absl::Seconds(1));
+
+  EXPECT_EQ(shield_absl::InfiniteDuration(), ifuture - ifuture);
+  EXPECT_EQ(shield_absl::InfiniteDuration(), ifuture - ipast);
+  EXPECT_EQ(-shield_absl::InfiniteDuration(), ipast - ifuture);
+  EXPECT_EQ(-shield_absl::InfiniteDuration(), ipast - ipast);
+
+  constexpr shield_absl::Time t = shield_absl::UnixEpoch();  // Any finite time.
+  static_assert(t < ifuture, "");
+  static_assert(t > ipast, "");
+
+  EXPECT_EQ(ifuture, t + shield_absl::InfiniteDuration());
+  EXPECT_EQ(ipast, t - shield_absl::InfiniteDuration());
+}
