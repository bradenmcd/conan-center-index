+            shield_absl::ToUniversal(shield_absl::UniversalEpoch() + shield_absl::Nanoseconds(101)));
+  EXPECT_EQ(1,
+            shield_absl::ToUniversal(shield_absl::UniversalEpoch() + shield_absl::Nanoseconds(100)));
+  EXPECT_EQ(0,
+            shield_absl::ToUniversal(shield_absl::UniversalEpoch() + shield_absl::Nanoseconds(99)));
+  EXPECT_EQ(0,
+            shield_absl::ToUniversal(shield_absl::UniversalEpoch() + shield_absl::Nanoseconds(1)));
