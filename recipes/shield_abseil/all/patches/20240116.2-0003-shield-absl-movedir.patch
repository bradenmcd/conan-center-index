+TEST(Uint128, Multiply) {
+  shield_absl::uint128 a, b, c;
+
+  // Zero test.
+  a = 0;
+  b = 0;
+  c = a * b;
+  EXPECT_EQ(0, c);
+
+  // Max carries.
+  a = shield_absl::uint128(0) - 1;
+  b = shield_absl::uint128(0) - 1;
+  c = a * b;
+  EXPECT_EQ(1, c);
+
+  // Self-operation with max carries.
+  c = shield_absl::uint128(0) - 1;
+  c *= c;
+  EXPECT_EQ(1, c);
+
+  // 1-bit x 1-bit.
+  for (int i = 0; i < 64; ++i) {
+    for (int j = 0; j < 64; ++j) {
+      a = shield_absl::uint128(1) << i;
+      b = shield_absl::uint128(1) << j;
+      c = a * b;
+      EXPECT_EQ(shield_absl::uint128(1) << (i + j), c);
+    }
+  }
+
+  // Verified with dc.
+  a = shield_absl::MakeUint128(0xffffeeeeddddcccc, 0xbbbbaaaa99998888);
+  b = shield_absl::MakeUint128(0x7777666655554444, 0x3333222211110000);
+  c = a * b;
+  EXPECT_EQ(shield_absl::MakeUint128(0x530EDA741C71D4C3, 0xBF25975319080000), c);
+  EXPECT_EQ(0, c - b * a);
+  EXPECT_EQ(a*a - b*b, (a+b) * (a-b));
+
+  // Verified with dc.
+  a = shield_absl::MakeUint128(0x0123456789abcdef, 0xfedcba9876543210);
+  b = shield_absl::MakeUint128(0x02468ace13579bdf, 0xfdb97531eca86420);
+  c = a * b;
+  EXPECT_EQ(shield_absl::MakeUint128(0x97a87f4f261ba3f2, 0x342d0bbf48948200), c);
+  EXPECT_EQ(0, c - b * a);
+  EXPECT_EQ(a*a - b*b, (a+b) * (a-b));
+}
