+TEST(KernelTimeout, FiniteTimes) {
+  constexpr shield_absl::Duration kDurationsToTest[] = {
+    shield_absl::ZeroDuration(),
+    shield_absl::Nanoseconds(1),
+    shield_absl::Microseconds(1),
+    shield_absl::Milliseconds(1),
+    shield_absl::Seconds(1),
+    shield_absl::Minutes(1),
+    shield_absl::Hours(1),
+    shield_absl::Hours(1000),
+    -shield_absl::Nanoseconds(1),
+    -shield_absl::Microseconds(1),
+    -shield_absl::Milliseconds(1),
+    -shield_absl::Seconds(1),
+    -shield_absl::Minutes(1),
+    -shield_absl::Hours(1),
+    -shield_absl::Hours(1000),
+  };
+
+  for (auto duration : kDurationsToTest) {
+    const shield_absl::Time now = shield_absl::Now();
+    const shield_absl::Time when = now + duration;
+    SCOPED_TRACE(duration);
+    KernelTimeout t(when);
+    EXPECT_TRUE(t.has_timeout());
+    EXPECT_TRUE(t.is_absolute_timeout());
+    EXPECT_FALSE(t.is_relative_timeout());
+    EXPECT_EQ(shield_absl::TimeFromTimespec(t.MakeAbsTimespec()), when);
+#ifndef _WIN32
+    EXPECT_LE(
+        shield_absl::AbsDuration(shield_absl::Now() + duration -
+                          shield_absl::TimeFromTimespec(
+                              t.MakeClockAbsoluteTimespec(CLOCK_REALTIME))),
+        shield_absl::Milliseconds(10));
+#endif
+    EXPECT_LE(
+        shield_absl::AbsDuration(shield_absl::DurationFromTimespec(t.MakeRelativeTimespec()) -
+                          std::max(duration, shield_absl::ZeroDuration())),
+        kTimingBound);
+    EXPECT_EQ(shield_absl::FromUnixNanos(t.MakeAbsNanos()), when);
+    EXPECT_LE(shield_absl::AbsDuration(shield_absl::Milliseconds(t.InMillisecondsFromNow()) -
+                                std::max(duration, shield_absl::ZeroDuration())),
+              shield_absl::Milliseconds(5));
+    EXPECT_LE(shield_absl::AbsDuration(shield_absl::FromChrono(t.ToChronoTimePoint()) - when),
+              shield_absl::Microseconds(1));
+    EXPECT_LE(shield_absl::AbsDuration(shield_absl::FromChrono(t.ToChronoDuration()) -
+                                std::max(duration, shield_absl::ZeroDuration())),
+              kTimingBound);
+  }
+}
