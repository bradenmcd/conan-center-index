-class GlobalLogSinkSet final {
- public:
-  GlobalLogSinkSet() {
-#if defined(__myriad2__) || defined(__Fuchsia__)
-    // myriad2 and Fuchsia do not log to stderr by default.
-#else
-    static shield_absl::NoDestructor<StderrLogSink> stderr_log_sink;
-    AddLogSink(stderr_log_sink.get());
-#endif
-#ifdef __ANDROID__
-    static shield_absl::NoDestructor<AndroidLogSink> android_log_sink;
-    AddLogSink(android_log_sink.get());
-#endif
-#if defined(_WIN32)
-    static shield_absl::NoDestructor<WindowsDebuggerLogSink> debugger_log_sink;
-    AddLogSink(debugger_log_sink.get());
-#endif  // !defined(_WIN32)
-  }
-
-  void LogToSinks(const shield_absl::LogEntry& entry,
-                  shield_absl::Span<shield_absl::LogSink*> extra_sinks, bool extra_sinks_only)
-      ABSL_LOCKS_EXCLUDED(guard_) {
-    SendToSinks(entry, extra_sinks);
-
-    if (!extra_sinks_only) {
-      if (ThreadIsLoggingToLogSink()) {
-        shield_absl::log_internal::WriteToStderr(
-            entry.text_message_with_prefix_and_newline(), entry.log_severity());
-      } else {
-        shield_absl::ReaderMutexLock global_sinks_lock(&guard_);
-        ThreadIsLoggingStatus() = true;
-        // Ensure the "thread is logging" status is reverted upon leaving the
-        // scope even in case of exceptions.
-        auto status_cleanup =
-            shield_absl::MakeCleanup([] { ThreadIsLoggingStatus() = false; });
-        SendToSinks(entry, shield_absl::MakeSpan(sinks_));
-      }
-    }
-  }
-
-  void AddLogSink(shield_absl::LogSink* sink) ABSL_LOCKS_EXCLUDED(guard_) {
-    {
-      shield_absl::WriterMutexLock global_sinks_lock(&guard_);
-      auto pos = std::find(sinks_.begin(), sinks_.end(), sink);
-      if (pos == sinks_.end()) {
-        sinks_.push_back(sink);
-        return;
-      }
-    }
-    ABSL_INTERNAL_LOG(FATAL, "Duplicate log sinks are not supported");
-  }
-
-  void RemoveLogSink(shield_absl::LogSink* sink) ABSL_LOCKS_EXCLUDED(guard_) {
-    {
-      shield_absl::WriterMutexLock global_sinks_lock(&guard_);
-      auto pos = std::find(sinks_.begin(), sinks_.end(), sink);
-      if (pos != sinks_.end()) {
-        sinks_.erase(pos);
-        return;
-      }
-    }
-    ABSL_INTERNAL_LOG(FATAL, "Mismatched log sink being removed");
-  }
-
-  void FlushLogSinks() ABSL_LOCKS_EXCLUDED(guard_) {
-    if (ThreadIsLoggingToLogSink()) {
-      // The thread_local condition demonstrates that we're already holding the
-      // lock in order to iterate over `sinks_` for dispatch.  The thread-safety
-      // annotations don't know this, so we use `ABSL_NO_THREAD_SAFETY_ANALYSIS`
-      guard_.AssertReaderHeld();
-      FlushLogSinksLocked();
-    } else {
-      shield_absl::ReaderMutexLock global_sinks_lock(&guard_);
-      // In case if LogSink::Flush overload decides to log
-      ThreadIsLoggingStatus() = true;
-      // Ensure the "thread is logging" status is reverted upon leaving the
-      // scope even in case of exceptions.
-      auto status_cleanup =
-          shield_absl::MakeCleanup([] { ThreadIsLoggingStatus() = false; });
-      FlushLogSinksLocked();
-    }
-  }
-
- private:
-  void FlushLogSinksLocked() ABSL_SHARED_LOCKS_REQUIRED(guard_) {
-    for (shield_absl::LogSink* sink : sinks_) {
-      sink->Flush();
-    }
-  }
-
-  // Helper routine for LogToSinks.
-  static void SendToSinks(const shield_absl::LogEntry& entry,
-                          shield_absl::Span<shield_absl::LogSink*> sinks) {
-    for (shield_absl::LogSink* sink : sinks) {
-      sink->Send(entry);
-    }
