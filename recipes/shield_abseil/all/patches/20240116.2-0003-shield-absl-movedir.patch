+  const int log_line = __LINE__ + 1;
+  auto do_log = [] { LOG(INFO) << "hello world"; };
+  shield_absl::ScopedMockLog test_sink(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+  EXPECT_CALL(test_sink, Send(TextMessage(Not(HasSubstr("(stacktrace:")))));
+
+  test_sink.StartCapturingLogs();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at,
+                shield_absl::StrCat("some_other_file.cc:", log_line));
+  do_log();
+}
+
+TEST_F(LogFlagsTest, BacktraceAtWrongLine) {
+  shield_absl::SetMinLogLevel(shield_absl::LogSeverityAtLeast::kInfo);
+  const int log_line = __LINE__ + 1;
+  auto do_log = [] { LOG(INFO) << "hello world"; };
+  shield_absl::ScopedMockLog test_sink(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+  EXPECT_CALL(test_sink, Send(TextMessage(Not(HasSubstr("(stacktrace:")))));
+
+  test_sink.StartCapturingLogs();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at,
+                shield_absl::StrCat("flags_test.cc:", log_line + 1));
+  do_log();
+}
+
+TEST_F(LogFlagsTest, BacktraceAtWholeFilename) {
+  shield_absl::SetMinLogLevel(shield_absl::LogSeverityAtLeast::kInfo);
+  const int log_line = __LINE__ + 1;
+  auto do_log = [] { LOG(INFO) << "hello world"; };
+  shield_absl::ScopedMockLog test_sink(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+  EXPECT_CALL(test_sink, Send(TextMessage(Not(HasSubstr("(stacktrace:")))));
+
+  test_sink.StartCapturingLogs();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at, shield_absl::StrCat(__FILE__, ":", log_line));
+  do_log();
+}
+
+TEST_F(LogFlagsTest, BacktraceAtNonmatchingSuffix) {
+  shield_absl::SetMinLogLevel(shield_absl::LogSeverityAtLeast::kInfo);
+  const int log_line = __LINE__ + 1;
+  auto do_log = [] { LOG(INFO) << "hello world"; };
+  shield_absl::ScopedMockLog test_sink(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+  EXPECT_CALL(test_sink, Send(TextMessage(Not(HasSubstr("(stacktrace:")))));
+
+  test_sink.StartCapturingLogs();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at,
+                shield_absl::StrCat("flags_test.cc:", log_line, "gibberish"));
+  do_log();
+}
+
+TEST_F(LogFlagsTest, LogsBacktrace) {
+  shield_absl::SetMinLogLevel(shield_absl::LogSeverityAtLeast::kInfo);
+  const int log_line = __LINE__ + 1;
+  auto do_log = [] { LOG(INFO) << "hello world"; };
+  shield_absl::ScopedMockLog test_sink(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+  testing::InSequence seq;
+  EXPECT_CALL(test_sink, Send(TextMessage(HasSubstr("(stacktrace:"))));
+  EXPECT_CALL(test_sink, Send(TextMessage(Not(HasSubstr("(stacktrace:")))));
+
+  test_sink.StartCapturingLogs();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at,
+                shield_absl::StrCat("flags_test.cc:", log_line));
+  do_log();
+  shield_absl::SetFlag(&FLAGS_log_backtrace_at, "");
+  do_log();
+}
+
+}  // namespace
