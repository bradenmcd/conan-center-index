+  EXPECT_EQ(shield_absl::StrCat(w, "B"), "255B");
+  EXPECT_EQ(shield_absl::Substitute("$0B", w), "255B");
+  // EXPECT_EQ(shield_absl::StrFormat("%vB", v), "255B");
+}
+
+TEST(CharFormatting, SignedChar) {
+  const signed char v = 'A';
+
+  // Desired behavior: format as decimal:
+  EXPECT_EQ(shield_absl::StrCat(v, "B"), "65B");
