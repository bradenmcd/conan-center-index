-  int running = 3;
-  tp->Schedule(std::bind(&ReaderForReaderOnCondVar, &mu, &cv, &running));
-  tp->Schedule(std::bind(&ReaderForReaderOnCondVar, &mu, &cv, &running));
-  shield_absl::SleepFor(shield_absl::Seconds(2));
-  mu.Lock();
-  running--;
-  mu.Await(shield_absl::Condition(&IntIsZero, &running));
-  mu.Unlock();
-}
