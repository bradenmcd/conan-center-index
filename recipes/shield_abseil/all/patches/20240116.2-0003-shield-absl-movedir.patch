+template <std::size_t... Is>
+struct ContainsVariantNPos
+    : shield_absl::negation<std::is_same<  // NOLINT
+          std::integer_sequence<bool, 0 <= Is...>,
+          std::integer_sequence<bool, Is != shield_absl::variant_npos...>>> {};
