+
+  constexpr auto absl_hours = shield_absl::Hours(N);
+  auto chrono_hours = hours(N);
+  if (absl_hours == -shield_absl::InfiniteDuration()) {
+    chrono_hours = hours::min();
+  } else if (absl_hours == shield_absl::InfiniteDuration()) {
+    chrono_hours = hours::max();
+  }
+  EXPECT_EQ(chrono_hours, shield_absl::ToChronoHours(absl_hours));
