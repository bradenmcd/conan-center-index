-template <typename Delimiter>
-static bool IsFoundAtStartingPos(shield_absl::string_view text, Delimiter d,
-                                 size_t starting_pos, int expected_pos) {
-  shield_absl::string_view found = d.Find(text, starting_pos);
-  return found.data() != text.data() + text.size() &&
-         expected_pos == found.data() - text.data();
-}
