+// limitations under the License.
+
+#include <cstddef>
+#include <cstdint>
+#include <random>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "shield_absl/random/distributions.h"
+#include "shield_absl/random/random.h"
+
+namespace {
+
+template <typename URBG>
+void TestUniform(URBG* gen) {
+  // [a, b) default-semantics, inferred types.
+  shield_absl::Uniform(*gen, 0, 100);     // int
+  shield_absl::Uniform(*gen, 0, 1.0);     // Promoted to double
+  shield_absl::Uniform(*gen, 0.0f, 1.0);  // Promoted to double
+  shield_absl::Uniform(*gen, 0.0, 1.0);   // double
+  shield_absl::Uniform(*gen, -1, 1L);     // Promoted to long
+
+  // Roll a die.
+  shield_absl::Uniform(shield_absl::IntervalClosedClosed, *gen, 1, 6);
+
+  // Get a fraction.
+  shield_absl::Uniform(shield_absl::IntervalOpenOpen, *gen, 0.0, 1.0);
+
+  // Assign a value to a random element.
+  std::vector<int> elems = {10, 20, 30, 40, 50};
+  elems[shield_absl::Uniform(*gen, 0u, elems.size())] = 5;
+  elems[shield_absl::Uniform<size_t>(*gen, 0, elems.size())] = 3;
+
+  // Choose some epsilon around zero.
+  shield_absl::Uniform(shield_absl::IntervalOpenOpen, *gen, -1.0, 1.0);
+
+  // (a, b) semantics, inferred types.
+  shield_absl::Uniform(shield_absl::IntervalOpenOpen, *gen, 0, 1.0);  // Promoted to double
+
+  // Explicit overriding of types.
+  shield_absl::Uniform<int>(*gen, 0, 100);
+  shield_absl::Uniform<int8_t>(*gen, 0, 100);
+  shield_absl::Uniform<int16_t>(*gen, 0, 100);
+  shield_absl::Uniform<uint16_t>(*gen, 0, 100);
+  shield_absl::Uniform<int32_t>(*gen, 0, 1 << 10);
+  shield_absl::Uniform<uint32_t>(*gen, 0, 1 << 10);
+  shield_absl::Uniform<int64_t>(*gen, 0, 1 << 10);
+  shield_absl::Uniform<uint64_t>(*gen, 0, 1 << 10);
+
+  shield_absl::Uniform<float>(*gen, 0.0, 1.0);
+  shield_absl::Uniform<float>(*gen, 0, 1);
+  shield_absl::Uniform<float>(*gen, -1, 1);
+  shield_absl::Uniform<double>(*gen, 0.0, 1.0);
+
+  shield_absl::Uniform<float>(*gen, -1.0, 0);
+  shield_absl::Uniform<double>(*gen, -1.0, 0);
+
+  // Tagged
+  shield_absl::Uniform<double>(shield_absl::IntervalClosedClosed, *gen, 0, 1);
+  shield_absl::Uniform<double>(shield_absl::IntervalClosedOpen, *gen, 0, 1);
+  shield_absl::Uniform<double>(shield_absl::IntervalOpenOpen, *gen, 0, 1);
+  shield_absl::Uniform<double>(shield_absl::IntervalOpenClosed, *gen, 0, 1);
+  shield_absl::Uniform<double>(shield_absl::IntervalClosedClosed, *gen, 0, 1);
+  shield_absl::Uniform<double>(shield_absl::IntervalOpenOpen, *gen, 0, 1);
+
+  shield_absl::Uniform<int>(shield_absl::IntervalClosedClosed, *gen, 0, 100);
+  shield_absl::Uniform<int>(shield_absl::IntervalClosedOpen, *gen, 0, 100);
+  shield_absl::Uniform<int>(shield_absl::IntervalOpenOpen, *gen, 0, 100);
+  shield_absl::Uniform<int>(shield_absl::IntervalOpenClosed, *gen, 0, 100);
+  shield_absl::Uniform<int>(shield_absl::IntervalClosedClosed, *gen, 0, 100);
+  shield_absl::Uniform<int>(shield_absl::IntervalOpenOpen, *gen, 0, 100);
+
+  // With *generator as an R-value reference.
+  shield_absl::Uniform<int>(URBG(), 0, 100);
+  shield_absl::Uniform<double>(URBG(), 0.0, 1.0);
+}
+
+template <typename URBG>
+void TestExponential(URBG* gen) {
+  shield_absl::Exponential<float>(*gen);
+  shield_absl::Exponential<double>(*gen);
+  shield_absl::Exponential<double>(URBG());
+}
+
+template <typename URBG>
+void TestPoisson(URBG* gen) {
+  // [rand.dist.pois] Indicates that the std::poisson_distribution
+  // is parameterized by IntType, however MSVC does not allow 8-bit
+  // types.
+  shield_absl::Poisson<int>(*gen);
+  shield_absl::Poisson<int16_t>(*gen);
+  shield_absl::Poisson<uint16_t>(*gen);
+  shield_absl::Poisson<int32_t>(*gen);
+  shield_absl::Poisson<uint32_t>(*gen);
+  shield_absl::Poisson<int64_t>(*gen);
+  shield_absl::Poisson<uint64_t>(*gen);
+  shield_absl::Poisson<uint64_t>(URBG());
+  shield_absl::Poisson<shield_absl::int128>(*gen);
+  shield_absl::Poisson<shield_absl::uint128>(*gen);
+}
+
+template <typename URBG>
+void TestBernoulli(URBG* gen) {
+  shield_absl::Bernoulli(*gen, 0.5);
+  shield_absl::Bernoulli(*gen, 0.5);
+}
+
+
+template <typename URBG>
+void TestZipf(URBG* gen) {
+  shield_absl::Zipf<int>(*gen, 100);
+  shield_absl::Zipf<int8_t>(*gen, 100);
+  shield_absl::Zipf<int16_t>(*gen, 100);
+  shield_absl::Zipf<uint16_t>(*gen, 100);
+  shield_absl::Zipf<int32_t>(*gen, 1 << 10);
+  shield_absl::Zipf<uint32_t>(*gen, 1 << 10);
+  shield_absl::Zipf<int64_t>(*gen, 1 << 10);
+  shield_absl::Zipf<uint64_t>(*gen, 1 << 10);
+  shield_absl::Zipf<uint64_t>(URBG(), 1 << 10);
+  shield_absl::Zipf<shield_absl::int128>(*gen, 1 << 10);
+  shield_absl::Zipf<shield_absl::uint128>(*gen, 1 << 10);
+}
+
+template <typename URBG>
+void TestGaussian(URBG* gen) {
+  shield_absl::Gaussian<float>(*gen, 1.0, 1.0);
+  shield_absl::Gaussian<double>(*gen, 1.0, 1.0);
+  shield_absl::Gaussian<double>(URBG(), 1.0, 1.0);
+}
+
+template <typename URBG>
+void TestLogNormal(URBG* gen) {
+  shield_absl::LogUniform<int>(*gen, 0, 100);
+  shield_absl::LogUniform<int8_t>(*gen, 0, 100);
+  shield_absl::LogUniform<int16_t>(*gen, 0, 100);
+  shield_absl::LogUniform<uint16_t>(*gen, 0, 100);
+  shield_absl::LogUniform<int32_t>(*gen, 0, 1 << 10);
+  shield_absl::LogUniform<uint32_t>(*gen, 0, 1 << 10);
+  shield_absl::LogUniform<int64_t>(*gen, 0, 1 << 10);
+  shield_absl::LogUniform<uint64_t>(*gen, 0, 1 << 10);
+  shield_absl::LogUniform<uint64_t>(URBG(), 0, 1 << 10);
+  shield_absl::LogUniform<shield_absl::int128>(*gen, 0, 1 << 10);
+  shield_absl::LogUniform<shield_absl::uint128>(*gen, 0, 1 << 10);
+}
+
+template <typename URBG>
+void CompatibilityTest() {
+  URBG gen;
+
+  TestUniform(&gen);
+  TestExponential(&gen);
+  TestPoisson(&gen);
+  TestBernoulli(&gen);
+  TestZipf(&gen);
+  TestGaussian(&gen);
+  TestLogNormal(&gen);
+}
+
+TEST(std_mt19937_64, Compatibility) {
+  // Validate with std::mt19937_64
+  CompatibilityTest<std::mt19937_64>();
+}
+
+TEST(BitGen, Compatibility) {
+  // Validate with shield_absl::BitGen
+  CompatibilityTest<shield_absl::BitGen>();
+}
+
+TEST(InsecureBitGen, Compatibility) {
+  // Validate with shield_absl::InsecureBitGen
+  CompatibilityTest<shield_absl::InsecureBitGen>();
+}
+
+}  // namespace
