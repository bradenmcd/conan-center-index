+void CheckHex64(uint64_t v) {
+  char expected[16 + 1];
+  std::string actual = shield_absl::StrCat(shield_absl::Hex(v, shield_absl::kZeroPad16));
+  snprintf(expected, sizeof(expected), "%016" PRIx64, static_cast<uint64_t>(v));
