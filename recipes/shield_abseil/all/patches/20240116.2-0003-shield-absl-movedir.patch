+TEST(CordRepFlat, AllFlatCapacities) {
+  // Explicitly and redundantly assert built-in min/max limits
+  static_assert(shield_absl::cord_internal::kFlatOverhead < 32, "");
+  static_assert(shield_absl::cord_internal::kMinFlatSize == 32, "");
+  static_assert(shield_absl::cord_internal::kMaxLargeFlatSize == 256 << 10, "");
+  EXPECT_EQ(shield_absl::cord_internal::TagToAllocatedSize(FLAT), 32);
+  EXPECT_EQ(shield_absl::cord_internal::TagToAllocatedSize(MAX_FLAT_TAG), 256 << 10);
+
+  // Verify all tags to map perfectly back and forth, and
+  // that sizes are monotonically increasing.
+  size_t last_size = 0;
+  for (int tag = FLAT; tag <= MAX_FLAT_TAG; ++tag) {
+    size_t size = shield_absl::cord_internal::TagToAllocatedSize(tag);
+    ASSERT_GT(size, last_size);
+    ASSERT_EQ(shield_absl::cord_internal::TagToAllocatedSize(tag), size);
+    last_size = size;
+  }
+
+  // All flat size from 32 - 512 are 8 byte granularity
+  for (size_t size = 32; size <= 512; size += 8) {
+    ASSERT_EQ(shield_absl::cord_internal::RoundUpForTag(size), size);
+    uint8_t tag = shield_absl::cord_internal::AllocatedSizeToTag(size);
+    ASSERT_EQ(shield_absl::cord_internal::TagToAllocatedSize(tag), size);
+  }
+
+  // All flat sizes from 512 - 8192 are 64 byte granularity
+  for (size_t size = 512; size <= 8192; size += 64) {
+    ASSERT_EQ(shield_absl::cord_internal::RoundUpForTag(size), size);
+    uint8_t tag = shield_absl::cord_internal::AllocatedSizeToTag(size);
+    ASSERT_EQ(shield_absl::cord_internal::TagToAllocatedSize(tag), size);
+  }
+
+  // All flat sizes from 8KB to 256KB are 4KB granularity
+  for (size_t size = 8192; size <= 256 * 1024; size += 4 * 1024) {
+    ASSERT_EQ(shield_absl::cord_internal::RoundUpForTag(size), size);
+    uint8_t tag = shield_absl::cord_internal::AllocatedSizeToTag(size);
+    ASSERT_EQ(shield_absl::cord_internal::TagToAllocatedSize(tag), size);
+  }
+}
