+  EXPECT_EQ(a.find(c, shield_absl::string_view::npos), shield_absl::string_view::npos);
+  EXPECT_EQ(b.find(c), shield_absl::string_view::npos);
+  EXPECT_EQ(b.find(c, shield_absl::string_view::npos), shield_absl::string_view::npos);
+  EXPECT_EQ(a.find(d), 0u);
+  EXPECT_EQ(a.find(e), 0u);
