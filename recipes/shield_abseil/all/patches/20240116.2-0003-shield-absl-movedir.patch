-void FlagHelpHumanReadable(const CommandLineFlag& flag, std::ostream& out) {
-  FlagHelpPrettyPrinter printer(kHrfMaxLineLength, 4, 2, out);
-
-  // Flag name.
-  printer.Write(shield_absl::StrCat("--", flag.Name()));
-
-  // Flag help.
-  printer.Write(shield_absl::StrCat("(", flag.Help(), ");"), /*wrap_line=*/true);
-
-  // The listed default value will be the actual default from the flag
-  // definition in the originating source file, unless the value has
-  // subsequently been modified using SetCommandLineOption() with mode
-  // SET_FLAGS_DEFAULT.
-  std::string dflt_val = flag.DefaultValue();
-  std::string curr_val = flag.CurrentValue();
-  bool is_modified = curr_val != dflt_val;
-
-  if (flag.IsOfType<std::string>()) {
-    dflt_val = shield_absl::StrCat("\"", dflt_val, "\"");
-  }
-  printer.Write(shield_absl::StrCat("default: ", dflt_val, ";"));
-
-  if (is_modified) {
-    if (flag.IsOfType<std::string>()) {
-      curr_val = shield_absl::StrCat("\"", curr_val, "\"");
-    }
-    printer.Write(shield_absl::StrCat("currently: ", curr_val, ";"));
-  }
-
-  printer.EndLine();
-}
