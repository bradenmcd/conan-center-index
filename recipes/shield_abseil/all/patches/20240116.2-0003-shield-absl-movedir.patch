+TEST(Time, Breakdown) {
+  shield_absl::TimeZone tz = shield_absl::time_internal::LoadTimeZone("America/New_York");
+  shield_absl::Time t = shield_absl::UnixEpoch();
+
+  // The Unix epoch as seen in NYC.
+  auto ci = tz.At(t);
+  EXPECT_CIVIL_INFO(ci, 1969, 12, 31, 19, 0, 0, -18000, false);
+  EXPECT_EQ(shield_absl::ZeroDuration(), ci.subsecond);
+  EXPECT_EQ(shield_absl::Weekday::wednesday, shield_absl::GetWeekday(ci.cs));
+
+  // Just before the epoch.
+  t -= shield_absl::Nanoseconds(1);
+  ci = tz.At(t);
+  EXPECT_CIVIL_INFO(ci, 1969, 12, 31, 18, 59, 59, -18000, false);
+  EXPECT_EQ(shield_absl::Nanoseconds(999999999), ci.subsecond);
+  EXPECT_EQ(shield_absl::Weekday::wednesday, shield_absl::GetWeekday(ci.cs));
+
+  // Some time later.
+  t += shield_absl::Hours(24) * 2735;
+  t += shield_absl::Hours(18) + shield_absl::Minutes(30) + shield_absl::Seconds(15) +
+       shield_absl::Nanoseconds(9);
+  ci = tz.At(t);
+  EXPECT_CIVIL_INFO(ci, 1977, 6, 28, 14, 30, 15, -14400, true);
+  EXPECT_EQ(8, ci.subsecond / shield_absl::Nanoseconds(1));
+  EXPECT_EQ(shield_absl::Weekday::tuesday, shield_absl::GetWeekday(ci.cs));
+}
