-// Given N variant sizes, determine the number of cases there would need to be
-// in a single switch-statement that would cover every possibility in the
-// corresponding N-ary visit operation.
-template <std::size_t... NumAlternatives>
-struct NumCasesOfSwitch;
-
-template <std::size_t HeadNumAlternatives, std::size_t... TailNumAlternatives>
-struct NumCasesOfSwitch<HeadNumAlternatives, TailNumAlternatives...> {
-  static constexpr std::size_t value =
-      (HeadNumAlternatives + 1) *
-      NumCasesOfSwitch<TailNumAlternatives...>::value;
-};
-
-template <>
-struct NumCasesOfSwitch<> {
-  static constexpr std::size_t value = 1;
-};
-
-// A switch statement optimizes better than the table of function pointers.
-template <std::size_t EndIndex>
-struct VisitIndicesSwitch {
-  static_assert(EndIndex <= MaxUnrolledVisitCases,
-                "Maximum unrolled switch size exceeded.");
-
-  template <class Op>
-  static VisitIndicesResultT<Op, std::size_t> Run(Op&& op, std::size_t i) {
-    switch (i) {
-      case 0:
-        return PickCase<Op, 0, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 1:
-        return PickCase<Op, 1, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 2:
-        return PickCase<Op, 2, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 3:
-        return PickCase<Op, 3, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 4:
-        return PickCase<Op, 4, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 5:
-        return PickCase<Op, 5, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 6:
-        return PickCase<Op, 6, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 7:
-        return PickCase<Op, 7, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 8:
-        return PickCase<Op, 8, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 9:
-        return PickCase<Op, 9, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 10:
-        return PickCase<Op, 10, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 11:
-        return PickCase<Op, 11, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 12:
-        return PickCase<Op, 12, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 13:
-        return PickCase<Op, 13, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 14:
-        return PickCase<Op, 14, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 15:
-        return PickCase<Op, 15, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 16:
-        return PickCase<Op, 16, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 17:
-        return PickCase<Op, 17, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 18:
-        return PickCase<Op, 18, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 19:
-        return PickCase<Op, 19, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 20:
-        return PickCase<Op, 20, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 21:
-        return PickCase<Op, 21, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 22:
-        return PickCase<Op, 22, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 23:
-        return PickCase<Op, 23, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 24:
-        return PickCase<Op, 24, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 25:
-        return PickCase<Op, 25, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 26:
-        return PickCase<Op, 26, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 27:
-        return PickCase<Op, 27, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 28:
-        return PickCase<Op, 28, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 29:
-        return PickCase<Op, 29, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 30:
-        return PickCase<Op, 30, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 31:
-        return PickCase<Op, 31, EndIndex>::Run(shield_absl::forward<Op>(op));
-      case 32:
-        return PickCase<Op, 32, EndIndex>::Run(shield_absl::forward<Op>(op));
-      default:
-        ABSL_ASSERT(i == variant_npos);
-        return shield_absl::base_internal::invoke(shield_absl::forward<Op>(op), NPos());
-    }
-  }
-};
