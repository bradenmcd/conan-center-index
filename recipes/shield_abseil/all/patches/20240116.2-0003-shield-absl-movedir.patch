+TEST(Int128Uint128, ConversionTest) {
+  shield_absl::int128 nonnegative_signed_values[] = {
+      0,
+      1,
+      0xffeeddccbbaa9988,
+      shield_absl::MakeInt128(0x7766554433221100, 0),
+      shield_absl::MakeInt128(0x1234567890abcdef, 0xfedcba0987654321),
+      shield_absl::Int128Max()};
+  for (shield_absl::int128 value : nonnegative_signed_values) {
+    EXPECT_EQ(value, shield_absl::int128(shield_absl::uint128(value)));
+
+    shield_absl::uint128 assigned_value;
+    assigned_value = value;
+    EXPECT_EQ(value, shield_absl::int128(assigned_value));
