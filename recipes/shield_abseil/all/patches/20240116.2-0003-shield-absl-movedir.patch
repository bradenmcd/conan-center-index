+// TimeConversion
+//
+// An `shield_absl::TimeConversion` represents the conversion of year, month, day,
+// hour, minute, and second values (i.e., a civil time), in a particular
+// `shield_absl::TimeZone`, to a time instant (an absolute time), as returned by
+// `shield_absl::ConvertDateTime()`. Legacy version of `shield_absl::TimeZone::TimeInfo`.
+//
+// Deprecated. Use `shield_absl::TimeZone::TimeInfo`.
+struct ABSL_DEPRECATED("Use `shield_absl::TimeZone::TimeInfo`.") TimeConversion {
+  Time pre;    // time calculated using the pre-transition offset
+  Time trans;  // when the civil-time discontinuity occurred
+  Time post;   // time calculated using the post-transition offset
+
+  enum Kind {
+    UNIQUE,    // the civil time was singular (pre == trans == post)
+    SKIPPED,   // the civil time did not exist
+    REPEATED,  // the civil time was ambiguous
+  };
+  Kind kind;
+
+  bool normalized;  // input values were outside their valid ranges
+};
