-TEST(NumbersTest, Atod) {
-  // DBL_TRUE_MIN and FLT_TRUE_MIN were not mandated in <cfloat> before C++17.
-#if !defined(DBL_TRUE_MIN)
-  static constexpr double DBL_TRUE_MIN =
-      4.940656458412465441765687928682213723650598026143247644255856825e-324;
-#endif
-#if !defined(FLT_TRUE_MIN)
-  static constexpr float FLT_TRUE_MIN =
-      1.401298464324817070923729583289916131280261941876515771757068284e-45f;
-#endif
-
-  double d;
-  float f;
-
-  // NaN can be spelled in multiple ways.
-  EXPECT_TRUE(shield_absl::SimpleAtod("NaN", &d));
-  EXPECT_TRUE(std::isnan(d));
-  EXPECT_TRUE(shield_absl::SimpleAtod("nAN", &d));
-  EXPECT_TRUE(std::isnan(d));
-  EXPECT_TRUE(shield_absl::SimpleAtod("-nan", &d));
-  EXPECT_TRUE(std::isnan(d));
-
-  // Likewise for Infinity.
-  EXPECT_TRUE(shield_absl::SimpleAtod("inf", &d));
-  EXPECT_TRUE(std::isinf(d) && (d > 0));
-  EXPECT_TRUE(shield_absl::SimpleAtod("+Infinity", &d));
-  EXPECT_TRUE(std::isinf(d) && (d > 0));
-  EXPECT_TRUE(shield_absl::SimpleAtod("-INF", &d));
-  EXPECT_TRUE(std::isinf(d) && (d < 0));
-
-  // Parse DBL_MAX. Parsing something more than twice as big should also
-  // produce infinity.
-  EXPECT_TRUE(shield_absl::SimpleAtod("1.7976931348623157e+308", &d));
-  EXPECT_EQ(d, 1.7976931348623157e+308);
-  EXPECT_TRUE(shield_absl::SimpleAtod("5e308", &d));
-  EXPECT_TRUE(std::isinf(d) && (d > 0));
-  // Ditto, but for FLT_MAX.
-  EXPECT_TRUE(shield_absl::SimpleAtof("3.4028234663852886e+38", &f));
-  EXPECT_EQ(f, 3.4028234663852886e+38f);
-  EXPECT_TRUE(shield_absl::SimpleAtof("7e38", &f));
-  EXPECT_TRUE(std::isinf(f) && (f > 0));
-
-  // Parse the largest N such that parsing 1eN produces a finite value and the
-  // smallest M = N + 1 such that parsing 1eM produces infinity.
-  //
-  // The 309 exponent (and 39) confirms the "definition of
-  // kEiselLemireMaxExclExp10" comment in charconv.cc.
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e308", &d));
-  EXPECT_EQ(d, 1e308);
-  EXPECT_FALSE(std::isinf(d));
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e309", &d));
-  EXPECT_TRUE(std::isinf(d));
-  // Ditto, but for Atof instead of Atod.
-  EXPECT_TRUE(shield_absl::SimpleAtof("1e38", &f));
-  EXPECT_EQ(f, 1e38f);
-  EXPECT_FALSE(std::isinf(f));
-  EXPECT_TRUE(shield_absl::SimpleAtof("1e39", &f));
-  EXPECT_TRUE(std::isinf(f));
-
-  // Parse the largest N such that parsing 9.999999999999999999eN, with 19
-  // nines, produces a finite value.
-  //
-  // 9999999999999999999, with 19 nines but no decimal point, is the largest
-  // "repeated nines" integer that fits in a uint64_t.
-  EXPECT_TRUE(shield_absl::SimpleAtod("9.999999999999999999e307", &d));
-  EXPECT_EQ(d, 9.999999999999999999e307);
-  EXPECT_FALSE(std::isinf(d));
-  EXPECT_TRUE(shield_absl::SimpleAtod("9.999999999999999999e308", &d));
-  EXPECT_TRUE(std::isinf(d));
-  // Ditto, but for Atof instead of Atod.
-  EXPECT_TRUE(shield_absl::SimpleAtof("9.999999999999999999e37", &f));
-  EXPECT_EQ(f, 9.999999999999999999e37f);
-  EXPECT_FALSE(std::isinf(f));
-  EXPECT_TRUE(shield_absl::SimpleAtof("9.999999999999999999e38", &f));
-  EXPECT_TRUE(std::isinf(f));
-
-  // Parse DBL_MIN (normal), DBL_TRUE_MIN (subnormal) and (DBL_TRUE_MIN / 10)
-  // (effectively zero).
-  EXPECT_TRUE(shield_absl::SimpleAtod("2.2250738585072014e-308", &d));
-  EXPECT_EQ(d, 2.2250738585072014e-308);
-  EXPECT_TRUE(shield_absl::SimpleAtod("4.9406564584124654e-324", &d));
-  EXPECT_EQ(d, 4.9406564584124654e-324);
-  EXPECT_TRUE(shield_absl::SimpleAtod("4.9406564584124654e-325", &d));
-  EXPECT_EQ(d, 0);
-  // Ditto, but for FLT_MIN, FLT_TRUE_MIN and (FLT_TRUE_MIN / 10).
-  EXPECT_TRUE(shield_absl::SimpleAtof("1.1754943508222875e-38", &f));
-  EXPECT_EQ(f, 1.1754943508222875e-38f);
-  EXPECT_TRUE(shield_absl::SimpleAtof("1.4012984643248171e-45", &f));
-  EXPECT_EQ(f, 1.4012984643248171e-45f);
-  EXPECT_TRUE(shield_absl::SimpleAtof("1.4012984643248171e-46", &f));
-  EXPECT_EQ(f, 0);
-
-  // Parse the largest N (the most negative -N) such that parsing 1e-N produces
-  // a normal or subnormal (but still positive) or zero value.
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e-307", &d));
-  EXPECT_EQ(d, 1e-307);
-  EXPECT_GE(d, DBL_MIN);
-  EXPECT_LT(d, DBL_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e-323", &d));
-  EXPECT_EQ(d, 1e-323);
-  EXPECT_GE(d, DBL_TRUE_MIN);
-  EXPECT_LT(d, DBL_TRUE_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e-324", &d));
-  EXPECT_EQ(d, 0);
-  // Ditto, but for Atof instead of Atod.
-  EXPECT_TRUE(shield_absl::SimpleAtof("1e-37", &f));
-  EXPECT_EQ(f, 1e-37f);
-  EXPECT_GE(f, FLT_MIN);
-  EXPECT_LT(f, FLT_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtof("1e-45", &f));
-  EXPECT_EQ(f, 1e-45f);
-  EXPECT_GE(f, FLT_TRUE_MIN);
-  EXPECT_LT(f, FLT_TRUE_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtof("1e-46", &f));
-  EXPECT_EQ(f, 0);
-
-  // Parse the largest N (the most negative -N) such that parsing
-  // 9.999999999999999999e-N, with 19 nines, produces a normal or subnormal
-  // (but still positive) or zero value.
-  //
-  // 9999999999999999999, with 19 nines but no decimal point, is the largest
-  // "repeated nines" integer that fits in a uint64_t.
-  //
-  // The -324/-325 exponents (and -46/-47) confirms the "definition of
-  // kEiselLemireMinInclExp10" comment in charconv.cc.
-  EXPECT_TRUE(shield_absl::SimpleAtod("9.999999999999999999e-308", &d));
-  EXPECT_EQ(d, 9.999999999999999999e-308);
-  EXPECT_GE(d, DBL_MIN);
-  EXPECT_LT(d, DBL_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtod("9.999999999999999999e-324", &d));
-  EXPECT_EQ(d, 9.999999999999999999e-324);
-  EXPECT_GE(d, DBL_TRUE_MIN);
-  EXPECT_LT(d, DBL_TRUE_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtod("9.999999999999999999e-325", &d));
-  EXPECT_EQ(d, 0);
-  // Ditto, but for Atof instead of Atod.
-  EXPECT_TRUE(shield_absl::SimpleAtof("9.999999999999999999e-38", &f));
-  EXPECT_EQ(f, 9.999999999999999999e-38f);
-  EXPECT_GE(f, FLT_MIN);
-  EXPECT_LT(f, FLT_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtof("9.999999999999999999e-46", &f));
-  EXPECT_EQ(f, 9.999999999999999999e-46f);
-  EXPECT_GE(f, FLT_TRUE_MIN);
-  EXPECT_LT(f, FLT_TRUE_MIN * 10);
-  EXPECT_TRUE(shield_absl::SimpleAtof("9.999999999999999999e-47", &f));
-  EXPECT_EQ(f, 0);
-
-  // Leading and/or trailing whitespace is OK.
-  EXPECT_TRUE(shield_absl::SimpleAtod("  \t\r\n  2.718", &d));
-  EXPECT_EQ(d, 2.718);
-  EXPECT_TRUE(shield_absl::SimpleAtod("  3.141  ", &d));
-  EXPECT_EQ(d, 3.141);
-
-  // Leading or trailing not-whitespace is not OK.
-  EXPECT_FALSE(shield_absl::SimpleAtod("n 0", &d));
-  EXPECT_FALSE(shield_absl::SimpleAtod("0n ", &d));
-
-  // Multiple leading 0s are OK.
-  EXPECT_TRUE(shield_absl::SimpleAtod("000123", &d));
-  EXPECT_EQ(d, 123);
-  EXPECT_TRUE(shield_absl::SimpleAtod("000.456", &d));
-  EXPECT_EQ(d, 0.456);
-
-  // An absent leading 0 (for a fraction < 1) is OK.
-  EXPECT_TRUE(shield_absl::SimpleAtod(".5", &d));
-  EXPECT_EQ(d, 0.5);
-  EXPECT_TRUE(shield_absl::SimpleAtod("-.707", &d));
-  EXPECT_EQ(d, -0.707);
-
-  // Unary + is OK.
-  EXPECT_TRUE(shield_absl::SimpleAtod("+6.0221408e+23", &d));
-  EXPECT_EQ(d, 6.0221408e+23);
-
-  // Underscores are not OK.
-  EXPECT_FALSE(shield_absl::SimpleAtod("123_456", &d));
-
-  // The decimal separator must be '.' and is never ','.
-  EXPECT_TRUE(shield_absl::SimpleAtod("8.9", &d));
-  EXPECT_FALSE(shield_absl::SimpleAtod("8,9", &d));
-
-  // These examples are called out in the EiselLemire function's comments.
-  EXPECT_TRUE(shield_absl::SimpleAtod("4503599627370497.5", &d));
-  EXPECT_EQ(d, 4503599627370497.5);
-  EXPECT_TRUE(shield_absl::SimpleAtod("1e+23", &d));
-  EXPECT_EQ(d, 1e+23);
-  EXPECT_TRUE(shield_absl::SimpleAtod("9223372036854775807", &d));
-  EXPECT_EQ(d, 9223372036854775807);
-  // Ditto, but for Atof instead of Atod.
-  EXPECT_TRUE(shield_absl::SimpleAtof("0.0625", &f));
-  EXPECT_EQ(f, 0.0625f);
-  EXPECT_TRUE(shield_absl::SimpleAtof("20040229.0", &f));
-  EXPECT_EQ(f, 20040229.0f);
-  EXPECT_TRUE(shield_absl::SimpleAtof("2147483647.0", &f));
-  EXPECT_EQ(f, 2147483647.0f);
-
-  // Some parsing algorithms don't always round correctly (but shield_absl::SimpleAtod
-  // should). This test case comes from
-  // https://github.com/serde-rs/json/issues/707
-  //
-  // See also atod_manual_test.cc for running many more test cases.
-  EXPECT_TRUE(shield_absl::SimpleAtod("122.416294033786585", &d));
-  EXPECT_EQ(d, 122.416294033786585);
-  EXPECT_TRUE(shield_absl::SimpleAtof("122.416294033786585", &f));
-  EXPECT_EQ(f, 122.416294033786585f);
-}
