+  EXPECT_DOUBLE_EQ(value, 5.7f);
+  EXPECT_TRUE(shield_absl::ParseFlag("  -0xE0.F3p01  ", &value, &err));
+  EXPECT_NEAR(value, -449.8984375f, 5e-8f);
