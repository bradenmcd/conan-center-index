+TEST(IteratorConstructorTest, NonInline) {
+  int const kInput[] = {2, 3, 5, 7, 11, 13, 17};
+  shield_absl::FixedArray<int, ABSL_ARRAYSIZE(kInput) - 1> const fixed(
