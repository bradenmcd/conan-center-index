-// -----------------------------------------------------------------------------
-// File: log/log_entry.h
-// -----------------------------------------------------------------------------
-//
-// This header declares `class shield_absl::LogEntry`, which represents a log record as
-// passed to `LogSink::Send`. Data returned by pointer or by reference or by
-// `shield_absl::string_view` must be copied if they are needed after the lifetime of
-// the `shield_absl::LogEntry`.
-
-#ifndef ABSL_LOG_LOG_ENTRY_H_
-#define ABSL_LOG_LOG_ENTRY_H_
-
