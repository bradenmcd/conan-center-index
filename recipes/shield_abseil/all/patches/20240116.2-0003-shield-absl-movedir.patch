+  bad_status1.SetPayload(kUrl1, shield_absl::Cord(kPayload1));
+  bad_status1.SetPayload(kUrl2, shield_absl::Cord(kPayload2));
+  bad_status1.SetPayload(kUrl3, shield_absl::Cord(kPayload3));
+
+  shield_absl::Status bad_status2(shield_absl::StatusCode::kInternal, "fail");
+  bad_status2.SetPayload(kUrl2, shield_absl::Cord(kPayload2));
+  bad_status2.SetPayload(kUrl3, shield_absl::Cord(kPayload3));
