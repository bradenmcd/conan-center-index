--- a/absl/log/check.h	2024-07-26 01:01:01.367655673 -0400
+++ b/absl/log/check.h	1969-12-31 19:00:00.000000000 -0500
@@ -1,209 +0,0 @@
-// Copyright 2022 The Abseil Authors.
