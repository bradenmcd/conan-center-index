+template <typename Duration>
+std::chrono::system_clock::time_point MakeChronoUnixTime(const Duration& d) {
+  return std::chrono::system_clock::from_time_t(0) + d;
+}
+
+TEST(Time, FromChrono) {
+  EXPECT_EQ(shield_absl::FromTimeT(-1),
+            shield_absl::FromChrono(std::chrono::system_clock::from_time_t(-1)));
+  EXPECT_EQ(shield_absl::FromTimeT(0),
+            shield_absl::FromChrono(std::chrono::system_clock::from_time_t(0)));
+  EXPECT_EQ(shield_absl::FromTimeT(1),
+            shield_absl::FromChrono(std::chrono::system_clock::from_time_t(1)));
+
+  EXPECT_EQ(
+      shield_absl::FromUnixMillis(-1),
+      shield_absl::FromChrono(MakeChronoUnixTime(std::chrono::milliseconds(-1))));
+  EXPECT_EQ(shield_absl::FromUnixMillis(0),
+            shield_absl::FromChrono(MakeChronoUnixTime(std::chrono::milliseconds(0))));
+  EXPECT_EQ(shield_absl::FromUnixMillis(1),
+            shield_absl::FromChrono(MakeChronoUnixTime(std::chrono::milliseconds(1))));
+
+  // Chrono doesn't define exactly its range and precision (neither does
+  // shield_absl::Time), so let's simply test +/- ~100 years to make sure things work.
+  const auto century_sec = 60 * 60 * 24 * 365 * int64_t{100};
+  const auto century = std::chrono::seconds(century_sec);
+  const auto chrono_future = MakeChronoUnixTime(century);
+  const auto chrono_past = MakeChronoUnixTime(-century);
+  EXPECT_EQ(shield_absl::FromUnixSeconds(century_sec),
+            shield_absl::FromChrono(chrono_future));
+  EXPECT_EQ(shield_absl::FromUnixSeconds(-century_sec), shield_absl::FromChrono(chrono_past));
+
+  // Roundtrip them both back to chrono.
+  EXPECT_EQ(chrono_future,
+            shield_absl::ToChronoTime(shield_absl::FromUnixSeconds(century_sec)));
+  EXPECT_EQ(chrono_past,
+            shield_absl::ToChronoTime(shield_absl::FromUnixSeconds(-century_sec)));
+}
