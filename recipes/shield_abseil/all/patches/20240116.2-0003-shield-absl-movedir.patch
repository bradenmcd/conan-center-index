+TEST(Time, LegacyDateTime) {
+  const shield_absl::TimeZone utc = shield_absl::UTCTimeZone();
+  const std::string ymdhms = "%Y-%m-%d %H:%M:%S";
+  const int kMax = std::numeric_limits<int>::max();
+  const int kMin = std::numeric_limits<int>::min();
+  shield_absl::Time t;
+
+  t = shield_absl::FromDateTime(std::numeric_limits<shield_absl::civil_year_t>::max(), kMax,
+                         kMax, kMax, kMax, kMax, utc);
+  EXPECT_EQ("infinite-future",
+            shield_absl::FormatTime(ymdhms, t, utc));  // no overflow
+  t = shield_absl::FromDateTime(std::numeric_limits<shield_absl::civil_year_t>::min(), kMin,
+                         kMin, kMin, kMin, kMin, utc);
+  EXPECT_EQ("infinite-past", shield_absl::FormatTime(ymdhms, t, utc));  // no overflow
+
+  // Check normalization.
+  EXPECT_TRUE(shield_absl::ConvertDateTime(2013, 10, 32, 8, 30, 0, utc).normalized);
+  t = shield_absl::FromDateTime(2015, 1, 1, 0, 0, 60, utc);
+  EXPECT_EQ("2015-01-01 00:01:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 1, 0, 60, 0, utc);
+  EXPECT_EQ("2015-01-01 01:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 1, 24, 0, 0, utc);
+  EXPECT_EQ("2015-01-02 00:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 32, 0, 0, 0, utc);
+  EXPECT_EQ("2015-02-01 00:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 13, 1, 0, 0, 0, utc);
+  EXPECT_EQ("2016-01-01 00:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 13, 32, 60, 60, 60, utc);
+  EXPECT_EQ("2016-02-03 13:01:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 1, 0, 0, -1, utc);
+  EXPECT_EQ("2014-12-31 23:59:59", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 1, 0, -1, 0, utc);
+  EXPECT_EQ("2014-12-31 23:59:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, 1, -1, 0, 0, utc);
+  EXPECT_EQ("2014-12-31 23:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, 1, -1, 0, 0, 0, utc);
+  EXPECT_EQ("2014-12-30 00:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, -1, 1, 0, 0, 0, utc);
+  EXPECT_EQ("2014-11-01 00:00:00", shield_absl::FormatTime(ymdhms, t, utc));
+  t = shield_absl::FromDateTime(2015, -1, -1, -1, -1, -1, utc);
+  EXPECT_EQ("2014-10-29 22:58:59", shield_absl::FormatTime(ymdhms, t, utc));
+}
