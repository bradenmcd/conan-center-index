+TEST(Duration, ParseDuration) {
+  shield_absl::Duration d;
+
+  // No specified unit. Should only work for zero and infinity.
+  EXPECT_TRUE(shield_absl::ParseDuration("0", &d));
+  EXPECT_EQ(shield_absl::ZeroDuration(), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("+0", &d));
+  EXPECT_EQ(shield_absl::ZeroDuration(), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("-0", &d));
+  EXPECT_EQ(shield_absl::ZeroDuration(), d);
+
+  EXPECT_TRUE(shield_absl::ParseDuration("inf", &d));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("+inf", &d));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("-inf", &d));
+  EXPECT_EQ(-shield_absl::InfiniteDuration(), d);
+  EXPECT_FALSE(shield_absl::ParseDuration("infBlah", &d));
+
+  // Illegal input forms.
+  EXPECT_FALSE(shield_absl::ParseDuration("", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("0.0", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration(".0", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration(".", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("01", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("1", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("-1", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("2", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("2 s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration(".s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("-.s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration(" 2s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("2s ", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration(" 2s ", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("2mt", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("1e3s", &d));
+
+  // One unit type.
+  EXPECT_TRUE(shield_absl::ParseDuration("1ns", &d));
+  EXPECT_EQ(shield_absl::Nanoseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1us", &d));
+  EXPECT_EQ(shield_absl::Microseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1ms", &d));
+  EXPECT_EQ(shield_absl::Milliseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1s", &d));
+  EXPECT_EQ(shield_absl::Seconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("2m", &d));
+  EXPECT_EQ(shield_absl::Minutes(2), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("2h", &d));
+  EXPECT_EQ(shield_absl::Hours(2), d);
+
+  // Huge counts of a unit.
+  EXPECT_TRUE(shield_absl::ParseDuration("9223372036854775807us", &d));
+  EXPECT_EQ(shield_absl::Microseconds(9223372036854775807), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("-9223372036854775807us", &d));
+  EXPECT_EQ(shield_absl::Microseconds(-9223372036854775807), d);
+
+  // Multiple units.
+  EXPECT_TRUE(shield_absl::ParseDuration("2h3m4s", &d));
+  EXPECT_EQ(shield_absl::Hours(2) + shield_absl::Minutes(3) + shield_absl::Seconds(4), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("3m4s5us", &d));
+  EXPECT_EQ(shield_absl::Minutes(3) + shield_absl::Seconds(4) + shield_absl::Microseconds(5), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("2h3m4s5ms6us7ns", &d));
+  EXPECT_EQ(shield_absl::Hours(2) + shield_absl::Minutes(3) + shield_absl::Seconds(4) +
+                shield_absl::Milliseconds(5) + shield_absl::Microseconds(6) +
+                shield_absl::Nanoseconds(7),
+            d);
+
+  // Multiple units out of order.
+  EXPECT_TRUE(shield_absl::ParseDuration("2us3m4s5h", &d));
+  EXPECT_EQ(shield_absl::Hours(5) + shield_absl::Minutes(3) + shield_absl::Seconds(4) +
+                shield_absl::Microseconds(2),
+            d);
+
+  // Fractional values of units.
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5ns", &d));
+  EXPECT_EQ(1.5 * shield_absl::Nanoseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5us", &d));
+  EXPECT_EQ(1.5 * shield_absl::Microseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5ms", &d));
+  EXPECT_EQ(1.5 * shield_absl::Milliseconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5s", &d));
+  EXPECT_EQ(1.5 * shield_absl::Seconds(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5m", &d));
+  EXPECT_EQ(1.5 * shield_absl::Minutes(1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("1.5h", &d));
+  EXPECT_EQ(1.5 * shield_absl::Hours(1), d);
+
+  // Huge fractional counts of a unit.
+  EXPECT_TRUE(shield_absl::ParseDuration("0.4294967295s", &d));
+  EXPECT_EQ(shield_absl::Nanoseconds(429496729) + shield_absl::Nanoseconds(1) / 2, d);
+  EXPECT_TRUE(shield_absl::ParseDuration("0.429496729501234567890123456789s", &d));
+  EXPECT_EQ(shield_absl::Nanoseconds(429496729) + shield_absl::Nanoseconds(1) / 2, d);
+
+  // Negative durations.
+  EXPECT_TRUE(shield_absl::ParseDuration("-1s", &d));
+  EXPECT_EQ(shield_absl::Seconds(-1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("-1m", &d));
+  EXPECT_EQ(shield_absl::Minutes(-1), d);
+  EXPECT_TRUE(shield_absl::ParseDuration("-1h", &d));
+  EXPECT_EQ(shield_absl::Hours(-1), d);
+
+  EXPECT_TRUE(shield_absl::ParseDuration("-1h2s", &d));
+  EXPECT_EQ(-(shield_absl::Hours(1) + shield_absl::Seconds(2)), d);
+  EXPECT_FALSE(shield_absl::ParseDuration("1h-2s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("-1h-2s", &d));
+  EXPECT_FALSE(shield_absl::ParseDuration("-1h -2s", &d));
+}
