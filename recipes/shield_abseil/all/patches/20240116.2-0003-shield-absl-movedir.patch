+class StringifySink {
+ public:
+  void Append(size_t count, char ch);
+
+  void Append(string_view v);
+
+  // Support `shield_absl::Format(&sink, format, args...)`.
+  friend void AbslFormatFlush(StringifySink* sink, shield_absl::string_view v) {
+    sink->Append(v);
