-
-  // Thursday -> Sunday
-  d = shield_absl::NextWeekday(thursday, shield_absl::Weekday::sunday);
-  EXPECT_EQ(3, d - thursday) << d;
-  EXPECT_EQ(d - 7, shield_absl::PrevWeekday(thursday, shield_absl::Weekday::sunday));
-
-  // Thursday -> Monday
-  d = shield_absl::NextWeekday(thursday, shield_absl::Weekday::monday);
