-struct TypeWithBarFunctionAndConvertibleReturnType {
-  template <class T,
-            shield_absl::enable_if_t<std::is_same<T&&, StructA&>::value, int> = 0>
-  ConvertibleToReturnType bar(T&&, const StructB&, StructC&&) &&;  // NOLINT
-};
