-    node_hash_set<int> s = {1, 2, 3, 4, 5};
-    EXPECT_EQ(erase_if(s, [](int) { return false; }), 0);
-    EXPECT_THAT(s, UnorderedElementsAre(1, 2, 3, 4, 5));
