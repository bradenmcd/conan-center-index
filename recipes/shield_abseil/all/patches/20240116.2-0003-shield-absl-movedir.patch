-Status::Status(shield_absl::StatusCode code, shield_absl::string_view msg)
-    : rep_(CodeToInlinedRep(code)) {
-  if (code != shield_absl::StatusCode::kOk && !msg.empty()) {
-    rep_ = PointerToRep(new status_internal::StatusRep(code, msg, nullptr));
-  }
-}
-
-shield_absl::Nonnull<status_internal::StatusRep*> Status::PrepareToModify(
-    uintptr_t rep) {
-  if (IsInlined(rep)) {
-    return new status_internal::StatusRep(InlinedRepToCode(rep),
-                                          shield_absl::string_view(), nullptr);
-  }
-  return RepToPointer(rep)->CloneAndUnref();
-}
-
-std::string Status::ToStringSlow(uintptr_t rep, StatusToStringMode mode) {
-  if (IsInlined(rep)) {
-    return shield_absl::StrCat(shield_absl::StatusCodeToString(InlinedRepToCode(rep)), ": ");
-  }
-  return RepToPointer(rep)->ToString(mode);
-}
