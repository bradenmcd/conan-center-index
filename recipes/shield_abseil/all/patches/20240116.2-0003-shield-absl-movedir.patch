+TEST(KernelTimeout, InfiniteFuture) {
+  KernelTimeout t(shield_absl::InfiniteFuture());
+  EXPECT_FALSE(t.has_timeout());
+  // Callers are expected to check has_timeout() instead of using the methods
+  // below, but we do try to do something reasonable if they don't. We may not
+  // be able to round-trip back to shield_absl::InfiniteDuration() or
+  // shield_absl::InfiniteFuture(), but we should return a very large value.
+  EXPECT_GT(shield_absl::TimeFromTimespec(t.MakeAbsTimespec()),
+            shield_absl::Now() + shield_absl::Hours(100000));
+#ifndef _WIN32
+  EXPECT_GT(shield_absl::TimeFromTimespec(t.MakeClockAbsoluteTimespec(CLOCK_REALTIME)),
+            shield_absl::Now() + shield_absl::Hours(100000));
+#endif
+  EXPECT_GT(shield_absl::DurationFromTimespec(t.MakeRelativeTimespec()),
+            shield_absl::Hours(100000));
+  EXPECT_GT(shield_absl::FromUnixNanos(t.MakeAbsNanos()),
+            shield_absl::Now() + shield_absl::Hours(100000));
+  EXPECT_EQ(t.InMillisecondsFromNow(),
+            std::numeric_limits<KernelTimeout::DWord>::max());
+  EXPECT_EQ(t.ToChronoTimePoint(),
+            std::chrono::time_point<std::chrono::system_clock>::max());
+  EXPECT_GE(t.ToChronoDuration(), std::chrono::nanoseconds::max());
