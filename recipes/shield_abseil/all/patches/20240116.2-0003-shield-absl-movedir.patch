+                                  NoConvertToOptional&&>::value));
+  // U = const NoConvertToOptional& triggers SFINAE because
+  // std::is_constructible_v<MoveConvertFromOptional, const
+  // NoConvertToOptional&> is false
+  EXPECT_FALSE((std::is_assignable<shield_absl::optional<MoveConvertFromOptional>&,
+                                   const NoConvertToOptional&>::value));
+  // U = NoConvertToOptional
+  EXPECT_TRUE((std::is_assignable<shield_absl::optional<MoveConvertFromOptional>&,
+                                  NoConvertToOptional&&>::value));
+  // U = const shield_absl::optional<NoConvertToOptional>&
+  EXPECT_TRUE(
+      (std::is_assignable<shield_absl::optional<CopyConvertFromOptional>&,
+                          const shield_absl::optional<NoConvertToOptional>&>::value));
+  // U = shield_absl::optional<NoConvertToOptional>
+  EXPECT_TRUE(
+      (std::is_assignable<shield_absl::optional<MoveConvertFromOptional>&,
+                          shield_absl::optional<NoConvertToOptional>&&>::value));
