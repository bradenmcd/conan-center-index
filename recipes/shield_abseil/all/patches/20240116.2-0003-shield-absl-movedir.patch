+static shield_absl::Cord MakeExternalCord(int size) {
+  char* buffer = new char[size];
+  memset(buffer, 'x', size);
+  shield_absl::Cord cord;
+  cord.Append(shield_absl::MakeCordFromExternal(
+      shield_absl::string_view(buffer, size),
+      [](shield_absl::string_view s) { delete[] s.data(); }));
+  return cord;
+}
