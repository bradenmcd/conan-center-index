-class StderrLogSink final : public LogSink {
- public:
-  ~StderrLogSink() override = default;
-
-  void Send(const shield_absl::LogEntry& entry) override {
-    if (entry.log_severity() < shield_absl::StderrThreshold() &&
-        shield_absl::log_internal::IsInitialized()) {
-      return;
-    }
-
-    ABSL_CONST_INIT static shield_absl::once_flag warn_if_not_initialized;
-    shield_absl::call_once(warn_if_not_initialized, []() {
-      if (shield_absl::log_internal::IsInitialized()) return;
-      const char w[] =
-          "WARNING: All log messages before shield_absl::InitializeLog() is called"
-          " are written to STDERR\n";
-      shield_absl::log_internal::WriteToStderr(w, shield_absl::LogSeverity::kWarning);
-    });
-
-    if (!entry.stacktrace().empty()) {
-      shield_absl::log_internal::WriteToStderr(entry.stacktrace(),
-                                        entry.log_severity());
-    } else {
-      // TODO(b/226937039): do this outside else condition once we avoid
-      // ReprintFatalMessage
-      shield_absl::log_internal::WriteToStderr(
-          entry.text_message_with_prefix_and_newline(), entry.log_severity());
-    }
-  }
-};
-
-#if defined(__ANDROID__)
-class AndroidLogSink final : public LogSink {
- public:
-  ~AndroidLogSink() override = default;
-
-  void Send(const shield_absl::LogEntry& entry) override {
-    const int level = AndroidLogLevel(entry);
-    const char* const tag = GetAndroidNativeTag();
-    __android_log_write(level, tag,
-                        entry.text_message_with_prefix_and_newline_c_str());
-    if (entry.log_severity() == shield_absl::LogSeverity::kFatal)
-      __android_log_write(ANDROID_LOG_FATAL, tag, "terminating.\n");
-  }
-
- private:
-  static int AndroidLogLevel(const shield_absl::LogEntry& entry) {
-    switch (entry.log_severity()) {
-      case shield_absl::LogSeverity::kFatal:
-        return ANDROID_LOG_FATAL;
-      case shield_absl::LogSeverity::kError:
-        return ANDROID_LOG_ERROR;
-      case shield_absl::LogSeverity::kWarning:
-        return ANDROID_LOG_WARN;
-      default:
-        if (entry.verbosity() >= 2) return ANDROID_LOG_VERBOSE;
-        if (entry.verbosity() == 1) return ANDROID_LOG_DEBUG;
-        return ANDROID_LOG_INFO;
-    }
-  }
-};
-#endif  // !defined(__ANDROID__)
