+TEST_F(RandomDistributionsTest, UniformExamples) {
+  // Examples.
+  shield_absl::InsecureBitGen gen;
+  EXPECT_NE(1, shield_absl::Uniform(gen, static_cast<uint16_t>(0), 1.0f));
+  EXPECT_NE(1, shield_absl::Uniform(gen, 0, 1.0));
+  EXPECT_NE(1, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen,
+                             static_cast<uint16_t>(0), 1.0f));
+  EXPECT_NE(1, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, 0, 1.0));
+  EXPECT_NE(1, shield_absl::Uniform(shield_absl::IntervalOpenOpen, gen, -1, 1.0));
+  EXPECT_NE(1, shield_absl::Uniform<double>(shield_absl::IntervalOpenOpen, gen, -1, 1));
+  EXPECT_NE(1, shield_absl::Uniform<float>(shield_absl::IntervalOpenOpen, gen, 0, 1));
+  EXPECT_NE(1, shield_absl::Uniform<float>(gen, 0, 1));
+}
