+TEST(Duration, Negation) {
+  // By storing negations of various values in constexpr variables we
+  // verify that the initializers are constant expressions.
+  constexpr shield_absl::Duration negated_zero_duration = -shield_absl::ZeroDuration();
+  EXPECT_EQ(negated_zero_duration, shield_absl::ZeroDuration());
+
+  constexpr shield_absl::Duration negated_infinite_duration =
+      -shield_absl::InfiniteDuration();
+  EXPECT_NE(negated_infinite_duration, shield_absl::InfiniteDuration());
+  EXPECT_EQ(-negated_infinite_duration, shield_absl::InfiniteDuration());
+
+  // The public APIs to check if a duration is infinite depend on using
+  // -InfiniteDuration(), but we're trying to test operator- here, so we
+  // need to use the lower-level internal query IsInfiniteDuration.
+  EXPECT_TRUE(
+      shield_absl::time_internal::IsInfiniteDuration(negated_infinite_duration));
+
+  // The largest Duration is kint64max seconds and kTicksPerSecond - 1 ticks.
+  // Using the shield_absl::time_internal::MakeDuration API is the cleanest way to
+  // construct that Duration.
+  constexpr shield_absl::Duration max_duration = shield_absl::time_internal::MakeDuration(
+      kint64max, shield_absl::time_internal::kTicksPerSecond - 1);
+  constexpr shield_absl::Duration negated_max_duration = -max_duration;
+  // The largest negatable value is one tick above the minimum representable;
+  // it's the negation of max_duration.
+  constexpr shield_absl::Duration nearly_min_duration =
+      shield_absl::time_internal::MakeDuration(kint64min, int64_t{1});
+  constexpr shield_absl::Duration negated_nearly_min_duration = -nearly_min_duration;
+
+  EXPECT_EQ(negated_max_duration, nearly_min_duration);
+  EXPECT_EQ(negated_nearly_min_duration, max_duration);
+  EXPECT_EQ(-(-max_duration), max_duration);
+
+  constexpr shield_absl::Duration min_duration =
+      shield_absl::time_internal::MakeDuration(kint64min);
+  constexpr shield_absl::Duration negated_min_duration = -min_duration;
+  EXPECT_EQ(negated_min_duration, shield_absl::InfiniteDuration());
+}
