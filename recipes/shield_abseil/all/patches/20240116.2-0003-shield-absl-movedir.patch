+TEST(LogThresholdTest, LogSeverityAtLeastTest) {
+  EXPECT_LT(shield_absl::LogSeverity::kError, shield_absl::LogSeverityAtLeast::kFatal);
+  EXPECT_GT(shield_absl::LogSeverityAtLeast::kError, shield_absl::LogSeverity::kInfo);
+
+  EXPECT_LE(shield_absl::LogSeverityAtLeast::kInfo, shield_absl::LogSeverity::kError);
+  EXPECT_GE(shield_absl::LogSeverity::kError, shield_absl::LogSeverityAtLeast::kInfo);
+}
+
+TEST(LogThresholdTest, LogSeverityAtMostTest) {
+  EXPECT_GT(shield_absl::LogSeverity::kError, shield_absl::LogSeverityAtMost::kWarning);
+  EXPECT_LT(shield_absl::LogSeverityAtMost::kError, shield_absl::LogSeverity::kFatal);
+
+  EXPECT_GE(shield_absl::LogSeverityAtMost::kFatal, shield_absl::LogSeverity::kError);
+  EXPECT_LE(shield_absl::LogSeverity::kWarning, shield_absl::LogSeverityAtMost::kError);
+}
+
+TEST(LogThresholdTest, Extremes) {
+  EXPECT_LT(shield_absl::LogSeverity::kFatal, shield_absl::LogSeverityAtLeast::kInfinity);
+  EXPECT_GT(shield_absl::LogSeverity::kInfo,
+            shield_absl::LogSeverityAtMost::kNegativeInfinity);
+}
+
+TEST(LogThresholdTest, Output) {
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtLeast::kInfo), Eq(">=INFO"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtLeast::kWarning),
+              Eq(">=WARNING"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtLeast::kError), Eq(">=ERROR"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtLeast::kFatal), Eq(">=FATAL"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtLeast::kInfinity),
+              Eq("INFINITY"));
+
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtMost::kInfo), Eq("<=INFO"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtMost::kWarning), Eq("<=WARNING"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtMost::kError), Eq("<=ERROR"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtMost::kFatal), Eq("<=FATAL"));
+  EXPECT_THAT(StreamHelper(shield_absl::LogSeverityAtMost::kNegativeInfinity),
+              Eq("NEGATIVE_INFINITY"));
+}
