+template <int64_t N>
+void TestToConversion() {
+  constexpr shield_absl::Duration nano = shield_absl::Nanoseconds(N);
+  EXPECT_EQ(N, shield_absl::ToInt64Nanoseconds(nano));
+  EXPECT_EQ(0, shield_absl::ToInt64Microseconds(nano));
+  EXPECT_EQ(0, shield_absl::ToInt64Milliseconds(nano));
+  EXPECT_EQ(0, shield_absl::ToInt64Seconds(nano));
+  EXPECT_EQ(0, shield_absl::ToInt64Minutes(nano));
+  EXPECT_EQ(0, shield_absl::ToInt64Hours(nano));
+  const shield_absl::Duration micro = shield_absl::Microseconds(N);
+  EXPECT_EQ(N * 1000, shield_absl::ToInt64Nanoseconds(micro));
+  EXPECT_EQ(N, shield_absl::ToInt64Microseconds(micro));
+  EXPECT_EQ(0, shield_absl::ToInt64Milliseconds(micro));
+  EXPECT_EQ(0, shield_absl::ToInt64Seconds(micro));
+  EXPECT_EQ(0, shield_absl::ToInt64Minutes(micro));
+  EXPECT_EQ(0, shield_absl::ToInt64Hours(micro));
+  const shield_absl::Duration milli = shield_absl::Milliseconds(N);
+  EXPECT_EQ(N * 1000 * 1000, shield_absl::ToInt64Nanoseconds(milli));
+  EXPECT_EQ(N * 1000, shield_absl::ToInt64Microseconds(milli));
+  EXPECT_EQ(N, shield_absl::ToInt64Milliseconds(milli));
+  EXPECT_EQ(0, shield_absl::ToInt64Seconds(milli));
+  EXPECT_EQ(0, shield_absl::ToInt64Minutes(milli));
+  EXPECT_EQ(0, shield_absl::ToInt64Hours(milli));
+  const shield_absl::Duration sec = shield_absl::Seconds(N);
+  EXPECT_EQ(N * 1000 * 1000 * 1000, shield_absl::ToInt64Nanoseconds(sec));
+  EXPECT_EQ(N * 1000 * 1000, shield_absl::ToInt64Microseconds(sec));
+  EXPECT_EQ(N * 1000, shield_absl::ToInt64Milliseconds(sec));
+  EXPECT_EQ(N, shield_absl::ToInt64Seconds(sec));
+  EXPECT_EQ(0, shield_absl::ToInt64Minutes(sec));
+  EXPECT_EQ(0, shield_absl::ToInt64Hours(sec));
+  const shield_absl::Duration min = shield_absl::Minutes(N);
+  EXPECT_EQ(N * 60 * 1000 * 1000 * 1000, shield_absl::ToInt64Nanoseconds(min));
+  EXPECT_EQ(N * 60 * 1000 * 1000, shield_absl::ToInt64Microseconds(min));
+  EXPECT_EQ(N * 60 * 1000, shield_absl::ToInt64Milliseconds(min));
+  EXPECT_EQ(N * 60, shield_absl::ToInt64Seconds(min));
+  EXPECT_EQ(N, shield_absl::ToInt64Minutes(min));
+  EXPECT_EQ(0, shield_absl::ToInt64Hours(min));
+  const shield_absl::Duration hour = shield_absl::Hours(N);
+  EXPECT_EQ(N * 60 * 60 * 1000 * 1000 * 1000, shield_absl::ToInt64Nanoseconds(hour));
+  EXPECT_EQ(N * 60 * 60 * 1000 * 1000, shield_absl::ToInt64Microseconds(hour));
+  EXPECT_EQ(N * 60 * 60 * 1000, shield_absl::ToInt64Milliseconds(hour));
+  EXPECT_EQ(N * 60 * 60, shield_absl::ToInt64Seconds(hour));
+  EXPECT_EQ(N * 60, shield_absl::ToInt64Minutes(hour));
+  EXPECT_EQ(N, shield_absl::ToInt64Hours(hour));
+}
