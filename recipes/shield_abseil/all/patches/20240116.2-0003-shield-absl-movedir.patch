-// --------------------------------------------------------------------
-
-// Returns:
-//  Flag name or empty if arg= --
-//  Flag value after = in --flag=value (empty if --foo)
-//  "Is empty value" status. True if arg= --foo=, false otherwise. This is
-//  required to separate --foo from --foo=.
-// For example:
-//      arg           return values
-//   "--foo=bar" -> {"foo", "bar", false}.
-//   "--foo"     -> {"foo", "", false}.
-//   "--foo="    -> {"foo", "", true}.
-std::tuple<shield_absl::string_view, shield_absl::string_view, bool> SplitNameAndValue(
-    shield_absl::string_view arg) {
-  // Allow -foo and --foo
-  shield_absl::ConsumePrefix(&arg, "-");
-
-  if (arg.empty()) {
-    return std::make_tuple("", "", false);
-  }
-
-  auto equal_sign_pos = arg.find('=');
-
-  shield_absl::string_view flag_name = arg.substr(0, equal_sign_pos);
-
-  shield_absl::string_view value;
-  bool is_empty_value = false;
-
-  if (equal_sign_pos != shield_absl::string_view::npos) {
-    value = arg.substr(equal_sign_pos + 1);
-    is_empty_value = value.empty();
-  }
-
-  return std::make_tuple(flag_name, value, is_empty_value);
-}
