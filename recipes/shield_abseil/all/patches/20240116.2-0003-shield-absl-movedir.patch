+TEST(Int128, RightShiftOfNegativeNumbers) {
+  shield_absl::int128 minus_six = -6;
+  shield_absl::int128 minus_three = -3;
+  shield_absl::int128 minus_two = -2;
+  shield_absl::int128 minus_one = -1;
+  if ((-6 >> 1) == -3) {
+    // Right shift is arithmetic (sign propagates)
+    EXPECT_EQ(minus_six >> 1, minus_three);
+    EXPECT_EQ(minus_six >> 2, minus_two);
+    EXPECT_EQ(minus_six >> 65, minus_one);
+  } else {
+    // Right shift is logical (zeros shifted in at MSB)
+    EXPECT_EQ(minus_six >> 1, shield_absl::int128(shield_absl::uint128(minus_six) >> 1));
+    EXPECT_EQ(minus_six >> 2, shield_absl::int128(shield_absl::uint128(minus_six) >> 2));
+    EXPECT_EQ(minus_six >> 65, shield_absl::int128(shield_absl::uint128(minus_six) >> 65));
+  }
+}
