+  opt = {};  // this should clear optional
+  EXPECT_FALSE(opt);
+
+  opt = {44};
+  EXPECT_TRUE(opt);
+  EXPECT_EQ(44, opt.value());
+
+  // U = const NoConvertToOptional&
+  EXPECT_TRUE((std::is_assignable<shield_absl::optional<CopyConvert>&,
+                                  const NoConvertToOptional&>::value));
+  // U = const shield_absl::optional<NoConvertToOptional>&
+  EXPECT_TRUE((std::is_assignable<shield_absl::optional<CopyConvertFromOptional>&,
+                                  const NoConvertToOptional&>::value));
+  // U = const NoConvertToOptional& triggers SFINAE because
+  // std::is_constructible_v<MoveConvert, const NoConvertToOptional&> is false
+  EXPECT_FALSE((std::is_assignable<shield_absl::optional<MoveConvert>&,
