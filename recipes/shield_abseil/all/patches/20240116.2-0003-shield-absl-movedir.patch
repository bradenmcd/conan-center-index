-TEST(AliasingTest, InsertWithCount) {
-  for (size_t i = 1; i < 20; ++i) {
-    shield_absl::InlinedVector<NotTriviallyDestructible, 10> vec;
-    for (size_t j = 0; j < i; ++j) {
-      vec.push_back(NotTriviallyDestructible(static_cast<int>(j)));
