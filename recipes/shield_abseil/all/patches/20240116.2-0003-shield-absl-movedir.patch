+TEST(NumbersTest, Prefixes) {
+  double d;
+  EXPECT_FALSE(shield_absl::SimpleAtod("++1", &d));
+  EXPECT_FALSE(shield_absl::SimpleAtod("+-1", &d));
+  EXPECT_FALSE(shield_absl::SimpleAtod("-+1", &d));
+  EXPECT_FALSE(shield_absl::SimpleAtod("--1", &d));
+  EXPECT_TRUE(shield_absl::SimpleAtod("-1", &d));
+  EXPECT_EQ(d, -1.);
+  EXPECT_TRUE(shield_absl::SimpleAtod("+1", &d));
+  EXPECT_EQ(d, +1.);
+
+  float f;
+  EXPECT_FALSE(shield_absl::SimpleAtof("++1", &f));
+  EXPECT_FALSE(shield_absl::SimpleAtof("+-1", &f));
+  EXPECT_FALSE(shield_absl::SimpleAtof("-+1", &f));
+  EXPECT_FALSE(shield_absl::SimpleAtof("--1", &f));
+  EXPECT_TRUE(shield_absl::SimpleAtof("-1", &f));
+  EXPECT_EQ(f, -1.f);
+  EXPECT_TRUE(shield_absl::SimpleAtof("+1", &f));
+  EXPECT_EQ(f, +1.f);
+}
