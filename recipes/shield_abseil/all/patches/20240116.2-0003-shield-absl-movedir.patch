diff -N -u -r '--exclude=.git' a/shield_absl/debugging/internal/demangle.cc b/shield_absl/debugging/internal/demangle.cc
--- a/shield_absl/debugging/internal/demangle.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/debugging/internal/demangle.cc	2024-07-26 00:35:48.659938622 -0400
@@ -0,0 +1,2012 @@
+// Copyright 2018 The Abseil Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
