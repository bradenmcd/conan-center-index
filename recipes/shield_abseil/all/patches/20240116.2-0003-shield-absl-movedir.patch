-namespace shield_absl {
-ABSL_NAMESPACE_BEGIN
-
-// ConsumePrefix()
-//
-// Strips the `expected` prefix, if found, from the start of `str`.
-// If the operation succeeded, `true` is returned.  If not, `false`
-// is returned and `str` is not modified.
-//
-// Example:
-//
-//   shield_absl::string_view input("abc");
-//   EXPECT_TRUE(shield_absl::ConsumePrefix(&input, "a"));
-//   EXPECT_EQ(input, "bc");
-inline bool ConsumePrefix(shield_absl::Nonnull<shield_absl::string_view*> str,
-                          shield_absl::string_view expected) {
-  if (!shield_absl::StartsWith(*str, expected)) return false;
-  str->remove_prefix(expected.size());
-  return true;
-}
-// ConsumeSuffix()
-//
-// Strips the `expected` suffix, if found, from the end of `str`.
-// If the operation succeeded, `true` is returned.  If not, `false`
-// is returned and `str` is not modified.
-//
-// Example:
-//
-//   shield_absl::string_view input("abcdef");
-//   EXPECT_TRUE(shield_absl::ConsumeSuffix(&input, "def"));
-//   EXPECT_EQ(input, "abc");
-inline bool ConsumeSuffix(shield_absl::Nonnull<shield_absl::string_view*> str,
-                          shield_absl::string_view expected) {
-  if (!shield_absl::EndsWith(*str, expected)) return false;
-  str->remove_suffix(expected.size());
-  return true;
-}
-
-// StripPrefix()
-//
-// Returns a view into the input string `str` with the given `prefix` removed,
-// but leaving the original string intact. If the prefix does not match at the
-// start of the string, returns the original string instead.
-ABSL_MUST_USE_RESULT inline shield_absl::string_view StripPrefix(
-    shield_absl::string_view str, shield_absl::string_view prefix) {
-  if (shield_absl::StartsWith(str, prefix)) str.remove_prefix(prefix.size());
-  return str;
-}
-
-// StripSuffix()
-//
-// Returns a view into the input string `str` with the given `suffix` removed,
-// but leaving the original string intact. If the suffix does not match at the
-// end of the string, returns the original string instead.
-ABSL_MUST_USE_RESULT inline shield_absl::string_view StripSuffix(
-    shield_absl::string_view str, shield_absl::string_view suffix) {
-  if (shield_absl::EndsWith(str, suffix)) str.remove_suffix(suffix.size());
-  return str;
-}
-
-ABSL_NAMESPACE_END
-}  // namespace shield_absl
-
-#endif  // ABSL_STRINGS_STRIP_H_
