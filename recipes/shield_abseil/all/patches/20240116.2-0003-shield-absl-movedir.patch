+  TEST_FACTORY_OVERLOADS(shield_absl::Hours);
+
+#undef TEST_FACTORY_OVERLOADS
+
+  EXPECT_EQ(shield_absl::Milliseconds(1500), shield_absl::Seconds(1.5));
+  EXPECT_LT(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(1.5));
+  EXPECT_GT(shield_absl::Nanoseconds(2), shield_absl::Nanoseconds(1.5));
+
+  const double dbl_inf = std::numeric_limits<double>::infinity();
+  EXPECT_EQ(shield_absl::InfiniteDuration(), shield_absl::Nanoseconds(dbl_inf));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), shield_absl::Microseconds(dbl_inf));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), shield_absl::Milliseconds(dbl_inf));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), shield_absl::Seconds(dbl_inf));
+  EXPECT_EQ(shield_absl::InfiniteDuration(), shield_absl::Minutes(dbl_inf));
