+using MapTypes = ::testing::Types<
+    shield_absl::node_hash_map<int, int, StatefulTestingHash, StatefulTestingEqual,
+                        Alloc<std::pair<const int, int>>>,
+    shield_absl::node_hash_map<std::string, std::string, StatefulTestingHash,
