+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <string>
+
+#include "shield_absl/base/config.h"
+#include "shield_absl/base/internal/raw_logging.h"
+#include "shield_absl/base/internal/unaligned_access.h"
+#include "shield_absl/strings/ascii.h"
+#include "shield_absl/strings/charset.h"
+#include "shield_absl/strings/internal/escaping.h"
+#include "shield_absl/strings/internal/resize_uninitialized.h"
+#include "shield_absl/strings/internal/utf8.h"
