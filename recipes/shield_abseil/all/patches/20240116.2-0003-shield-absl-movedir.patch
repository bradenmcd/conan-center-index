-// This GenericFind() template function encapsulates the finding algorithm
-// shared between the ByString and ByAnyChar delimiters. The FindPolicy
-// template parameter allows each delimiter to customize the actual find
-// function to use and the length of the found delimiter. For example, the
-// Literal delimiter will ultimately use shield_absl::string_view::find(), and the
-// AnyOf delimiter will use shield_absl::string_view::find_first_of().
-template <typename FindPolicy>
-shield_absl::string_view GenericFind(shield_absl::string_view text,
-                              shield_absl::string_view delimiter, size_t pos,
-                              FindPolicy find_policy) {
-  if (delimiter.empty() && text.length() > 0) {
-    // Special case for empty string delimiters: always return a zero-length
-    // shield_absl::string_view referring to the item at position 1 past pos.
-    return shield_absl::string_view(text.data() + pos + 1, 0);
-  }
-  size_t found_pos = shield_absl::string_view::npos;
-  shield_absl::string_view found(text.data() + text.size(),
-                          0);  // By default, not found
-  found_pos = find_policy.Find(text, delimiter, pos);
-  if (found_pos != shield_absl::string_view::npos) {
-    found = shield_absl::string_view(text.data() + found_pos,
-                              find_policy.Length(delimiter));
-  }
-  return found;
-}
-
-// Finds using shield_absl::string_view::find(), therefore the length of the found
-// delimiter is delimiter.length().
-struct LiteralPolicy {
-  static size_t Find(shield_absl::string_view text, shield_absl::string_view delimiter,
-                     size_t pos) {
-    return text.find(delimiter, pos);
-  }
-  static size_t Length(shield_absl::string_view delimiter) {
-    return delimiter.length();
-  }
-};
-
-// Finds using shield_absl::string_view::find_first_of(), therefore the length of the
-// found delimiter is 1.
-struct AnyOfPolicy {
-  static size_t Find(shield_absl::string_view text, shield_absl::string_view delimiter,
-                     size_t pos) {
-    return text.find_first_of(delimiter, pos);
-  }
-  static size_t Length(shield_absl::string_view /* delimiter */) { return 1; }
-};
-
-}  // namespace
-
-//
-// ByString
-//
-
-ByString::ByString(shield_absl::string_view sp) : delimiter_(sp) {}
-
-shield_absl::string_view ByString::Find(shield_absl::string_view text, size_t pos) const {
-  if (delimiter_.length() == 1) {
-    // Much faster to call find on a single character than on an
-    // shield_absl::string_view.
-    size_t found_pos = text.find(delimiter_[0], pos);
-    if (found_pos == shield_absl::string_view::npos)
-      return shield_absl::string_view(text.data() + text.size(), 0);
-    return text.substr(found_pos, 1);
-  }
-  return GenericFind(text, delimiter_, pos, LiteralPolicy());
-}
-
-shield_absl::string_view ByAsciiWhitespace::Find(shield_absl::string_view text,
-                                          size_t pos) const {
-  return GenericFind(text, " \t\v\f\r\n", pos, AnyOfPolicy());
-}
-
-//
-// ByChar
-//
-
-shield_absl::string_view ByChar::Find(shield_absl::string_view text, size_t pos) const {
-  size_t found_pos = text.find(c_, pos);
-  if (found_pos == shield_absl::string_view::npos)
-    return shield_absl::string_view(text.data() + text.size(), 0);
-  return text.substr(found_pos, 1);
-}
-
-//
-// ByAnyChar
-//
-
-ByAnyChar::ByAnyChar(shield_absl::string_view sp) : delimiters_(sp) {}
-
-shield_absl::string_view ByAnyChar::Find(shield_absl::string_view text, size_t pos) const {
-  return GenericFind(text, delimiters_, pos, AnyOfPolicy());
-}
-
-//
-// ByLength
-//
-ByLength::ByLength(ptrdiff_t length) : length_(length) {
-  ABSL_RAW_CHECK(length > 0, "");
-}
-
-shield_absl::string_view ByLength::Find(shield_absl::string_view text, size_t pos) const {
-  pos = std::min(pos, text.size());  // truncate `pos`
-  shield_absl::string_view substr = text.substr(pos);
-  // If the string is shorter than the chunk size we say we
-  // "can't find the delimiter" so this will be the last chunk.
-  if (substr.length() <= static_cast<size_t>(length_))
-    return shield_absl::string_view(text.data() + text.size(), 0);
-
-  return shield_absl::string_view(substr.data() + length_, 0);
-}
-
-ABSL_NAMESPACE_END
-}  // namespace shield_absl
