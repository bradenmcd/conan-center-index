+template <int N>
+void TestParse(const char* (&in_argv)[N], int int_flag_value,
+               double double_flag_val, shield_absl::string_view string_flag_val,
+               bool bool_flag_val, int exp_position_args = 0) {
+  auto out_args = InvokeParse(in_argv);
+
+  EXPECT_EQ(out_args.size(), 1 + exp_position_args);
+  EXPECT_STREQ(out_args[0], "testbin");
+
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_int_flag), int_flag_value);
+  EXPECT_NEAR(shield_absl::GetFlag(FLAGS_double_flag), double_flag_val, 0.0001);
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_string_flag), string_flag_val);
+  EXPECT_EQ(shield_absl::GetFlag(FLAGS_bool_flag), bool_flag_val);
+}
