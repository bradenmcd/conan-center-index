+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#else  // ABSL_USES_STD_ANY
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+// -----------------------------------------------------------------------------
+// bad_any_cast
+// -----------------------------------------------------------------------------
+//
+// An `shield_absl::bad_any_cast` type is an exception type that is thrown when
+// failing to successfully cast the return value of an `shield_absl::any` object.
+//
+// Example:
+//
+//   auto a = shield_absl::any(65);
+//   shield_absl::any_cast<int>(a);         // 65
+//   try {
+//     shield_absl::any_cast<char>(a);
+//   } catch(const shield_absl::bad_any_cast& e) {
+//     std::cout << "Bad any cast: " << e.what() << '\n';
+//   }
+class bad_any_cast : public std::bad_cast {
+ public:
+  ~bad_any_cast() override;
+  const char* what() const noexcept override;
+};
+
+namespace any_internal {
+
+[[noreturn]] void ThrowBadAnyCast();
+
+}  // namespace any_internal
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#endif  // ABSL_USES_STD_ANY
+
+#endif  // ABSL_TYPES_BAD_ANY_CAST_H_
