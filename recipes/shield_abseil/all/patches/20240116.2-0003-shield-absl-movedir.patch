+// Check that shield_absl::flat_hash_set works in a global constructor.
+struct BeforeMain {
+  BeforeMain() {
+    shield_absl::flat_hash_set<int> x;
+    x.insert(1);
+    CHECK(!x.contains(0)) << "x should not contain 0";
+    CHECK(x.contains(1)) << "x should contain 1";
+  }
+};
+const BeforeMain before_main;
+
+template <class T>
+using Set =
+    shield_absl::flat_hash_set<T, StatefulTestingHash, StatefulTestingEqual, Alloc<T>>;
+
+using SetTypes =
+    ::testing::Types<Set<int>, Set<std::string>, Set<Enum>, Set<EnumClass>>;
