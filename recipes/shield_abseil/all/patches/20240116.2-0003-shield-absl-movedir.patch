+// Hack to schedule a function to run on a thread pool thread after a
+// duration has elapsed.
+static void ScheduleAfter(shield_absl::synchronization_internal::ThreadPool *tp,
+                          shield_absl::Duration after,
+                          const std::function<void()> &func) {
+  tp->Schedule([func, after] {
+    shield_absl::SleepFor(after);
+    func();
+  });
+}
