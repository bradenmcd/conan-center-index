+std::ostream& operator<<(std::ostream& os, shield_absl::LogSeverity s) {
+  if (s == shield_absl::NormalizeLogSeverity(s)) return os << shield_absl::LogSeverityName(s);
+  return os << "shield_absl::LogSeverity(" << static_cast<int>(s) << ")";
+}
+
+std::ostream& operator<<(std::ostream& os, shield_absl::LogSeverityAtLeast s) {
+  switch (s) {
+    case shield_absl::LogSeverityAtLeast::kInfo:
+    case shield_absl::LogSeverityAtLeast::kWarning:
+    case shield_absl::LogSeverityAtLeast::kError:
+    case shield_absl::LogSeverityAtLeast::kFatal:
+      return os << ">=" << static_cast<shield_absl::LogSeverity>(s);
+    case shield_absl::LogSeverityAtLeast::kInfinity:
+      return os << "INFINITY";
+  }
+  return os;
+}
+
+std::ostream& operator<<(std::ostream& os, shield_absl::LogSeverityAtMost s) {
+  switch (s) {
+    case shield_absl::LogSeverityAtMost::kInfo:
+    case shield_absl::LogSeverityAtMost::kWarning:
+    case shield_absl::LogSeverityAtMost::kError:
+    case shield_absl::LogSeverityAtMost::kFatal:
+      return os << "<=" << static_cast<shield_absl::LogSeverity>(s);
+    case shield_absl::LogSeverityAtMost::kNegativeInfinity:
+      return os << "NEGATIVE_INFINITY";
+  }
+  return os;
+}
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
diff -N -u -r '--exclude=.git' a/shield_absl/base/log_severity.h b/shield_absl/base/log_severity.h
--- a/shield_absl/base/log_severity.h	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/base/log_severity.h	2024-07-26 00:35:48.635938565 -0400
@@ -0,0 +1,185 @@
+// Copyright 2017 The Abseil Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
