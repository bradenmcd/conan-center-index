+#else  // ABSL_USES_STD_VARIANT
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+// -----------------------------------------------------------------------------
+// bad_variant_access
+// -----------------------------------------------------------------------------
+//
+// An `shield_absl::bad_variant_access` type is an exception type that is thrown in
+// the following cases:
+//
+//   * Calling `shield_absl::get(shield_absl::variant) with an index or type that does not
+//     match the currently selected alternative type
+//   * Calling `shield_absl::visit on an `shield_absl::variant` that is in the
+//     `variant::valueless_by_exception` state.
+//
+// Example:
+//
+//   shield_absl::variant<int, std::string> v;
+//   v = 1;
+//   try {
+//     shield_absl::get<std::string>(v);
+//   } catch(const shield_absl::bad_variant_access& e) {
+//     std::cout << "Bad variant access: " << e.what() << '\n';
+//   }
+class bad_variant_access : public std::exception {
+ public:
+  bad_variant_access() noexcept = default;
+  ~bad_variant_access() override;
+  const char* what() const noexcept override;
+};
+
+namespace variant_internal {
+
+[[noreturn]] ABSL_DLL void ThrowBadVariantAccess();
+[[noreturn]] ABSL_DLL void Rethrow();
+
+}  // namespace variant_internal
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
+
+#endif  // ABSL_USES_STD_VARIANT
+
+#endif  // ABSL_TYPES_BAD_VARIANT_ACCESS_H_
