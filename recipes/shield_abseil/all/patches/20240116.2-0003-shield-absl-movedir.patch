+TEST(Duration, InfinityIDiv) {
+  const shield_absl::Duration sec_max = shield_absl::Seconds(kint64max);
+  const shield_absl::Duration any_dur = shield_absl::Seconds(1);
+  const shield_absl::Duration inf = shield_absl::InfiniteDuration();
+  const double dbl_inf = std::numeric_limits<double>::infinity();
+
+  // IDivDuration (int64_t return value + a remainer)
+  shield_absl::Duration rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64max, shield_absl::IDivDuration(inf, inf, &rem));
+  EXPECT_EQ(inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64max, shield_absl::IDivDuration(-inf, -inf, &rem));
+  EXPECT_EQ(-inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64max, shield_absl::IDivDuration(inf, any_dur, &rem));
+  EXPECT_EQ(inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(0, shield_absl::IDivDuration(any_dur, inf, &rem));
+  EXPECT_EQ(any_dur, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64max, shield_absl::IDivDuration(-inf, -any_dur, &rem));
+  EXPECT_EQ(-inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(0, shield_absl::IDivDuration(-any_dur, -inf, &rem));
+  EXPECT_EQ(-any_dur, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64min, shield_absl::IDivDuration(-inf, inf, &rem));
+  EXPECT_EQ(-inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64min, shield_absl::IDivDuration(inf, -inf, &rem));
+  EXPECT_EQ(inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64min, shield_absl::IDivDuration(-inf, any_dur, &rem));
+  EXPECT_EQ(-inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(0, shield_absl::IDivDuration(-any_dur, inf, &rem));
+  EXPECT_EQ(-any_dur, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(kint64min, shield_absl::IDivDuration(inf, -any_dur, &rem));
+  EXPECT_EQ(inf, rem);
+
+  rem = shield_absl::ZeroDuration();
+  EXPECT_EQ(0, shield_absl::IDivDuration(any_dur, -inf, &rem));
+  EXPECT_EQ(any_dur, rem);
+
+  // IDivDuration overflow/underflow
+  rem = any_dur;
+  EXPECT_EQ(kint64max,
+            shield_absl::IDivDuration(sec_max, shield_absl::Nanoseconds(1) / 4, &rem));
+  EXPECT_EQ(sec_max - shield_absl::Nanoseconds(kint64max) / 4, rem);
+
+  rem = any_dur;
+  EXPECT_EQ(kint64max,
+            shield_absl::IDivDuration(sec_max, shield_absl::Milliseconds(1), &rem));
+  EXPECT_EQ(sec_max - shield_absl::Milliseconds(kint64max), rem);
+
+  rem = any_dur;
+  EXPECT_EQ(kint64max,
+            shield_absl::IDivDuration(-sec_max, -shield_absl::Milliseconds(1), &rem));
+  EXPECT_EQ(-sec_max + shield_absl::Milliseconds(kint64max), rem);
+
+  rem = any_dur;
+  EXPECT_EQ(kint64min,
+            shield_absl::IDivDuration(-sec_max, shield_absl::Milliseconds(1), &rem));
+  EXPECT_EQ(-sec_max - shield_absl::Milliseconds(kint64min), rem);
+
+  rem = any_dur;
+  EXPECT_EQ(kint64min,
+            shield_absl::IDivDuration(sec_max, -shield_absl::Milliseconds(1), &rem));
+  EXPECT_EQ(sec_max + shield_absl::Milliseconds(kint64min), rem);
+
+  //
+  // operator/(Duration, Duration) is a wrapper for IDivDuration().
+  //
+
+  // IEEE 754 says inf / inf should be nan, but int64_t doesn't have
+  // nan so we'll return kint64max/kint64min instead.
+  EXPECT_TRUE(std::isnan(dbl_inf / dbl_inf));
+  EXPECT_EQ(kint64max, inf / inf);
+  EXPECT_EQ(kint64max, -inf / -inf);
+  EXPECT_EQ(kint64min, -inf / inf);
+  EXPECT_EQ(kint64min, inf / -inf);
+
+  EXPECT_TRUE(std::isinf(dbl_inf / 2.0));
+  EXPECT_EQ(kint64max, inf / any_dur);
+  EXPECT_EQ(kint64max, -inf / -any_dur);
+  EXPECT_EQ(kint64min, -inf / any_dur);
+  EXPECT_EQ(kint64min, inf / -any_dur);
+
+  EXPECT_EQ(0.0, 2.0 / dbl_inf);
+  EXPECT_EQ(0, any_dur / inf);
+  EXPECT_EQ(0, any_dur / -inf);
+  EXPECT_EQ(0, -any_dur / inf);
+  EXPECT_EQ(0, -any_dur / -inf);
+  EXPECT_EQ(0, shield_absl::ZeroDuration() / inf);
+
+  // Division of Duration by a Duration overflow/underflow
+  EXPECT_EQ(kint64max, sec_max / shield_absl::Milliseconds(1));
+  EXPECT_EQ(kint64max, -sec_max / -shield_absl::Milliseconds(1));
+  EXPECT_EQ(kint64min, -sec_max / shield_absl::Milliseconds(1));
+  EXPECT_EQ(kint64min, sec_max / -shield_absl::Milliseconds(1));
+}
