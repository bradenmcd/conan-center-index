+// Splice block into cord.
+shield_absl::Cord SpliceCord(const shield_absl::Cord& blob, int64_t offset,
+                      const shield_absl::Cord& block) {
+  CHECK_GE(offset, 0);
+  CHECK_LE(static_cast<size_t>(offset) + block.size(), blob.size());
+  shield_absl::Cord result(blob);
+  result.RemoveSuffix(blob.size() - offset);
+  result.Append(block);
+  shield_absl::Cord suffix(blob);
+  suffix.RemovePrefix(offset + block.size());
+  result.Append(suffix);
+  CHECK_EQ(blob.size(), result.size());
+  return result;
+}
