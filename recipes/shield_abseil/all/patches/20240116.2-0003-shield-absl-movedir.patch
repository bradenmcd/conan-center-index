+  // SimpleHexAtoi(shield_absl::string_view, shield_absl::uint128)
+  VerifySimpleHexAtoiGood<shield_absl::uint128>(0, 0);
+  VerifySimpleHexAtoiGood<shield_absl::uint128>(0x42, 0x42);
+  VerifySimpleHexAtoiBad<shield_absl::uint128>(-0x42);
+
+  VerifySimpleHexAtoiBad<shield_absl::uint128>(std::numeric_limits<int32_t>::min());
+  VerifySimpleHexAtoiGood<shield_absl::uint128>(std::numeric_limits<int32_t>::max(),
