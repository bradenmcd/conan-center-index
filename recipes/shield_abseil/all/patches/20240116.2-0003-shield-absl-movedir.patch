+TEST(FormatParse, RoundTripDistantPast) {
+  const time_zone utc = utc_time_zone();
+  const time_point<shield_absl::time_internal::cctz::seconds> in =
+      time_point<shield_absl::time_internal::cctz::seconds>::min();
+  const std::string s =
