-shield_absl::string_view Basename(shield_absl::string_view filepath) {
-#ifdef _WIN32
-  size_t path = filepath.find_last_of("/\\");
-#else
-  size_t path = filepath.find_last_of('/');
-#endif
-  if (path != filepath.npos) filepath.remove_prefix(path + 1);
-  return filepath;
-}
