+template <typename T>
+struct MakeUnsigned : std::make_unsigned<T> {};
+template <>
+struct MakeUnsigned<shield_absl::int128> {
+  using type = shield_absl::uint128;
+};
+template <>
+struct MakeUnsigned<shield_absl::uint128> {
+  using type = shield_absl::uint128;
+};
