-TEST(Duration, ToChrono) {
-  using std::chrono::nanoseconds;
-  using std::chrono::microseconds;
-  using std::chrono::milliseconds;
-  using std::chrono::seconds;
-  using std::chrono::minutes;
-  using std::chrono::hours;
-
-  TestToChrono<kint64min>();
-  TestToChrono<-1>();
-  TestToChrono<0>();
-  TestToChrono<1>();
-  TestToChrono<kint64max>();
-
-  // Verify truncation toward zero.
-  const auto tick = shield_absl::Nanoseconds(1) / 4;
-  EXPECT_EQ(nanoseconds(0), shield_absl::ToChronoNanoseconds(tick));
-  EXPECT_EQ(nanoseconds(0), shield_absl::ToChronoNanoseconds(-tick));
-  EXPECT_EQ(microseconds(0), shield_absl::ToChronoMicroseconds(tick));
-  EXPECT_EQ(microseconds(0), shield_absl::ToChronoMicroseconds(-tick));
-  EXPECT_EQ(milliseconds(0), shield_absl::ToChronoMilliseconds(tick));
-  EXPECT_EQ(milliseconds(0), shield_absl::ToChronoMilliseconds(-tick));
-  EXPECT_EQ(seconds(0), shield_absl::ToChronoSeconds(tick));
-  EXPECT_EQ(seconds(0), shield_absl::ToChronoSeconds(-tick));
-  EXPECT_EQ(minutes(0), shield_absl::ToChronoMinutes(tick));
-  EXPECT_EQ(minutes(0), shield_absl::ToChronoMinutes(-tick));
-  EXPECT_EQ(hours(0), shield_absl::ToChronoHours(tick));
-  EXPECT_EQ(hours(0), shield_absl::ToChronoHours(-tick));
-
-  // Verifies +/- infinity saturation at max/min.
-  constexpr auto inf = shield_absl::InfiniteDuration();
-  EXPECT_EQ(nanoseconds::min(), shield_absl::ToChronoNanoseconds(-inf));
-  EXPECT_EQ(nanoseconds::max(), shield_absl::ToChronoNanoseconds(inf));
-  EXPECT_EQ(microseconds::min(), shield_absl::ToChronoMicroseconds(-inf));
-  EXPECT_EQ(microseconds::max(), shield_absl::ToChronoMicroseconds(inf));
-  EXPECT_EQ(milliseconds::min(), shield_absl::ToChronoMilliseconds(-inf));
-  EXPECT_EQ(milliseconds::max(), shield_absl::ToChronoMilliseconds(inf));
-  EXPECT_EQ(seconds::min(), shield_absl::ToChronoSeconds(-inf));
-  EXPECT_EQ(seconds::max(), shield_absl::ToChronoSeconds(inf));
-  EXPECT_EQ(minutes::min(), shield_absl::ToChronoMinutes(-inf));
-  EXPECT_EQ(minutes::max(), shield_absl::ToChronoMinutes(inf));
-  EXPECT_EQ(hours::min(), shield_absl::ToChronoHours(-inf));
-  EXPECT_EQ(hours::max(), shield_absl::ToChronoHours(inf));
