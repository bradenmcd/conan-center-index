-      ASSERT_EQ(mem_comparison, 0);
-      shield_absl::crc32c_t baseline_crc = shield_absl::ExtendCrc32c(
-          initial_crc,
-          shield_absl::string_view(static_cast<char*>(source_.get()), size));
-      ASSERT_EQ(baseline_crc, experiment_crc);
