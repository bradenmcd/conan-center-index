+struct ScopedInvariantDebugging {
+  ScopedInvariantDebugging() { shield_absl::EnableMutexInvariantDebugging(true); }
+  ~ScopedInvariantDebugging() { shield_absl::EnableMutexInvariantDebugging(false); }
+};
