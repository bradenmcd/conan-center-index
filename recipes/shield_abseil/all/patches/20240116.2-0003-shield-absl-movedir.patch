+  const shield_absl::Duration sec_max = shield_absl::Seconds(kint64max);
+  const shield_absl::Duration sec_min = shield_absl::Seconds(kint64min);
+  const shield_absl::Duration inf = shield_absl::InfiniteDuration();
+
+  // Division of Duration by a double
+#define TEST_INF_DIV_WITH_TYPE(T)            \
+  EXPECT_EQ(inf, inf / static_cast<T>(2));   \
+  EXPECT_EQ(-inf, inf / static_cast<T>(-2)); \
+  EXPECT_EQ(-inf, -inf / static_cast<T>(2)); \
+  EXPECT_EQ(inf, -inf / static_cast<T>(-2));
+
+  TEST_INF_DIV_WITH_TYPE(int64_t);  // NOLINT(readability/function)
+  TEST_INF_DIV_WITH_TYPE(double);   // NOLINT(readability/function)
+
+#undef TEST_INF_DIV_WITH_TYPE
+
+  // Division of Duration by a double overflow/underflow
+  EXPECT_EQ(inf, sec_max / 0.5);
+  EXPECT_EQ(inf, sec_min / -0.5);
+  EXPECT_EQ(inf, ((sec_max / 0.5) + shield_absl::Seconds(1)) / 0.5);
+  EXPECT_EQ(-inf, sec_max / -0.5);
+  EXPECT_EQ(-inf, sec_min / 0.5);
+  EXPECT_EQ(-inf, ((sec_min / 0.5) - shield_absl::Seconds(1)) / 0.5);
+
+  const double dbl_inf = std::numeric_limits<double>::infinity();
+  EXPECT_EQ(inf, inf / dbl_inf);
+  EXPECT_EQ(-inf, inf / -dbl_inf);
+  EXPECT_EQ(-inf, -inf / dbl_inf);
+  EXPECT_EQ(inf, -inf / -dbl_inf);
+
+  const shield_absl::Duration any_dur = shield_absl::Seconds(1);
+  EXPECT_EQ(shield_absl::ZeroDuration(), any_dur / dbl_inf);
+  EXPECT_EQ(shield_absl::ZeroDuration(), any_dur / -dbl_inf);
+  EXPECT_EQ(shield_absl::ZeroDuration(), -any_dur / dbl_inf);
+  EXPECT_EQ(shield_absl::ZeroDuration(), -any_dur / -dbl_inf);
+}
