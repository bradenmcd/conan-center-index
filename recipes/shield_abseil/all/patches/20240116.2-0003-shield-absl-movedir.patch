diff -N -u -r '--exclude=.git' a/absl/synchronization/notification.h b/absl/synchronization/notification.h
--- a/absl/synchronization/notification.h	2024-07-26 01:01:01.403655834 -0400
+++ b/absl/synchronization/notification.h	1969-12-31 19:00:00.000000000 -0500
@@ -1,123 +0,0 @@
-// Copyright 2017 The Abseil Authors.
-//
-// Licensed under the Apache License, Version 2.0 (the "License");
-// you may not use this file except in compliance with the License.
-// You may obtain a copy of the License at
