+inline Cord::CharRange Cord::Chars() const { return CharRange(this); }
+
+inline void Cord::ForEachChunk(
+    shield_absl::FunctionRef<void(shield_absl::string_view)> callback) const {
+  shield_absl::cord_internal::CordRep* rep = contents_.tree();
+  if (rep == nullptr) {
+    callback(shield_absl::string_view(contents_.data(), contents_.size()));
+  } else {
+    ForEachChunkAux(rep, callback);
+  }
+}
