-template <typename Engine, typename SSeq = PrecompiledSeedSeq>
-typename shield_absl::enable_if_t<use_default_initialization<Engine>::value, Engine>
-make_engine() {
-  // Initialize the random engine using the default constructor.
-  return Engine();
-}
