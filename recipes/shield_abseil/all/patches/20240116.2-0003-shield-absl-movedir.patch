-template <EdgeType edge_type>
-inline shield_absl::string_view Consume(shield_absl::string_view s, size_t n) {
-  return edge_type == kBack ? s.substr(n) : s.substr(0, s.size() - n);
-}
-
-template <EdgeType edge_type>
-inline shield_absl::string_view Consume(char* dst, shield_absl::string_view s, size_t n) {
-  if (edge_type == kBack) {
-    memcpy(dst, s.data(), n);
-    return s.substr(n);
-  } else {
-    const size_t offset = s.size() - n;
-    memcpy(dst, s.data() + offset, n);
-    return s.substr(0, offset);
-  }
-}
