+TEST(Time, AdditiveOperators) {
+  const shield_absl::Duration d = shield_absl::Nanoseconds(1);
+  const shield_absl::Time t0;
+  const shield_absl::Time t1 = t0 + d;
+
+  EXPECT_EQ(d, t1 - t0);
+  EXPECT_EQ(-d, t0 - t1);
+  EXPECT_EQ(t0, t1 - d);
+
+  shield_absl::Time t(t0);
+  EXPECT_EQ(t0, t);
+  t += d;
+  EXPECT_EQ(t0 + d, t);
+  EXPECT_EQ(d, t - t0);
+  t -= d;
+  EXPECT_EQ(t0, t);
+
+  // Tests overflow between subseconds and seconds.
+  t = shield_absl::UnixEpoch();
+  t += shield_absl::Milliseconds(500);
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Milliseconds(500), t);
+  t += shield_absl::Milliseconds(600);
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Milliseconds(1100), t);
+  t -= shield_absl::Milliseconds(600);
+  EXPECT_EQ(shield_absl::UnixEpoch() + shield_absl::Milliseconds(500), t);
+  t -= shield_absl::Milliseconds(500);
+  EXPECT_EQ(shield_absl::UnixEpoch(), t);
+}
