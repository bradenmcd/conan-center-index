+TEST(Duration, ConstExpr) {
+  constexpr shield_absl::Duration d0 = shield_absl::ZeroDuration();
+  static_assert(d0 == shield_absl::ZeroDuration(), "ZeroDuration()");
+  constexpr shield_absl::Duration d1 = shield_absl::Seconds(1);
+  static_assert(d1 == shield_absl::Seconds(1), "Seconds(1)");
+  static_assert(d1 != shield_absl::ZeroDuration(), "Seconds(1)");
+  constexpr shield_absl::Duration d2 = shield_absl::InfiniteDuration();
+  static_assert(d2 == shield_absl::InfiniteDuration(), "InfiniteDuration()");
+  static_assert(d2 != shield_absl::ZeroDuration(), "InfiniteDuration()");
+}
+
+TEST(Duration, ValueSemantics) {
+  // If this compiles, the test passes.
+  constexpr shield_absl::Duration a;      // Default construction
+  constexpr shield_absl::Duration b = a;  // Copy construction
+  constexpr shield_absl::Duration c(b);   // Copy construction (again)
+
+  shield_absl::Duration d;
+  d = c;  // Assignment
+}
