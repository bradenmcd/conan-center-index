-template <typename P>
-void btree<P>::clear() {
-  if (!empty()) {
-    node_type::clear_and_delete(root(), mutable_allocator());
-  }
-  mutable_root() = mutable_rightmost() = EmptyNode();
-  size_ = 0;
-}
