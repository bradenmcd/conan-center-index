+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "shield_absl/strings/match.h"
+
+#include <algorithm>
+#include <cstdint>
+
+#include "shield_absl/base/config.h"
+#include "shield_absl/base/internal/endian.h"
+#include "shield_absl/base/optimization.h"
+#include "shield_absl/numeric/bits.h"
+#include "shield_absl/strings/ascii.h"
+#include "shield_absl/strings/internal/memutil.h"
+#include "shield_absl/strings/string_view.h"
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+bool EqualsIgnoreCase(shield_absl::string_view piece1,
+                      shield_absl::string_view piece2) noexcept {
+  return (piece1.size() == piece2.size() &&
+          0 == shield_absl::strings_internal::memcasecmp(piece1.data(), piece2.data(),
+                                                  piece1.size()));
+  // memcasecmp uses shield_absl::ascii_tolower().
+}
+
+bool StrContainsIgnoreCase(shield_absl::string_view haystack,
+                           shield_absl::string_view needle) noexcept {
+  while (haystack.size() >= needle.size()) {
+    if (StartsWithIgnoreCase(haystack, needle)) return true;
+    haystack.remove_prefix(1);
+  }
+  return false;
+}
+
+bool StrContainsIgnoreCase(shield_absl::string_view haystack,
+                           char needle) noexcept {
+  char upper_needle = shield_absl::ascii_toupper(static_cast<unsigned char>(needle));
+  char lower_needle = shield_absl::ascii_tolower(static_cast<unsigned char>(needle));
+  if (upper_needle == lower_needle) {
+    return StrContains(haystack, needle);
+  } else {
+    const char both_cstr[3] = {lower_needle, upper_needle, '\0'};
+    return haystack.find_first_of(both_cstr) != shield_absl::string_view::npos;
+  }
+}
+
+bool StartsWithIgnoreCase(shield_absl::string_view text,
+                          shield_absl::string_view prefix) noexcept {
+  return (text.size() >= prefix.size()) &&
+         EqualsIgnoreCase(text.substr(0, prefix.size()), prefix);
+}
+
+bool EndsWithIgnoreCase(shield_absl::string_view text,
+                        shield_absl::string_view suffix) noexcept {
+  return (text.size() >= suffix.size()) &&
+         EqualsIgnoreCase(text.substr(text.size() - suffix.size()), suffix);
+}
+
+shield_absl::string_view FindLongestCommonPrefix(shield_absl::string_view a,
+                                          shield_absl::string_view b) {
+  const shield_absl::string_view::size_type limit = std::min(a.size(), b.size());
+  const char* const pa = a.data();
+  const char* const pb = b.data();
+  shield_absl::string_view::size_type count = (unsigned) 0;
+
+  if (ABSL_PREDICT_FALSE(limit < 8)) {
+    while (ABSL_PREDICT_TRUE(count + 2 <= limit)) {
+      uint16_t xor_bytes = shield_absl::little_endian::Load16(pa + count) ^
+                           shield_absl::little_endian::Load16(pb + count);
+      if (ABSL_PREDICT_FALSE(xor_bytes != 0)) {
+        if (ABSL_PREDICT_TRUE((xor_bytes & 0xff) == 0)) ++count;
+        return shield_absl::string_view(pa, count);
+      }
+      count += 2;
+    }
+    if (ABSL_PREDICT_TRUE(count != limit)) {
+      if (ABSL_PREDICT_TRUE(pa[count] == pb[count])) ++count;
+    }
+    return shield_absl::string_view(pa, count);
+  }
+
+  do {
+    uint64_t xor_bytes = shield_absl::little_endian::Load64(pa + count) ^
+                         shield_absl::little_endian::Load64(pb + count);
+    if (ABSL_PREDICT_FALSE(xor_bytes != 0)) {
+      count += static_cast<uint64_t>(shield_absl::countr_zero(xor_bytes) >> 3);
+      return shield_absl::string_view(pa, count);
+    }
+    count += 8;
+  } while (ABSL_PREDICT_TRUE(count + 8 < limit));
+
+  count = limit - 8;
+  uint64_t xor_bytes = shield_absl::little_endian::Load64(pa + count) ^
+                       shield_absl::little_endian::Load64(pb + count);
+  if (ABSL_PREDICT_TRUE(xor_bytes != 0)) {
+    count += static_cast<uint64_t>(shield_absl::countr_zero(xor_bytes) >> 3);
+    return shield_absl::string_view(pa, count);
+  }
+  return shield_absl::string_view(pa, limit);
+}
+
+shield_absl::string_view FindLongestCommonSuffix(shield_absl::string_view a,
+                                          shield_absl::string_view b) {
+  const shield_absl::string_view::size_type limit = std::min(a.size(), b.size());
+  if (limit == 0) return shield_absl::string_view();
+
+  const char* pa = a.data() + a.size() - 1;
+  const char* pb = b.data() + b.size() - 1;
+  shield_absl::string_view::size_type count = (unsigned) 0;
+  while (count < limit && *pa == *pb) {
+    --pa;
+    --pb;
+    ++count;
+  }
+
+  return shield_absl::string_view(++pa, count);
+}
+
+ABSL_NAMESPACE_END
+}  // namespace shield_absl
diff -N -u -r '--exclude=.git' a/shield_absl/strings/match.h b/shield_absl/strings/match.h
--- a/shield_absl/strings/match.h	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/strings/match.h	2024-07-26 00:35:48.663938631 -0400
@@ -0,0 +1,119 @@
+//
