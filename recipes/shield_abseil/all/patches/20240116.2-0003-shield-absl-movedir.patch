+TEST(StatusOr, EqualityOperator) {
+  constexpr size_t kNumCases = 4;
+  std::array<shield_absl::StatusOr<int>, kNumCases> group1 = {
+      shield_absl::StatusOr<int>(1), shield_absl::StatusOr<int>(2),
+      shield_absl::StatusOr<int>(shield_absl::InvalidArgumentError("msg")),
+      shield_absl::StatusOr<int>(shield_absl::InternalError("msg"))};
+  std::array<shield_absl::StatusOr<int>, kNumCases> group2 = {
+      shield_absl::StatusOr<int>(1), shield_absl::StatusOr<int>(2),
+      shield_absl::StatusOr<int>(shield_absl::InvalidArgumentError("msg")),
+      shield_absl::StatusOr<int>(shield_absl::InternalError("msg"))};
+  for (size_t i = 0; i < kNumCases; ++i) {
+    for (size_t j = 0; j < kNumCases; ++j) {
+      if (i == j) {
+        EXPECT_TRUE(group1[i] == group2[j]);
+        EXPECT_FALSE(group1[i] != group2[j]);
+      } else {
+        EXPECT_FALSE(group1[i] == group2[j]);
+        EXPECT_TRUE(group1[i] != group2[j]);
+      }
+    }
+  }
+}
