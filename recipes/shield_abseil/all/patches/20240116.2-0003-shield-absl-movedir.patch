+TEST(optionalTest, Hash) {
+  std::hash<shield_absl::optional<int>> hash;
+  std::set<size_t> hashcodes;
+  hashcodes.insert(hash(shield_absl::nullopt));
+  for (int i = 0; i < 100; ++i) {
+    hashcodes.insert(hash(i));
+  }
+  EXPECT_GT(hashcodes.size(), 90u);
+
+  static_assert(is_hash_enabled_for<shield_absl::optional<int>>::value, "");
+  static_assert(is_hash_enabled_for<shield_absl::optional<Hashable>>::value, "");
+  static_assert(
+      shield_absl::type_traits_internal::IsHashable<shield_absl::optional<int>>::value, "");
+  static_assert(
+      shield_absl::type_traits_internal::IsHashable<shield_absl::optional<Hashable>>::value,
+      "");
+  shield_absl::type_traits_internal::AssertHashEnabled<shield_absl::optional<int>>();
+  shield_absl::type_traits_internal::AssertHashEnabled<shield_absl::optional<Hashable>>();
+
+#if ABSL_META_INTERNAL_STD_HASH_SFINAE_FRIENDLY_
+  static_assert(!is_hash_enabled_for<shield_absl::optional<NonHashable>>::value, "");
+  static_assert(!shield_absl::type_traits_internal::IsHashable<
+                    shield_absl::optional<NonHashable>>::value,
+                "");
+#endif
+
+  // libstdc++ std::optional is missing remove_const_t, i.e. it's using
+  // std::hash<T> rather than std::hash<std::remove_const_t<T>>.
+  // Reference: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=82262
+#ifndef __GLIBCXX__
+  static_assert(is_hash_enabled_for<shield_absl::optional<const int>>::value, "");
+  static_assert(is_hash_enabled_for<shield_absl::optional<const Hashable>>::value, "");
+  std::hash<shield_absl::optional<const int>> c_hash;
+  for (int i = 0; i < 100; ++i) {
+    EXPECT_EQ(hash(i), c_hash(i));
+  }
+#endif
+}
