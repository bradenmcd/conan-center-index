-  cordz_set_next_sample_for_testing(0);
-  EXPECT_FALSE(cordz_should_profile());
-
-  set_cordz_mean_interval(orig_sample_rate);
-}
-
-#endif  // ABSL_INTERNAL_CORDZ_ENABLED
