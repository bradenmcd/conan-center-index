-template <class T>
-struct Wrapper {
-  template <class U,
-            class = shield_absl::enable_if_t<std::is_convertible<U, T>::value>>
-  Wrapper(U&&);  // NOLINT
-};
-
-// This will cause a recursive trait instantiation if the SFINAE checks are
-// not ordered correctly for constructibility.
-static_assert(std::is_constructible<Wrapper<shield_absl::AnyInvocable<void()>>,
-                                    Wrapper<shield_absl::AnyInvocable<void()>>>::value,
-              "");
