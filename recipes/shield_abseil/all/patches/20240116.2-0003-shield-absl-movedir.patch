--- a/shield_absl/random/bernoulli_distribution.h	1969-12-31 19:00:00.000000000 -0500
+++ b/shield_absl/random/bernoulli_distribution.h	2024-07-26 00:35:48.711938745 -0400
@@ -0,0 +1,200 @@
+// Copyright 2017 The Abseil Authors.
