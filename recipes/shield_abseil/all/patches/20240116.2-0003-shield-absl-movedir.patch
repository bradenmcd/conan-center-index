+TEST(MockDistributions, Examples) {
+  shield_absl::MockingBitGen gen;
+
+  EXPECT_NE(shield_absl::Uniform<int>(gen, 1, 1000000), 20);
+  EXPECT_CALL(shield_absl::MockUniform<int>(), Call(gen, 1, 1000000))
+      .WillOnce(Return(20));
+  EXPECT_EQ(shield_absl::Uniform<int>(gen, 1, 1000000), 20);
+
+  EXPECT_NE(shield_absl::Uniform<double>(gen, 0.0, 100.0), 5.0);
+  EXPECT_CALL(shield_absl::MockUniform<double>(), Call(gen, 0.0, 100.0))
+      .WillOnce(Return(5.0));
+  EXPECT_EQ(shield_absl::Uniform<double>(gen, 0.0, 100.0), 5.0);
+
+  EXPECT_NE(shield_absl::Exponential<double>(gen, 1.0), 42);
+  EXPECT_CALL(shield_absl::MockExponential<double>(), Call(gen, 1.0))
+      .WillOnce(Return(42));
+  EXPECT_EQ(shield_absl::Exponential<double>(gen, 1.0), 42);
+
+  EXPECT_NE(shield_absl::Poisson<int>(gen, 1.0), 500);
+  EXPECT_CALL(shield_absl::MockPoisson<int>(), Call(gen, 1.0)).WillOnce(Return(500));
+  EXPECT_EQ(shield_absl::Poisson<int>(gen, 1.0), 500);
+
+  EXPECT_NE(shield_absl::Bernoulli(gen, 0.000001), true);
+  EXPECT_CALL(shield_absl::MockBernoulli(), Call(gen, 0.000001))
+      .WillOnce(Return(true));
+  EXPECT_EQ(shield_absl::Bernoulli(gen, 0.000001), true);
+
+  EXPECT_NE(shield_absl::Beta<double>(gen, 3.0, 2.0), 0.567);
+  EXPECT_CALL(shield_absl::MockBeta<double>(), Call(gen, 3.0, 2.0))
+      .WillOnce(Return(0.567));
+  EXPECT_EQ(shield_absl::Beta<double>(gen, 3.0, 2.0), 0.567);
+
+  EXPECT_NE(shield_absl::Zipf<int>(gen, 1000000, 2.0, 1.0), 1221);
+  EXPECT_CALL(shield_absl::MockZipf<int>(), Call(gen, 1000000, 2.0, 1.0))
+      .WillOnce(Return(1221));
+  EXPECT_EQ(shield_absl::Zipf<int>(gen, 1000000, 2.0, 1.0), 1221);
+
+  EXPECT_NE(shield_absl::Gaussian<double>(gen, 0.0, 1.0), 0.001);
+  EXPECT_CALL(shield_absl::MockGaussian<double>(), Call(gen, 0.0, 1.0))
+      .WillOnce(Return(0.001));
+  EXPECT_EQ(shield_absl::Gaussian<double>(gen, 0.0, 1.0), 0.001);
+
+  EXPECT_NE(shield_absl::LogUniform<int>(gen, 0, 1000000, 2), 2040);
+  EXPECT_CALL(shield_absl::MockLogUniform<int>(), Call(gen, 0, 1000000, 2))
+      .WillOnce(Return(2040));
+  EXPECT_EQ(shield_absl::LogUniform<int>(gen, 0, 1000000, 2), 2040);
+}
