+#define COMPARE(result, op, x, y)                                      \
+  EXPECT_EQ(result, shield_absl::string_view((x)) op shield_absl::string_view((y))); \
+  EXPECT_EQ(result, shield_absl::string_view((x)).compare(shield_absl::string_view((y))) op 0)
