+  const std::string huge = std::string(5000, 'a');   // not a multiple
+
+  EXPECT_TRUE(shield_absl::VerifyTypeImplementsAbslHashCorrectly(std::make_tuple(  //
+      std::string(), shield_absl::string_view(), shield_absl::Cord(),                     //
+      std::string(""), shield_absl::string_view(""), shield_absl::Cord(""),               //
+      std::string(small), shield_absl::string_view(small), shield_absl::Cord(small),      //
+      std::string(dup), shield_absl::string_view(dup), shield_absl::Cord(dup),            //
+      std::string(large), shield_absl::string_view(large), shield_absl::Cord(large),      //
+      std::string(huge), shield_absl::string_view(huge), FlatCord(huge),           //
+      FragmentedCord(huge))));
+
+  // Also check that nested types maintain the same hash.
+  const WrapInTuple t{};
+  EXPECT_TRUE(shield_absl::VerifyTypeImplementsAbslHashCorrectly(std::make_tuple(  //
+      t(std::string()), t(shield_absl::string_view()), t(shield_absl::Cord()),            //
+      t(std::string("")), t(shield_absl::string_view("")), t(shield_absl::Cord("")),      //
+      t(std::string(small)), t(shield_absl::string_view(small)),                   //
+          t(shield_absl::Cord(small)),                                             //
+      t(std::string(dup)), t(shield_absl::string_view(dup)), t(shield_absl::Cord(dup)),   //
+      t(std::string(large)), t(shield_absl::string_view(large)),                   //
+          t(shield_absl::Cord(large)),                                             //
+      t(std::string(huge)), t(shield_absl::string_view(huge)),                     //
+          t(FlatCord(huge)), t(FragmentedCord(huge)))));
+
+  // Make sure that hashing a `const char*` does not use its string-value.
+  EXPECT_NE(SpyHash(static_cast<const char*>("ABC")),
+            SpyHash(shield_absl::string_view("ABC")));
