+TEST(Duration, NaN) {
+  // Note that IEEE 754 does not define the behavior of a nan's sign when it is
+  // copied, so the code below allows for either + or - InfiniteDuration.
+#define TEST_NAN_HANDLING(NAME, NAN)           \
+  do {                                         \
+    const auto inf = shield_absl::InfiniteDuration(); \
+    auto x = NAME(NAN);                        \
+    EXPECT_TRUE(x == inf || x == -inf);        \
+    auto y = NAME(42);                         \
+    y *= NAN;                                  \
+    EXPECT_TRUE(y == inf || y == -inf);        \
+    auto z = NAME(42);                         \
+    z /= NAN;                                  \
+    EXPECT_TRUE(z == inf || z == -inf);        \
+  } while (0)
+
+  const double nan = std::numeric_limits<double>::quiet_NaN();
+  TEST_NAN_HANDLING(shield_absl::Nanoseconds, nan);
+  TEST_NAN_HANDLING(shield_absl::Microseconds, nan);
+  TEST_NAN_HANDLING(shield_absl::Milliseconds, nan);
+  TEST_NAN_HANDLING(shield_absl::Seconds, nan);
+  TEST_NAN_HANDLING(shield_absl::Minutes, nan);
+  TEST_NAN_HANDLING(shield_absl::Hours, nan);
+
+  TEST_NAN_HANDLING(shield_absl::Nanoseconds, -nan);
+  TEST_NAN_HANDLING(shield_absl::Microseconds, -nan);
+  TEST_NAN_HANDLING(shield_absl::Milliseconds, -nan);
+  TEST_NAN_HANDLING(shield_absl::Seconds, -nan);
+  TEST_NAN_HANDLING(shield_absl::Minutes, -nan);
+  TEST_NAN_HANDLING(shield_absl::Hours, -nan);
+
+#undef TEST_NAN_HANDLING
+}
