+TEST(AnyTest, HasValue) {
+  shield_absl::any o;
+  EXPECT_FALSE(o.has_value());
+  o.emplace<int>();
+  EXPECT_TRUE(o.has_value());
+  o.reset();
+  EXPECT_FALSE(o.has_value());
+}
+
+TEST(AnyTest, Type) {
+  shield_absl::any o;
+  EXPECT_EQ(typeid(void), o.type());
+  o.emplace<int>(5);
+  EXPECT_EQ(typeid(int), o.type());
+  o.emplace<float>(5.f);
+  EXPECT_EQ(typeid(float), o.type());
+  o.reset();
+  EXPECT_EQ(typeid(void), o.type());
+}
+
+TEST(AnyTest, EmptyPointerCast) {
+  // pointer-to-unqualified overload
+  {
+    shield_absl::any o;
+    EXPECT_EQ(nullptr, shield_absl::any_cast<int>(&o));
+    o.emplace<int>();
+    EXPECT_NE(nullptr, shield_absl::any_cast<int>(&o));
+    o.reset();
+    EXPECT_EQ(nullptr, shield_absl::any_cast<int>(&o));
+  }
+
+  // pointer-to-const overload
+  {
+    shield_absl::any o;
+    EXPECT_EQ(nullptr, shield_absl::any_cast<int>(&AsConst(o)));
+    o.emplace<int>();
+    EXPECT_NE(nullptr, shield_absl::any_cast<int>(&AsConst(o)));
+    o.reset();
+    EXPECT_EQ(nullptr, shield_absl::any_cast<int>(&AsConst(o)));
+  }
+}
