+
+// Test go/btm support by randomizing the value of clock_gettime() for
+// CLOCK_MONOTONIC. This works by overriding a weak symbol in glibc.
+// We should be resistant to this randomization when !SupportsSteadyClock().
+#if defined(__GOOGLE_GRTE_VERSION__) &&      \
+    !defined(ABSL_HAVE_ADDRESS_SANITIZER) && \
+    !defined(ABSL_HAVE_MEMORY_SANITIZER) &&  \
+    !defined(ABSL_HAVE_THREAD_SANITIZER)
+extern "C" int __clock_gettime(clockid_t c, struct timespec* ts);
+
+extern "C" int clock_gettime(clockid_t c, struct timespec* ts) {
+  if (c == CLOCK_MONOTONIC &&
+      !shield_absl::synchronization_internal::KernelTimeout::SupportsSteadyClock()) {
+    shield_absl::SharedBitGen gen;
+    ts->tv_sec = shield_absl::Uniform(gen, 0, 1'000'000'000);
+    ts->tv_nsec = shield_absl::Uniform(gen, 0, 1'000'000'000);
+    return 0;
+  }
+  return __clock_gettime(c, ts);
+}
+#endif
+
+namespace {
+
+TEST(Waiter, PrintPlatformImplementation) {
+  // Allows us to verify that the platform is using the expected implementation.
+  std::cout << shield_absl::synchronization_internal::Waiter::kName << std::endl;
+}
+
+template <typename T>
+class WaiterTest : public ::testing::Test {
+ public:
+  // Waiter implementations assume that a ThreadIdentity has already been
+  // created.
+  WaiterTest() {
+    shield_absl::synchronization_internal::GetOrCreateCurrentThreadIdentity();
+  }
+};
+
+TYPED_TEST_SUITE_P(WaiterTest);
+
+shield_absl::Duration WithTolerance(shield_absl::Duration d) { return d * 0.95; }
+
+TYPED_TEST_P(WaiterTest, WaitNoTimeout) {
+  shield_absl::synchronization_internal::ThreadPool tp(1);
+  TypeParam waiter;
+  tp.Schedule([&]() {
+    // Include some `Poke()` calls to ensure they don't cause `waiter` to return
+    // from `Wait()`.
+    waiter.Poke();
+    shield_absl::SleepFor(shield_absl::Seconds(1));
+    waiter.Poke();
+    shield_absl::SleepFor(shield_absl::Seconds(1));
+    waiter.Post();
+  });
+  shield_absl::Time start = shield_absl::Now();
+  EXPECT_TRUE(
+      waiter.Wait(shield_absl::synchronization_internal::KernelTimeout::Never()));
+  shield_absl::Duration waited = shield_absl::Now() - start;
+  EXPECT_GE(waited, WithTolerance(shield_absl::Seconds(2)));
+}
+
+TYPED_TEST_P(WaiterTest, WaitDurationWoken) {
+  shield_absl::synchronization_internal::ThreadPool tp(1);
+  TypeParam waiter;
+  tp.Schedule([&]() {
+    // Include some `Poke()` calls to ensure they don't cause `waiter` to return
+    // from `Wait()`.
+    waiter.Poke();
+    shield_absl::SleepFor(shield_absl::Milliseconds(500));
+    waiter.Post();
+  });
+  shield_absl::Time start = shield_absl::Now();
+  EXPECT_TRUE(waiter.Wait(
+      shield_absl::synchronization_internal::KernelTimeout(shield_absl::Seconds(10))));
+  shield_absl::Duration waited = shield_absl::Now() - start;
+  EXPECT_GE(waited, WithTolerance(shield_absl::Milliseconds(500)));
+  EXPECT_LT(waited, shield_absl::Seconds(2));
+}
+
+TYPED_TEST_P(WaiterTest, WaitTimeWoken) {
+  shield_absl::synchronization_internal::ThreadPool tp(1);
+  TypeParam waiter;
+  tp.Schedule([&]() {
+    // Include some `Poke()` calls to ensure they don't cause `waiter` to return
+    // from `Wait()`.
+    waiter.Poke();
+    shield_absl::SleepFor(shield_absl::Milliseconds(500));
+    waiter.Post();
+  });
+  shield_absl::Time start = shield_absl::Now();
+  EXPECT_TRUE(waiter.Wait(shield_absl::synchronization_internal::KernelTimeout(
+      start + shield_absl::Seconds(10))));
+  shield_absl::Duration waited = shield_absl::Now() - start;
+  EXPECT_GE(waited, WithTolerance(shield_absl::Milliseconds(500)));
+  EXPECT_LT(waited, shield_absl::Seconds(2));
+}
+
+TYPED_TEST_P(WaiterTest, WaitDurationReached) {
+  TypeParam waiter;
+  shield_absl::Time start = shield_absl::Now();
+  EXPECT_FALSE(waiter.Wait(
+      shield_absl::synchronization_internal::KernelTimeout(shield_absl::Milliseconds(500))));
+  shield_absl::Duration waited = shield_absl::Now() - start;
+  EXPECT_GE(waited, WithTolerance(shield_absl::Milliseconds(500)));
+  EXPECT_LT(waited, shield_absl::Seconds(1));
+}
+
+TYPED_TEST_P(WaiterTest, WaitTimeReached) {
+  TypeParam waiter;
+  shield_absl::Time start = shield_absl::Now();
+  EXPECT_FALSE(waiter.Wait(shield_absl::synchronization_internal::KernelTimeout(
+      start + shield_absl::Milliseconds(500))));
+  shield_absl::Duration waited = shield_absl::Now() - start;
+  EXPECT_GE(waited, WithTolerance(shield_absl::Milliseconds(500)));
+  EXPECT_LT(waited, shield_absl::Seconds(1));
+}
+
+REGISTER_TYPED_TEST_SUITE_P(WaiterTest,
+                            WaitNoTimeout,
+                            WaitDurationWoken,
+                            WaitTimeWoken,
+                            WaitDurationReached,
+                            WaitTimeReached);
+
+#ifdef ABSL_INTERNAL_HAVE_FUTEX_WAITER
+INSTANTIATE_TYPED_TEST_SUITE_P(Futex, WaiterTest,
+                               shield_absl::synchronization_internal::FutexWaiter);
+#endif
+#ifdef ABSL_INTERNAL_HAVE_PTHREAD_WAITER
+INSTANTIATE_TYPED_TEST_SUITE_P(Pthread, WaiterTest,
+                               shield_absl::synchronization_internal::PthreadWaiter);
+#endif
+#ifdef ABSL_INTERNAL_HAVE_SEM_WAITER
+INSTANTIATE_TYPED_TEST_SUITE_P(Sem, WaiterTest,
+                               shield_absl::synchronization_internal::SemWaiter);
+#endif
+#ifdef ABSL_INTERNAL_HAVE_WIN32_WAITER
+INSTANTIATE_TYPED_TEST_SUITE_P(Win32, WaiterTest,
+                               shield_absl::synchronization_internal::Win32Waiter);
+#endif
