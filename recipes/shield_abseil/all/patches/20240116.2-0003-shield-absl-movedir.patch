+    EXPECT_EQ(UNIT(2), a);                  \
+    a -= UNIT(1);                           \
+    EXPECT_EQ(UNIT(1), a);                  \
+  } while (0)
+
+  TEST_ADD_OPS(shield_absl::Nanoseconds);
+  TEST_ADD_OPS(shield_absl::Microseconds);
+  TEST_ADD_OPS(shield_absl::Milliseconds);
+  TEST_ADD_OPS(shield_absl::Seconds);
+  TEST_ADD_OPS(shield_absl::Minutes);
+  TEST_ADD_OPS(shield_absl::Hours);
+
+#undef TEST_ADD_OPS
+
+  EXPECT_EQ(shield_absl::Seconds(2), shield_absl::Seconds(3) - 2 * shield_absl::Milliseconds(500));
+  EXPECT_EQ(shield_absl::Seconds(2) + shield_absl::Milliseconds(500),
+            shield_absl::Seconds(3) - shield_absl::Milliseconds(500));
+
+  EXPECT_EQ(shield_absl::Seconds(1) + shield_absl::Milliseconds(998),
+            shield_absl::Milliseconds(999) + shield_absl::Milliseconds(999));
+
+  EXPECT_EQ(shield_absl::Milliseconds(-1),
+            shield_absl::Milliseconds(998) - shield_absl::Milliseconds(999));
+
+  // Tests fractions of a nanoseconds. These are implementation details only.
+  EXPECT_GT(shield_absl::Nanoseconds(1), shield_absl::Nanoseconds(1) / 2);
+  EXPECT_EQ(shield_absl::Nanoseconds(1),
+            shield_absl::Nanoseconds(1) / 2 + shield_absl::Nanoseconds(1) / 2);
+  EXPECT_GT(shield_absl::Nanoseconds(1) / 4, shield_absl::Nanoseconds(0));
+  EXPECT_EQ(shield_absl::Nanoseconds(1) / 8, shield_absl::Nanoseconds(0));
+
+  // Tests subtraction that will cause wrap around of the rep_lo_ bits.
+  shield_absl::Duration d_7_5 = shield_absl::Seconds(7) + shield_absl::Milliseconds(500);
+  shield_absl::Duration d_3_7 = shield_absl::Seconds(3) + shield_absl::Milliseconds(700);
+  shield_absl::Duration ans_3_8 = shield_absl::Seconds(3) + shield_absl::Milliseconds(800);
+  EXPECT_EQ(ans_3_8, d_7_5 - d_3_7);
+
+  // Subtracting min_duration
+  shield_absl::Duration min_dur = shield_absl::Seconds(kint64min);
+  EXPECT_EQ(shield_absl::Seconds(0), min_dur - min_dur);
+  EXPECT_EQ(shield_absl::Seconds(kint64max), shield_absl::Seconds(-1) - min_dur);
+}
