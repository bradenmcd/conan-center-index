+  EXPECT_EQ(1, shield_absl::ToUnixNanos(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(1)));
+  EXPECT_EQ(0, shield_absl::ToUnixNanos(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(1) / 2));
+  EXPECT_EQ(0, shield_absl::ToUnixNanos(shield_absl::UnixEpoch() + shield_absl::Nanoseconds(0)));
+  EXPECT_EQ(-1,
