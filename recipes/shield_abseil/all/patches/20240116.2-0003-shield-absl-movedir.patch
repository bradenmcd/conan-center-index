+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "shield_absl/log/globals.h"
+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "shield_absl/base/attributes.h"
+#include "shield_absl/base/log_severity.h"
+#include "shield_absl/log/internal/globals.h"
+#include "shield_absl/log/internal/test_helpers.h"
+#include "shield_absl/log/log.h"
+#include "shield_absl/log/scoped_mock_log.h"
+
+namespace {
+using ::testing::_;
+using ::testing::StrEq;
+
+auto* test_env ABSL_ATTRIBUTE_UNUSED = ::testing::AddGlobalTestEnvironment(
+    new shield_absl::log_internal::LogTestEnvironment);
+
+constexpr static shield_absl::LogSeverityAtLeast DefaultMinLogLevel() {
+  return shield_absl::LogSeverityAtLeast::kInfo;
+}
+constexpr static shield_absl::LogSeverityAtLeast DefaultStderrThreshold() {
+  return shield_absl::LogSeverityAtLeast::kError;
+}
+
+TEST(TestGlobals, MinLogLevel) {
+  EXPECT_EQ(shield_absl::MinLogLevel(), DefaultMinLogLevel());
+  shield_absl::SetMinLogLevel(shield_absl::LogSeverityAtLeast::kError);
+  EXPECT_EQ(shield_absl::MinLogLevel(), shield_absl::LogSeverityAtLeast::kError);
+  shield_absl::SetMinLogLevel(DefaultMinLogLevel());
+}
+
+TEST(TestGlobals, ScopedMinLogLevel) {
+  EXPECT_EQ(shield_absl::MinLogLevel(), DefaultMinLogLevel());
+  {
+    shield_absl::log_internal::ScopedMinLogLevel scoped_stderr_threshold(
+        shield_absl::LogSeverityAtLeast::kError);
+    EXPECT_EQ(shield_absl::MinLogLevel(), shield_absl::LogSeverityAtLeast::kError);
+  }
+  EXPECT_EQ(shield_absl::MinLogLevel(), DefaultMinLogLevel());
+}
+
+TEST(TestGlobals, StderrThreshold) {
+  EXPECT_EQ(shield_absl::StderrThreshold(), DefaultStderrThreshold());
+  shield_absl::SetStderrThreshold(shield_absl::LogSeverityAtLeast::kError);
+  EXPECT_EQ(shield_absl::StderrThreshold(), shield_absl::LogSeverityAtLeast::kError);
+  shield_absl::SetStderrThreshold(DefaultStderrThreshold());
+}
+
+TEST(TestGlobals, ScopedStderrThreshold) {
+  EXPECT_EQ(shield_absl::StderrThreshold(), DefaultStderrThreshold());
+  {
+    shield_absl::ScopedStderrThreshold scoped_stderr_threshold(
+        shield_absl::LogSeverityAtLeast::kError);
+    EXPECT_EQ(shield_absl::StderrThreshold(), shield_absl::LogSeverityAtLeast::kError);
+  }
+  EXPECT_EQ(shield_absl::StderrThreshold(), DefaultStderrThreshold());
+}
+
+TEST(TestGlobals, LogBacktraceAt) {
+  EXPECT_FALSE(shield_absl::log_internal::ShouldLogBacktraceAt("some_file.cc", 111));
+  shield_absl::SetLogBacktraceLocation("some_file.cc", 111);
+  EXPECT_TRUE(shield_absl::log_internal::ShouldLogBacktraceAt("some_file.cc", 111));
+  EXPECT_FALSE(
+      shield_absl::log_internal::ShouldLogBacktraceAt("another_file.cc", 222));
+}
+
+TEST(TestGlobals, LogPrefix) {
+  EXPECT_TRUE(shield_absl::ShouldPrependLogPrefix());
+  shield_absl::EnableLogPrefix(false);
+  EXPECT_FALSE(shield_absl::ShouldPrependLogPrefix());
+  shield_absl::EnableLogPrefix(true);
+  EXPECT_TRUE(shield_absl::ShouldPrependLogPrefix());
+}
+
+TEST(TestGlobals, SetGlobalVLogLevel) {
+  EXPECT_EQ(shield_absl::SetGlobalVLogLevel(42), 0);
+  EXPECT_EQ(shield_absl::SetGlobalVLogLevel(1337), 42);
+  // Restore the value since it affects the default unset module value for
+  // `SetVLogLevel()`.
+  EXPECT_EQ(shield_absl::SetGlobalVLogLevel(0), 1337);
+}
+
+TEST(TestGlobals, SetVLogLevel) {
+  EXPECT_EQ(shield_absl::SetVLogLevel("setvloglevel", 42), 0);
+  EXPECT_EQ(shield_absl::SetVLogLevel("setvloglevel", 1337), 42);
+  EXPECT_EQ(shield_absl::SetVLogLevel("othersetvloglevel", 50), 0);
+}
+
+TEST(TestGlobals, AndroidLogTag) {
+  // Verify invalid tags result in a check failure.
+  EXPECT_DEATH_IF_SUPPORTED(shield_absl::SetAndroidNativeTag(nullptr), ".*");
+
+  // Verify valid tags applied.
+  EXPECT_THAT(shield_absl::log_internal::GetAndroidNativeTag(), StrEq("native"));
+  shield_absl::SetAndroidNativeTag("test_tag");
+  EXPECT_THAT(shield_absl::log_internal::GetAndroidNativeTag(), StrEq("test_tag"));
+
+  // Verify that additional calls (more than 1) result in a check failure.
+  EXPECT_DEATH_IF_SUPPORTED(shield_absl::SetAndroidNativeTag("test_tag_fail"), ".*");
+}
+
+TEST(TestExitOnDFatal, OffTest) {
+  // Turn off...
+  shield_absl::log_internal::SetExitOnDFatal(false);
+  EXPECT_FALSE(shield_absl::log_internal::ExitOnDFatal());
+
+  // We don't die.
+  {
+    shield_absl::ScopedMockLog log(shield_absl::MockLogDefault::kDisallowUnexpected);
+
+    // LOG(DFATAL) has severity FATAL if debugging, but is
+    // downgraded to ERROR if not debugging.
+    EXPECT_CALL(log, Log(shield_absl::kLogDebugFatal, _, "This should not be fatal"));
+
+    log.StartCapturingLogs();
+    LOG(DFATAL) << "This should not be fatal";
+  }
+}
+
+#if GTEST_HAS_DEATH_TEST
+TEST(TestDeathWhileExitOnDFatal, OnTest) {
+  shield_absl::log_internal::SetExitOnDFatal(true);
+  EXPECT_TRUE(shield_absl::log_internal::ExitOnDFatal());
+
+  // Death comes on little cats' feet.
+  EXPECT_DEBUG_DEATH({ LOG(DFATAL) << "This should be fatal in debug mode"; },
+                     "This should be fatal in debug mode");
+}
+#endif
+
+}  // namespace
