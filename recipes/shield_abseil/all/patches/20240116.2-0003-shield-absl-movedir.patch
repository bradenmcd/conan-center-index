-// Metafunction to test whether difference is allowed between two types.
-template <typename T1, typename T2>
-struct HasDiff {
-  template <typename U1, typename U2>
-  static std::false_type test(...);
-  template <typename U1, typename U2>
-  static std::true_type test(decltype(std::declval<U1>() - std::declval<U2>()));
-  static constexpr bool value = decltype(test<T1, T2>(0))::value;
-};
-
-TEST(CivilTime, DisallowCrossAlignedDifference) {
-  // Difference is allowed between types with the same alignment.
-  static_assert(HasDiff<shield_absl::CivilSecond, shield_absl::CivilSecond>::value, "");
-  static_assert(HasDiff<shield_absl::CivilMinute, shield_absl::CivilMinute>::value, "");
-  static_assert(HasDiff<shield_absl::CivilHour, shield_absl::CivilHour>::value, "");
-  static_assert(HasDiff<shield_absl::CivilDay, shield_absl::CivilDay>::value, "");
-  static_assert(HasDiff<shield_absl::CivilMonth, shield_absl::CivilMonth>::value, "");
-  static_assert(HasDiff<shield_absl::CivilYear, shield_absl::CivilYear>::value, "");
-
-  // Difference is disallowed between types with different alignments.
-  static_assert(!HasDiff<shield_absl::CivilSecond, shield_absl::CivilMinute>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilSecond, shield_absl::CivilHour>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilSecond, shield_absl::CivilDay>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilSecond, shield_absl::CivilMonth>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilSecond, shield_absl::CivilYear>::value, "");
-
-  static_assert(!HasDiff<shield_absl::CivilMinute, shield_absl::CivilHour>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilMinute, shield_absl::CivilDay>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilMinute, shield_absl::CivilMonth>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilMinute, shield_absl::CivilYear>::value, "");
-
-  static_assert(!HasDiff<shield_absl::CivilHour, shield_absl::CivilDay>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilHour, shield_absl::CivilMonth>::value, "");
-  static_assert(!HasDiff<shield_absl::CivilHour, shield_absl::CivilYear>::value, "");
-
-  static_assert(!HasDiff<shield_absl::CivilDay, shield_absl::CivilMonth>::value, "");
