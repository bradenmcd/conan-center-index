+//  assert(x == 12.3456789)
+//
+template <typename RealType>
+using MockGaussian =
+    random_internal::MockOverloadSet<shield_absl::gaussian_distribution<RealType>,
+                                     RealType(MockingBitGen&, RealType,
+                                              RealType)>;
+
+// -----------------------------------------------------------------------------
+// shield_absl::MockLogUniform
+// -----------------------------------------------------------------------------
+//
+// Matches calls to shield_absl::LogUniform.
+//
+// `shield_absl::MockLogUniform` is a class template used in conjunction with
