+struct ConstFunctor {
+  int operator()(int a, int b) const { return a - b; }
+};
+
+struct MutableFunctor {
+  int operator()(int a, int b) { return a - b; }
+};
+
+struct Class {
+  int Method(int a, int b) { return a - b; }
+  int ConstMethod(int a, int b) const { return a - b; }
+
+  int member;
+};
+
+TEST(VariantTest, VisitReferenceWrapper) {
+  ConstFunctor cf;
+  MutableFunctor mf;
+  shield_absl::variant<int> three = 3;
+  shield_absl::variant<int> two = 2;
+
+  EXPECT_EQ(1, shield_absl::visit(std::cref(cf), three, two));
+  EXPECT_EQ(1, shield_absl::visit(std::ref(cf), three, two));
+  EXPECT_EQ(1, shield_absl::visit(std::ref(mf), three, two));
+}
