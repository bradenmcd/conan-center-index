-        entry_.log_severity(), ci_.cs, ci_.subsecond, entry_.tid(),
-        entry_.source_basename(), entry_.source_line(), format_,
-        entry_.text_message());
-  }
-  std::string FormatPrefixIntoSizedBuffer(size_t sz) {
