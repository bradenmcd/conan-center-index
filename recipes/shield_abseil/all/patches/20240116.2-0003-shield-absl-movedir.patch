-template <typename T>
-struct PopcountInput {
-  T value = 0;
-  int expected = 0;
-};
-
-template <typename T>
-PopcountInput<T> GeneratePopcountInput(shield_absl::BitGen& gen) {
-  PopcountInput<T> ret;
-  for (int i = 0; i < std::numeric_limits<T>::digits; i++) {
-    bool coin = shield_absl::Bernoulli(gen, 0.2);
-    if (coin) {
-      ret.value |= T{1} << i;
-      ret.expected++;
-    }
-  }
-  return ret;
-}
