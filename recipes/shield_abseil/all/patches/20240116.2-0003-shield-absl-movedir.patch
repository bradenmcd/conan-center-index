+shield_absl::Cord FlatCord(shield_absl::string_view sv) {
+  shield_absl::Cord c(sv);
+  c.Flatten();
+  return c;
+}
+
+shield_absl::Cord FragmentedCord(shield_absl::string_view sv) {
+  if (sv.size() < 2) {
+    return shield_absl::Cord(sv);
+  }
+  size_t halfway = sv.size() / 2;
+  std::vector<shield_absl::string_view> parts = {sv.substr(0, halfway),
+                                          sv.substr(halfway)};
+  return shield_absl::MakeFragmentedCord(parts);
+}
