-
-ABSL_ATTRIBUTE_NOINLINE void func(benchmark::State& state, int x, int depth) {
-  if (x <= 0) {
-    // Touch a significant amount of memory so that the stack is likely to be
-    // not cached in the L1 cache.
-    state.PauseTiming();
-    int* arr = new int[kCacheSize];
