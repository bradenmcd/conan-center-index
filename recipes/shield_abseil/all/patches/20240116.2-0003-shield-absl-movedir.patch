-////////////////////////////////////////////////////////////////////////////////
-//
-// A metafunction for checking if a type is an AnyInvocable instantiation.
-// This is used during conversion operations.
-template <class T>
-struct IsAnyInvocable : std::false_type {};
-
-template <class Sig>
-struct IsAnyInvocable<AnyInvocable<Sig>> : std::true_type {};
