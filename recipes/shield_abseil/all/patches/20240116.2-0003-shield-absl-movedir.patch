+// The implementation of the shield_absl::Time class, which is declared in
+// //absl/time.h.
+//
+// The representation for an shield_absl::Time is an shield_absl::Duration offset from the
+// epoch.  We use the traditional Unix epoch (1970-01-01 00:00:00 +0000)
+// for convenience, but this is not exposed in the API and could be changed.
+//
+// NOTE: To keep type verbosity to a minimum, the following variable naming
+// conventions are used throughout this file.
+//
+// tz: An shield_absl::TimeZone
+// ci: An shield_absl::TimeZone::CivilInfo
+// ti: An shield_absl::TimeZone::TimeInfo
+// cd: An shield_absl::CivilDay or a cctz::civil_day
+// cs: An shield_absl::CivilSecond or a cctz::civil_second
+// bd: An shield_absl::Time::Breakdown
+// cl: A cctz::time_zone::civil_lookup
+// al: A cctz::time_zone::absolute_lookup
+
+#include "shield_absl/time/time.h"
+
+#if defined(_MSC_VER)
+#include <winsock2.h>  // for timeval
+#endif
+
+#include <cstring>
+#include <ctime>
+#include <limits>
+
+#include "shield_absl/time/internal/cctz/include/cctz/civil_time.h"
+#include "shield_absl/time/internal/cctz/include/cctz/time_zone.h"
+
+namespace cctz = shield_absl::time_internal::cctz;
+
+namespace shield_absl {
+ABSL_NAMESPACE_BEGIN
+
+namespace {
+
+inline cctz::time_point<cctz::seconds> unix_epoch() {
+  return std::chrono::time_point_cast<cctz::seconds>(
+      std::chrono::system_clock::from_time_t(0));
+}
+
+// Floors d to the next unit boundary closer to negative infinity.
+inline int64_t FloorToUnit(shield_absl::Duration d, shield_absl::Duration unit) {
+  shield_absl::Duration rem;
+  int64_t q = shield_absl::IDivDuration(d, unit, &rem);
+  return (q > 0 || rem >= ZeroDuration() ||
+          q == std::numeric_limits<int64_t>::min())
+             ? q
+             : q - 1;
+}
+
+ABSL_INTERNAL_DISABLE_DEPRECATED_DECLARATION_WARNING
+inline shield_absl::Time::Breakdown InfiniteFutureBreakdown() {
+  shield_absl::Time::Breakdown bd;
+  bd.year = std::numeric_limits<int64_t>::max();
+  bd.month = 12;
+  bd.day = 31;
+  bd.hour = 23;
+  bd.minute = 59;
+  bd.second = 59;
+  bd.subsecond = shield_absl::InfiniteDuration();
+  bd.weekday = 4;
+  bd.yearday = 365;
+  bd.offset = 0;
+  bd.is_dst = false;
+  bd.zone_abbr = "-00";
+  return bd;
+}
+
+inline shield_absl::Time::Breakdown InfinitePastBreakdown() {
+  Time::Breakdown bd;
+  bd.year = std::numeric_limits<int64_t>::min();
+  bd.month = 1;
+  bd.day = 1;
+  bd.hour = 0;
+  bd.minute = 0;
+  bd.second = 0;
+  bd.subsecond = -shield_absl::InfiniteDuration();
+  bd.weekday = 7;
+  bd.yearday = 1;
+  bd.offset = 0;
+  bd.is_dst = false;
+  bd.zone_abbr = "-00";
+  return bd;
+}
+ABSL_INTERNAL_RESTORE_DEPRECATED_DECLARATION_WARNING
+
+inline shield_absl::TimeZone::CivilInfo InfiniteFutureCivilInfo() {
+  TimeZone::CivilInfo ci;
+  ci.cs = CivilSecond::max();
+  ci.subsecond = InfiniteDuration();
+  ci.offset = 0;
+  ci.is_dst = false;
+  ci.zone_abbr = "-00";
