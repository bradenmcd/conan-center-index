+  EXPECT_EQ(milliseconds(N), shield_absl::ToChronoMilliseconds(shield_absl::Milliseconds(N)));
+  EXPECT_EQ(seconds(N), shield_absl::ToChronoSeconds(shield_absl::Seconds(N)));
+
+  constexpr auto absl_minutes = shield_absl::Minutes(N);
+  auto chrono_minutes = minutes(N);
+  if (absl_minutes == -shield_absl::InfiniteDuration()) {
+    chrono_minutes = minutes::min();
+  } else if (absl_minutes == shield_absl::InfiniteDuration()) {
+    chrono_minutes = minutes::max();
