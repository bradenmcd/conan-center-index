+  // GoogleTest calls shield_absl::SetProgramUsageMessage() already.
+  shield_absl::SetProgramUsageMessage(kTestUsageMessage);
+#endif
+  ::testing::InitGoogleTest(&argc, argv);
+  return RUN_ALL_TESTS();
+}
