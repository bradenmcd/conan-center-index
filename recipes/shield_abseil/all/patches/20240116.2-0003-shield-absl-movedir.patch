+  raw_hash_set(raw_hash_set&& that, const allocator_type& a)
+      : settings_(CommonFields{}, that.hash_ref(), that.eq_ref(), a) {
+    if (a == that.alloc_ref()) {
+      std::swap(common(), that.common());
