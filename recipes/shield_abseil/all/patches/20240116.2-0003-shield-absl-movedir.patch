-void WriteToString(const char* data, void* str) {
-  reinterpret_cast<std::string*>(str)->append(data);
-}
-void WriteToStream(const char* data, void* os) {
-  auto* cast_os = static_cast<std::ostream*>(os);
-  *cast_os << data;
-}
