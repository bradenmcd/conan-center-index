+#include <string>
+#include <utility>
+
+#include "gtest/gtest.h"
+#include "shield_absl/crc/crc32c.h"
+
+namespace {
+
+TEST(CrcCordState, Default) {
+  shield_absl::crc_internal::CrcCordState state;
+  EXPECT_TRUE(state.IsNormalized());
+  EXPECT_EQ(state.Checksum(), shield_absl::crc32c_t{0});
+  state.Normalize();
+  EXPECT_EQ(state.Checksum(), shield_absl::crc32c_t{0});
+}
+
+TEST(CrcCordState, Normalize) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(2000, shield_absl::crc32c_t{2000}));
+  rep->removed_prefix =
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(500, shield_absl::crc32c_t{500});
+
+  // The removed_prefix means state is not normalized.
+  EXPECT_FALSE(state.IsNormalized());
+
+  shield_absl::crc32c_t crc = state.Checksum();
+  state.Normalize();
+  EXPECT_TRUE(state.IsNormalized());
+
+  // The checksum should not change as a result of calling Normalize().
+  EXPECT_EQ(state.Checksum(), crc);
+  EXPECT_EQ(rep->removed_prefix.length, 0);
+}
+
+TEST(CrcCordState, Copy) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+
+  shield_absl::crc_internal::CrcCordState copy = state;
+
+  EXPECT_EQ(state.Checksum(), shield_absl::crc32c_t{1000});
+  EXPECT_EQ(copy.Checksum(), shield_absl::crc32c_t{1000});
+}
+
+TEST(CrcCordState, UnsharedSelfCopy) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+
+  const shield_absl::crc_internal::CrcCordState& ref = state;
+  state = ref;
+
+  EXPECT_EQ(state.Checksum(), shield_absl::crc32c_t{1000});
+}
+
+TEST(CrcCordState, Move) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+
+  shield_absl::crc_internal::CrcCordState moved = std::move(state);
+  EXPECT_EQ(moved.Checksum(), shield_absl::crc32c_t{1000});
+}
+
+TEST(CrcCordState, UnsharedSelfMove) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+
+  shield_absl::crc_internal::CrcCordState& ref = state;
+  state = std::move(ref);
+
+  EXPECT_EQ(state.Checksum(), shield_absl::crc32c_t{1000});
+}
+
+TEST(CrcCordState, PoisonDefault) {
+  shield_absl::crc_internal::CrcCordState state;
+  state.Poison();
+  EXPECT_NE(state.Checksum(), shield_absl::crc32c_t{0});
+}
+
+TEST(CrcCordState, PoisonData) {
+  shield_absl::crc_internal::CrcCordState state;
+  auto* rep = state.mutable_rep();
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(1000, shield_absl::crc32c_t{1000}));
+  rep->prefix_crc.push_back(
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(2000, shield_absl::crc32c_t{2000}));
+  rep->removed_prefix =
+      shield_absl::crc_internal::CrcCordState::PrefixCrc(500, shield_absl::crc32c_t{500});
+
+  shield_absl::crc32c_t crc = state.Checksum();
+  state.Poison();
+  EXPECT_NE(state.Checksum(), crc);
+}
+
