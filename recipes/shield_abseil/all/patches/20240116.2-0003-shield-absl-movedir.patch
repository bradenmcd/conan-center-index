+TEST(CivilTime, DefaultConstruction) {
+  shield_absl::CivilSecond ss;
+  EXPECT_EQ("1970-01-01T00:00:00", shield_absl::FormatCivilTime(ss));
+
+  shield_absl::CivilMinute mm;
+  EXPECT_EQ("1970-01-01T00:00", shield_absl::FormatCivilTime(mm));
+
+  shield_absl::CivilHour hh;
+  EXPECT_EQ("1970-01-01T00", shield_absl::FormatCivilTime(hh));
+
+  shield_absl::CivilDay d;
+  EXPECT_EQ("1970-01-01", shield_absl::FormatCivilTime(d));
+
+  shield_absl::CivilMonth m;
+  EXPECT_EQ("1970-01", shield_absl::FormatCivilTime(m));
+
+  shield_absl::CivilYear y;
+  EXPECT_EQ("1970", shield_absl::FormatCivilTime(y));
+}
+
+TEST(CivilTime, StructMember) {
+  struct S {
+    shield_absl::CivilDay day;
+  };
+  S s = {};
+  EXPECT_EQ(shield_absl::CivilDay{}, s.day);
+}
+
+TEST(CivilTime, FieldsConstruction) {
+  EXPECT_EQ("2015-01-02T03:04:05",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015, 1, 2, 3, 4, 5)));
+  EXPECT_EQ("2015-01-02T03:04:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015, 1, 2, 3, 4)));
+  EXPECT_EQ("2015-01-02T03:00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015, 1, 2, 3)));
+  EXPECT_EQ("2015-01-02T00:00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015, 1, 2)));
+  EXPECT_EQ("2015-01-01T00:00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015, 1)));
+  EXPECT_EQ("2015-01-01T00:00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilSecond(2015)));
+
+  EXPECT_EQ("2015-01-02T03:04",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015, 1, 2, 3, 4, 5)));
+  EXPECT_EQ("2015-01-02T03:04",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015, 1, 2, 3, 4)));
+  EXPECT_EQ("2015-01-02T03:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015, 1, 2, 3)));
+  EXPECT_EQ("2015-01-02T00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015, 1, 2)));
+  EXPECT_EQ("2015-01-01T00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015, 1)));
+  EXPECT_EQ("2015-01-01T00:00",
+            shield_absl::FormatCivilTime(shield_absl::CivilMinute(2015)));
+
+  EXPECT_EQ("2015-01-02T03",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015, 1, 2, 3, 4, 5)));
+  EXPECT_EQ("2015-01-02T03",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015, 1, 2, 3, 4)));
+  EXPECT_EQ("2015-01-02T03",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015, 1, 2, 3)));
+  EXPECT_EQ("2015-01-02T00",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015, 1, 2)));
+  EXPECT_EQ("2015-01-01T00",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015, 1)));
+  EXPECT_EQ("2015-01-01T00",
+            shield_absl::FormatCivilTime(shield_absl::CivilHour(2015)));
+
+  EXPECT_EQ("2015-01-02",
