+  TestCompare(
+      shield_absl::Cord(std::string(GetUniformRandomUpTo(&rng, 100), x)),
+      shield_absl::Cord(std::string(GetUniformRandomUpTo(&rng, 100), x ^ 0x80)), &rng);
