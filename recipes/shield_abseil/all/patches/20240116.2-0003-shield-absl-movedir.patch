-// TODO(b/192061034): consider making this a cord rep library function.
-inline CordRep* MakeSubstring(CordRep* rep, size_t offset) {
-  if (offset == 0) return rep;
-  return CreateSubstring(rep, offset, rep->length - offset);
-}
