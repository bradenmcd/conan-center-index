-// FromCivil(CivilSecond(year, mon, day, hour, min, sec), UTCTimeZone())
-// has a specialized fastpath implementation, which we exercise here.
-TEST(Time, FromCivilUTC) {
-  const shield_absl::TimeZone utc = shield_absl::UTCTimeZone();
-  const std::string fmt = "%a, %e %b %Y %H:%M:%S %z (%Z)";
-  const int kMax = std::numeric_limits<int>::max();
-  const int kMin = std::numeric_limits<int>::min();
-  shield_absl::Time t;
-
-  // 292091940881 is the last positive year to use the fastpath.
-  t = shield_absl::FromCivil(
-      shield_absl::CivilSecond(292091940881, kMax, kMax, kMax, kMax, kMax), utc);
-  EXPECT_EQ("Fri, 25 Nov 292277026596 12:21:07 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
-  t = shield_absl::FromCivil(
-      shield_absl::CivilSecond(292091940882, kMax, kMax, kMax, kMax, kMax), utc);
-  EXPECT_EQ("infinite-future", shield_absl::FormatTime(fmt, t, utc));  // no overflow
-
-  // -292091936940 is the last negative year to use the fastpath.
-  t = shield_absl::FromCivil(
-      shield_absl::CivilSecond(-292091936940, kMin, kMin, kMin, kMin, kMin), utc);
-  EXPECT_EQ("Fri,  1 Nov -292277022657 10:37:52 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
-  t = shield_absl::FromCivil(
-      shield_absl::CivilSecond(-292091936941, kMin, kMin, kMin, kMin, kMin), utc);
-  EXPECT_EQ("infinite-past", shield_absl::FormatTime(fmt, t, utc));  // no underflow
-
-  // Check that we're counting leap years correctly.
-  t = shield_absl::FromCivil(shield_absl::CivilSecond(1900, 2, 28, 23, 59, 59), utc);
-  EXPECT_EQ("Wed, 28 Feb 1900 23:59:59 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
-  t = shield_absl::FromCivil(shield_absl::CivilSecond(1900, 3, 1, 0, 0, 0), utc);
-  EXPECT_EQ("Thu,  1 Mar 1900 00:00:00 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
-  t = shield_absl::FromCivil(shield_absl::CivilSecond(2000, 2, 29, 23, 59, 59), utc);
-  EXPECT_EQ("Tue, 29 Feb 2000 23:59:59 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
-  t = shield_absl::FromCivil(shield_absl::CivilSecond(2000, 3, 1, 0, 0, 0), utc);
-  EXPECT_EQ("Wed,  1 Mar 2000 00:00:00 +0000 (UTC)",
-            shield_absl::FormatTime(fmt, t, utc));
