+  // FDiv
+  EXPECT_EQ(dbl_inf, shield_absl::FDivDuration(zero, zero));
+  EXPECT_EQ(dbl_inf, shield_absl::FDivDuration(any_dur, zero));
+  EXPECT_EQ(-dbl_inf, shield_absl::FDivDuration(-any_dur, zero));
+}
