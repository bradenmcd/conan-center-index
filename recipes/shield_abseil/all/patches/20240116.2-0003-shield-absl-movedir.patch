+TEST(HashCord, RandomCord) {
+  hash_default_hash<shield_absl::Cord> hash;
+  auto bitgen = shield_absl::BitGen();
+  for (int i = 0; i < 1000; ++i) {
+    const int number_of_segments = shield_absl::Uniform(bitgen, 0, 10);
+    std::vector<std::string> pieces;
+    for (size_t s = 0; s < number_of_segments; ++s) {
+      std::string str;
+      str.resize(shield_absl::Uniform(bitgen, 0, 4096));
+      // MSVC needed the explicit return type in the lambda.
+      std::generate(str.begin(), str.end(), [&]() -> char {
+        return static_cast<char>(shield_absl::Uniform<unsigned char>(bitgen));
+      });
+      pieces.push_back(str);
+    }
+    shield_absl::Cord c = shield_absl::MakeFragmentedCord(pieces);
+    EXPECT_EQ(hash(c), hash(std::string(c)));
+  }
+}
