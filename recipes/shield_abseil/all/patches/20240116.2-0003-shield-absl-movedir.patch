+TEST(Time, ConversionSaturation) {
+  const shield_absl::TimeZone utc = shield_absl::UTCTimeZone();
+  shield_absl::Time t;
+
+  const auto max_time_t = std::numeric_limits<time_t>::max();
+  const auto min_time_t = std::numeric_limits<time_t>::min();
+  time_t tt = max_time_t - 1;
+  t = shield_absl::FromTimeT(tt);
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(max_time_t - 1, tt);
+  t += shield_absl::Seconds(1);
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(max_time_t, tt);
+  t += shield_absl::Seconds(1);  // no effect
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(max_time_t, tt);
+
+  tt = min_time_t + 1;
+  t = shield_absl::FromTimeT(tt);
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(min_time_t + 1, tt);
+  t -= shield_absl::Seconds(1);
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(min_time_t, tt);
+  t -= shield_absl::Seconds(1);  // no effect
+  tt = shield_absl::ToTimeT(t);
+  EXPECT_EQ(min_time_t, tt);
+
+  const auto max_timeval_sec =
+      std::numeric_limits<decltype(timeval::tv_sec)>::max();
+  const auto min_timeval_sec =
+      std::numeric_limits<decltype(timeval::tv_sec)>::min();
+  timeval tv;
+  tv.tv_sec = max_timeval_sec;
+  tv.tv_usec = 999998;
+  t = shield_absl::TimeFromTimeval(tv);
+  tv = ToTimeval(t);
+  EXPECT_EQ(max_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(999998, tv.tv_usec);
+  t += shield_absl::Microseconds(1);
+  tv = ToTimeval(t);
+  EXPECT_EQ(max_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(999999, tv.tv_usec);
+  t += shield_absl::Microseconds(1);  // no effect
+  tv = ToTimeval(t);
+  EXPECT_EQ(max_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(999999, tv.tv_usec);
+
+  tv.tv_sec = min_timeval_sec;
+  tv.tv_usec = 1;
+  t = shield_absl::TimeFromTimeval(tv);
+  tv = ToTimeval(t);
+  EXPECT_EQ(min_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(1, tv.tv_usec);
+  t -= shield_absl::Microseconds(1);
+  tv = ToTimeval(t);
+  EXPECT_EQ(min_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(0, tv.tv_usec);
+  t -= shield_absl::Microseconds(1);  // no effect
+  tv = ToTimeval(t);
+  EXPECT_EQ(min_timeval_sec, tv.tv_sec);
+  EXPECT_EQ(0, tv.tv_usec);
+
+  const auto max_timespec_sec =
+      std::numeric_limits<decltype(timespec::tv_sec)>::max();
+  const auto min_timespec_sec =
+      std::numeric_limits<decltype(timespec::tv_sec)>::min();
+  timespec ts;
+  ts.tv_sec = max_timespec_sec;
+  ts.tv_nsec = 999999998;
+  t = shield_absl::TimeFromTimespec(ts);
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(max_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(999999998, ts.tv_nsec);
+  t += shield_absl::Nanoseconds(1);
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(max_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(999999999, ts.tv_nsec);
+  t += shield_absl::Nanoseconds(1);  // no effect
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(max_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(999999999, ts.tv_nsec);
+
+  ts.tv_sec = min_timespec_sec;
+  ts.tv_nsec = 1;
+  t = shield_absl::TimeFromTimespec(ts);
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(min_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(1, ts.tv_nsec);
+  t -= shield_absl::Nanoseconds(1);
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(min_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(0, ts.tv_nsec);
+  t -= shield_absl::Nanoseconds(1);  // no effect
+  ts = shield_absl::ToTimespec(t);
+  EXPECT_EQ(min_timespec_sec, ts.tv_sec);
+  EXPECT_EQ(0, ts.tv_nsec);
+
+  // Checks how TimeZone::At() saturates on infinities.
+  auto ci = utc.At(shield_absl::InfiniteFuture());
+  EXPECT_CIVIL_INFO(ci, std::numeric_limits<int64_t>::max(), 12, 31, 23, 59, 59,
+                    0, false);
+  EXPECT_EQ(shield_absl::InfiniteDuration(), ci.subsecond);
+  EXPECT_EQ(shield_absl::Weekday::thursday, shield_absl::GetWeekday(ci.cs));
+  EXPECT_EQ(365, shield_absl::GetYearDay(ci.cs));
+  EXPECT_STREQ("-00", ci.zone_abbr);  // artifact of TimeZone::At()
+  ci = utc.At(shield_absl::InfinitePast());
+  EXPECT_CIVIL_INFO(ci, std::numeric_limits<int64_t>::min(), 1, 1, 0, 0, 0, 0,
+                    false);
+  EXPECT_EQ(-shield_absl::InfiniteDuration(), ci.subsecond);
+  EXPECT_EQ(shield_absl::Weekday::sunday, shield_absl::GetWeekday(ci.cs));
+  EXPECT_EQ(1, shield_absl::GetYearDay(ci.cs));
+  EXPECT_STREQ("-00", ci.zone_abbr);  // artifact of TimeZone::At()
+
+  // Approach the maximal Time value from below.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 15, 30, 6), utc);
+  EXPECT_EQ("292277026596-12-04T15:30:06+00:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 15, 30, 7), utc);
+  EXPECT_EQ("292277026596-12-04T15:30:07+00:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+  EXPECT_EQ(
+      shield_absl::UnixEpoch() + shield_absl::Seconds(std::numeric_limits<int64_t>::max()),
+      t);
+
+  // Checks that we can also get the maximal Time value for a far-east zone.
+  const shield_absl::TimeZone plus14 = shield_absl::FixedTimeZone(14 * 60 * 60);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 5, 5, 30, 7), plus14);
+  EXPECT_EQ("292277026596-12-05T05:30:07+14:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, plus14));
+  EXPECT_EQ(
+      shield_absl::UnixEpoch() + shield_absl::Seconds(std::numeric_limits<int64_t>::max()),
+      t);
+
+  // One second later should push us to infinity.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(292277026596, 12, 4, 15, 30, 8), utc);
+  EXPECT_EQ("infinite-future", shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+
+  // Approach the minimal Time value from above.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(-292277022657, 1, 27, 8, 29, 53), utc);
+  EXPECT_EQ("-292277022657-01-27T08:29:53+00:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(-292277022657, 1, 27, 8, 29, 52), utc);
+  EXPECT_EQ("-292277022657-01-27T08:29:52+00:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+  EXPECT_EQ(
+      shield_absl::UnixEpoch() + shield_absl::Seconds(std::numeric_limits<int64_t>::min()),
+      t);
+
+  // Checks that we can also get the minimal Time value for a far-west zone.
+  const shield_absl::TimeZone minus12 = shield_absl::FixedTimeZone(-12 * 60 * 60);
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(-292277022657, 1, 26, 20, 29, 52),
+                      minus12);
+  EXPECT_EQ("-292277022657-01-26T20:29:52-12:00",
+            shield_absl::FormatTime(shield_absl::RFC3339_full, t, minus12));
+  EXPECT_EQ(
+      shield_absl::UnixEpoch() + shield_absl::Seconds(std::numeric_limits<int64_t>::min()),
+      t);
+
+  // One second before should push us to -infinity.
+  t = shield_absl::FromCivil(shield_absl::CivilSecond(-292277022657, 1, 27, 8, 29, 51), utc);
+  EXPECT_EQ("infinite-past", shield_absl::FormatTime(shield_absl::RFC3339_full, t, utc));
+}
