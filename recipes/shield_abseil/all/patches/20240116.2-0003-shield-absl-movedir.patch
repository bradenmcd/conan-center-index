+TEST(KernelTimeout, OverflowNanos) {
+  // Test what happens when KernelTimeout is constructed with an shield_absl::Duration
+  // that would overflow now_nanos + duration.
+  int64_t now_nanos = shield_absl::ToUnixNanos(shield_absl::Now());
+  int64_t limit = std::numeric_limits<int64_t>::max() - now_nanos;
+  shield_absl::Duration duration = shield_absl::Nanoseconds(limit) + shield_absl::Seconds(1);
+  KernelTimeout t(duration);
+  // Timeouts should still be far in the future.
+  EXPECT_GT(shield_absl::TimeFromTimespec(t.MakeAbsTimespec()),
+            shield_absl::Now() + shield_absl::Hours(100000));
+#ifndef _WIN32
+  EXPECT_GT(shield_absl::TimeFromTimespec(t.MakeClockAbsoluteTimespec(CLOCK_REALTIME)),
+            shield_absl::Now() + shield_absl::Hours(100000));
+#endif
+  EXPECT_GT(shield_absl::DurationFromTimespec(t.MakeRelativeTimespec()),
+            shield_absl::Hours(100000));
+  EXPECT_GT(shield_absl::FromUnixNanos(t.MakeAbsNanos()),
+            shield_absl::Now() + shield_absl::Hours(100000));
+  EXPECT_LE(shield_absl::Milliseconds(t.InMillisecondsFromNow()) - duration,
+            shield_absl::Milliseconds(5));
+  EXPECT_GT(t.ToChronoTimePoint(),
+            std::chrono::system_clock::now() + std::chrono::hours(100000));
+  EXPECT_GT(t.ToChronoDuration(), std::chrono::hours(100000));
+}
+
+}  // namespace
