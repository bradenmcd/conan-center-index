+TEST(optionalTest, ConvertingConstructor) {
+  shield_absl::optional<Implicit> i_empty;
+  shield_absl::optional<Implicit> i(shield_absl::in_place);
+  shield_absl::optional<Explicit> e_empty;
+  shield_absl::optional<Explicit> e(shield_absl::in_place);
+  {
+    // implicitly constructing shield_absl::optional<Convert> from
+    // shield_absl::optional<Implicit>
+    shield_absl::optional<Convert> empty = i_empty;
+    EXPECT_FALSE(empty);
+    shield_absl::optional<Convert> opt_copy = i;
+    EXPECT_TRUE(opt_copy);
+    EXPECT_TRUE(opt_copy->implicit);
+    EXPECT_FALSE(opt_copy->move);
+    shield_absl::optional<Convert> opt_move = shield_absl::optional<Implicit>(shield_absl::in_place);
+    EXPECT_TRUE(opt_move);
+    EXPECT_TRUE(opt_move->implicit);
+    EXPECT_TRUE(opt_move->move);
+  }
+  {
+    // explicitly constructing shield_absl::optional<Convert> from
+    // shield_absl::optional<Explicit>
+    shield_absl::optional<Convert> empty(e_empty);
+    EXPECT_FALSE(empty);
+    shield_absl::optional<Convert> opt_copy(e);
+    EXPECT_TRUE(opt_copy);
+    EXPECT_FALSE(opt_copy->implicit);
+    EXPECT_FALSE(opt_copy->move);
+    EXPECT_FALSE((std::is_convertible<const shield_absl::optional<Explicit>&,
+                                      shield_absl::optional<Convert>>::value));
+    shield_absl::optional<Convert> opt_move{shield_absl::optional<Explicit>(shield_absl::in_place)};
+    EXPECT_TRUE(opt_move);
+    EXPECT_FALSE(opt_move->implicit);
+    EXPECT_TRUE(opt_move->move);
+    EXPECT_FALSE((std::is_convertible<shield_absl::optional<Explicit>&&,
+                                      shield_absl::optional<Convert>>::value));
+  }
+  {
+    // implicitly constructing shield_absl::optional<ConvertFromOptional> from
+    // shield_absl::optional<Implicit> via
+    // ConvertFromOptional(shield_absl::optional<Implicit>&&) check that
+    // ConvertFromOptional(Implicit&&) is NOT called
+    static_assert(
+        std::is_convertible<shield_absl::optional<Implicit>,
+                            shield_absl::optional<ConvertFromOptional>>::value,
+        "");
+    shield_absl::optional<ConvertFromOptional> opt0 = i_empty;
+    EXPECT_TRUE(opt0);
+    EXPECT_TRUE(opt0->implicit);
+    EXPECT_FALSE(opt0->move);
+    EXPECT_TRUE(opt0->from_optional);
+    shield_absl::optional<ConvertFromOptional> opt1 = shield_absl::optional<Implicit>();
+    EXPECT_TRUE(opt1);
+    EXPECT_TRUE(opt1->implicit);
+    EXPECT_TRUE(opt1->move);
+    EXPECT_TRUE(opt1->from_optional);
+  }
+  {
+    // implicitly constructing shield_absl::optional<ConvertFromOptional> from
+    // shield_absl::optional<Explicit> via
+    // ConvertFromOptional(shield_absl::optional<Explicit>&&) check that
+    // ConvertFromOptional(Explicit&&) is NOT called
+    shield_absl::optional<ConvertFromOptional> opt0(e_empty);
+    EXPECT_TRUE(opt0);
+    EXPECT_FALSE(opt0->implicit);
+    EXPECT_FALSE(opt0->move);
+    EXPECT_TRUE(opt0->from_optional);
+    EXPECT_FALSE(
+        (std::is_convertible<const shield_absl::optional<Explicit>&,
+                             shield_absl::optional<ConvertFromOptional>>::value));
+    shield_absl::optional<ConvertFromOptional> opt1{shield_absl::optional<Explicit>()};
+    EXPECT_TRUE(opt1);
+    EXPECT_FALSE(opt1->implicit);
+    EXPECT_TRUE(opt1->move);
+    EXPECT_TRUE(opt1->from_optional);
+    EXPECT_FALSE(
+        (std::is_convertible<shield_absl::optional<Explicit>&&,
+                             shield_absl::optional<ConvertFromOptional>>::value));
+  }
+}
